# ============================================================
# TancElf — Tan ile yazılmış, doğrudan ELF üreten derleyici
# Hedef: Go'suz self-hosting. Go karşılığı: DerleElf.go + Lexer.go +
# Parser.go + Optimize.go. C yok, as/ld yok, libc yok.
#
# Durum: BÖLÜM 1 (Lexer), BÖLÜM 2 (RPN ifade ayrıştırıcı),
#        BÖLÜM 3 (değişken tablosu + deyim derleyici),
#        BÖLÜM 4 (makine kodu + ELF yazıcı) çalışıyor.
#
# Destek: tam sayı ifadeleri (+ - * / % ve tüm karşılaştırmalar),
#         değişken atama, yaz, eğer/değilse/son, iken/son,
#         işlev tanımı + çağrı (System V AMD64, en fazla 6 parametre,
#         özyineleme dahil) + döndür, liste ([1,2,3], indeksleme, indeks
#         ataması, uzunluk, ekle, iç içe liste), her...içinde + dur/devam,
#         metin (literal, "+" birleştirme + sayı otomatik çevrimi,
#         indeksleme s[i], uzunluk, kod, karakter, metin(sayı), == / !=
#         içerik karşılaştırması — bkz. "METİN ÇALIŞMA ZAMANI" başlığı).
# Eksik : dosya G/Ç.
# Bilinen sınırlar: (1) metin "+"/karşılaştırma dispatch'i DEĞİŞKEN BAŞINA
#   basit bir tip izlemeyle kararlaştırılıyor — işlev DÖNÜŞ tipi
#   izlenmiyor, bir işlevden metin döndürüp değişkene atayıp "+" ile
#   kullanmak yanlış kod üretir (bkz. islevDerle/cagriSonucTipi notları).
#   (2) çok baytlı UTF-8 metin literalleri (ç ğ ı ö ş ü İ) DerleElf.go'nun
#   zaten belgeli kod()/karakter() rune-vs-bayt sınırını miras alıyor —
#   interpreter/native TancElf farklı bayt üretebilir. Örnekler ASCII.
#
# Kullanım:  TancElf <girdi.tan> <çıktı-binary>
#
# FARK TESTİ: ./FarkTesti.sh ornekler/*.tan
#   Yorumlayıcıda koşan TancElf ile elf'e derlenmiş TancElf AYNI baytı
#   üretmeli. Sapma = arka uçlar arası anlam kayması, erken yakala.

# ---------------- BÖLÜM 1: SÖZCÜK ÇÖZÜMLEYİCİ (LEXER) ----------------
# ÖNEMLİ BULGU #2: elf arka ucunda kod()/karakter()/metin indeksleme RUNE
# değil BAYT bazlı çalışıyor (DOKUMANTASYON.md "rune" der ama yardimciKod
# tek bayt okuyor — bkz. DerleElf.go yardimciKod: movzxBaytDolayli).
# Türkçe harfler (ç ğ ı ö ş ü İ) UTF-8'de 2 baytlık dizi (öncü bayt 0xC3-
# 0xC5 + devam baytı 0x80-0xBF). Bu yüzden harfMi() öncü VE devam baytlarını
# da "harf" sayar — böylece tarayıcı iki baytı da tanımlayıcıya dahil eder.
# harfMi: ASCII harf, alt cizgi, VEYA 128 ustu her deger.
# 128 ustune ust sinir KOYMA — iki arka uc farkli deger uretiyor:
#   elf yolu     : metin bayt dizisidir, "ğ" -> 196 ve 159 (iki ayri bayt)
#   yorumlayici  : metin rune dizisidir,  "ğ" -> 287 (tek deger)
# Ikisini de harf saymak, "eğer" gibi anahtarlarin HER IKI ARKA UCTA da
# tek parca kalmasini saglar.
işlev harfMi(k)
    döndür (k >= 97 ve k <= 122) veya (k >= 65 ve k <= 90) veya k == 95 veya k >= 128
son

işlev rakamMi(k)
    döndür k >= 48 ve k <= 57
son

işlev bosMu(k)
    döndür k == 32 veya k == 9 veya k == 13
son

işlev anahtarMi(kelime, anahtarlar)
    # metinEsit() kullanılıyor, "==" DEĞİL — bkz. metinEsit CAGRI notu:
    # her-döngü değişkeni (a) VE parametre (kelime) İKİSİ DE varsayılan "tam"
    # tipinde kaldığından "==" düz tam sayı (işaretçi) karşılaştırması yapıp
    # HER ZAMAN 0 döndürüyordu — tüm anahtar kelimeler AD sayılıyordu.
    her a anahtarlar içinde
        eğer metinEsit(a, kelime) ise
            döndür 1
        son
    son
    döndür 0
son

işlev kacisCoz(k)
    eğer k == "n" ise
        döndür karakter(10)
    son
    eğer k == "t" ise
        döndür karakter(9)
    son
    eğer k == "r" ise
        döndür karakter(13)
    son
    döndür k
son

işlev tokenKodla(tur, deger, satir, soh)
    # metinBirlestir kullanılıyor, "+" DEĞİL — tur/deger/soh HEPSİ parametre
    # olduğundan tipleri hep "tam" sanılıyordu, "+" zinciri tam sayı toplaması
    # yapıp token kaydını bozuyordu (bkz. metinBirlestir CAGRI notu).
    p1 = metinBirlestir(tur, soh)
    p2 = metinBirlestir(p1, deger)
    p3 = metinBirlestir(p2, soh)
    döndür metinBirlestir(p3, metin(satir))
son

# tokenle: kaynağı TEK düz metin listesine çözer.
# Her öge "TUR<SOH>DEGER<SOH>SATIR" biçiminde kodludur.
işlev tokenle(kaynak)
    soh = karakter(1)
    anahtarlar = ["yaz", "eğer", "ise", "değilse", "iken", "işlev", "döndür", "son", "her", "içinde", "dur", "devam", "içe", "al", "doğru", "yanlış", "yok", "ve", "veya", "değil", "köprü", "dene", "yakala"]
    # TAMPON KULLANIYOR (bkz. "TAMPON" başlığı) — TancElf.tan'ın kendi
    # kaynağı (~2400 satır) onbinlerce token üretiyor; "tokenler = ekle
    # (tokenler, ...)" HER TOKEN için MEVCUT boyut kadar kopyalıyordu.
    # bagla/blokDerle/ifadeBantYaz düzeltmelerinden SONRA bile sabit nokta
    # denemesi hâlâ çöküyordu — bu, gözden kaçan İKİNCİ büyük O(n²) kaynağı.
    # metinAl(kaynak,i) kullanılıyor, "kaynak[i]" DEĞİL — kaynak PARAMETRE
    # olduğundan tipi hep "tam" sanılıyordu (bkz. metinAl CAGRI notu); bu
    # yüzden "kaynak[i]" karakter baytı DEĞİL 8-bayt-adımlı liste ögesi gibi
    # okunuyor, tüm lexer çıktısı bozuluyordu — sabit nokta denemesinde
    # gen2'nin kendi sözcük çözümleyicisinin baştan bozuk üretilmesinin kök
    # nedenlerinden biri.
    tokenKutu = tamponOlustur()
    tNKutu = [0]
    n = uzunluk(kaynak)
    i = 0
    satir = 1
    iken i < n
        h = metinAl(kaynak, i)
        k = kod(h)

        eğer bosMu(k) ise
            i = i + 1

        değilse eğer h == "#" ise
            iken i < n ve metinAl(kaynak, i) != "\n"
                i = i + 1
            son

        değilse eğer k == 10 ise
            z = tamponEkle(tokenKutu, tNKutu, tokenKodla("SATIRSONU", "\n", satir, soh))
            satir = satir + 1
            i = i + 1

        değilse eğer h == "\"" ise
            i = i + 1
            s = ""
            iken i < n ve metinAl(kaynak, i) != "\""
                c = metinAl(kaynak, i)
                eğer c == "\\" ve i + 1 < n ise
                    i = i + 1
                    s = metinBirlestir(s, kacisCoz(metinAl(kaynak, i)))
                    i = i + 1
                değilse
                    s = metinBirlestir(s, c)
                    i = i + 1
                son
            son
            i = i + 1
            z = tamponEkle(tokenKutu, tNKutu, tokenKodla("METIN", s, satir, soh))

        değilse eğer rakamMi(k) ise
            bas = i
            iken i < n ve (rakamMi(kod(metinAl(kaynak, i))) veya metinAl(kaynak, i) == ".")
                i = i + 1
            son
            s = ""
            j = bas
            iken j < i
                s = metinBirlestir(s, metinAl(kaynak, j))
                j = j + 1
            son
            z = tamponEkle(tokenKutu, tNKutu, tokenKodla("SAYI", s, satir, soh))

        değilse eğer harfMi(k) ise
            bas = i
            iken i < n ve (harfMi(kod(metinAl(kaynak, i))) veya rakamMi(kod(metinAl(kaynak, i))))
                i = i + 1
            son
            s = ""
            j = bas
            iken j < i
                s = metinBirlestir(s, metinAl(kaynak, j))
                j = j + 1
            son
            eğer anahtarMi(s, anahtarlar) ise
                z = tamponEkle(tokenKutu, tNKutu, tokenKodla("ANAHTAR", s, satir, soh))
            değilse
                z = tamponEkle(tokenKutu, tNKutu, tokenKodla("AD", s, satir, soh))
            son

        değilse eğer h == "(" ise
            z = tamponEkle(tokenKutu, tNKutu, tokenKodla("PARAC", "(", satir, soh))
            i = i + 1

        değilse eğer h == ")" ise
            z = tamponEkle(tokenKutu, tNKutu, tokenKodla("PARKAPA", ")", satir, soh))
            i = i + 1

        değilse eğer h == "[" ise
            z = tamponEkle(tokenKutu, tNKutu, tokenKodla("KOSAC", "[", satir, soh))
            i = i + 1

        değilse eğer h == "]" ise
            z = tamponEkle(tokenKutu, tNKutu, tokenKodla("KOSKAPA", "]", satir, soh))
            i = i + 1

        değilse eğer h == "{" ise
            z = tamponEkle(tokenKutu, tNKutu, tokenKodla("SUSAC", "{", satir, soh))
            i = i + 1

        değilse eğer h == "}" ise
            z = tamponEkle(tokenKutu, tNKutu, tokenKodla("SUSKAPA", "}", satir, soh))
            i = i + 1

        değilse eğer h == ":" ise
            z = tamponEkle(tokenKutu, tNKutu, tokenKodla("IKINOKTA", ":", satir, soh))
            i = i + 1

        değilse eğer h == "," ise
            z = tamponEkle(tokenKutu, tNKutu, tokenKodla("VIRGUL", ",", satir, soh))
            i = i + 1

        değilse eğer (h == ">" veya h == "<" veya h == "=" veya h == "!") ve i + 1 < n ve metinAl(kaynak, i + 1) == "=" ise
            z = tamponEkle(tokenKutu, tNKutu, tokenKodla("ISLEC", metinBirlestir(h, "="), satir, soh))
            i = i + 2

        değilse eğer h == "+" veya h == "-" veya h == "*" veya h == "/" veya h == "%" veya h == ">" veya h == "<" veya h == "=" ise
            z = tamponEkle(tokenKutu, tNKutu, tokenKodla("ISLEC", h, satir, soh))
            i = i + 1

        değilse
            # tanınmayan karakter — atla (referans Lexer.go ile aynı davranış)
            i = i + 1
        son
    son
    z = tamponEkle(tokenKutu, tNKutu, tokenKodla("DOSYASONU", "", satir, soh))
    döndür tamponSonuc(tokenKutu, tNKutu)
son

# ---------------- BÖLÜM 2: AYRIŞTIRICI (RPN BANT ÜRETİCİ) ----------------
# Tasarım: gerçek bir AST (iç içe ağaç) DEĞİL — her ifadeyi son-ek (postfix)
# sırayla değerlendirilecek DÜZ bir "bant" (bytecode listesi) üretiyoruz.
# Neden: elf'in iç içe liste desteği sınırlı (Bölüm 1 başlığına bkz).
# tanc2.tan'ın kendi shunting-yard'ının (rpnYap/rpnAsm) doğal genişletilmiş
# hali — Bölüm 4 (kod üretimi) bu bandı soldan sağa yürüyüp doğrudan
# makine kodu üretecek (yığın makinesi gibi).
#
# Bytecode kodlaması: token kodlamasıyla AYNI SOH ayraçlı düzen, HER ZAMAN
# üç alan: "OP<SOH>ARG1<SOH>ARG2" (kullanılmayan alan boş metin). Bu sayede
# alan() ayıklayıcısı hem token hem bytecode için ORTAK kullanılabiliyor.
#
# Konum imleci ("poz") özyineli ayrıştırma fonksiyonları arasında paylaşılmalı
# ama Tan'da referans/gösterici yok. Çözüm: poz TEK ELEMANLI bir liste
# ("kutu") olarak taşınır — liste[i]=x YERİNDE değiştirir (doğrulandı
# ve elf arka ucuna İLK KEZ eklendi — bkz. DerleElf.go IndeksAtamaDugum:
# "elf: bu deyim desteklenmiyor" hatası veriyordu),
# böylece kutu[0]=... çağıran tarafın da gördüğü şekilde konumu ilerletir.
# ekle() ise HER ZAMAN YENİ liste döndürür (yerinde DEĞİL, bkz.
# DOKUMANTASYON.md) — bu yüzden RPN bantları kutu yöntemiyle DEĞİL, her
# ayrıştırma fonksiyonunun KENDİ bandını inşa edip DÖNDÜRMESİYLE, çağıranın
# da listeBirlestir ile parça bantları birleştirmesiyle akıyor.

işlev listeBirlestir(a, b)
    sonuc = a
    her x b içinde
        sonuc = ekle(sonuc, x)
    son
    döndür sonuc
son

# ---------------- TAMPON (büyüyen, amortize O(1) ekleme) ----------------
# BULUNAN SORUN (sabit nokta denemesinde): "kod = listeBirlestir
# (kod, X)" deseni TancElf.tan'ın KENDİ kod üretiminde HER YERDE kullanılıyor
# — "kod" büyüdükçe her ekleme MEVCUT boyut kadar kopyalıyor (ekle() yeni
# liste döndürüyor, DOKUMANTASYON.md gereği). n statement/RPN girişi için
# toplam maliyet O(n²). TancElf.tan'ın kendisi ~72 KB kod ürettiği için
# kendi kendini derlerken bu WSL'in bellek sınırını katlanarak aşıp VM'i
# çökertiyordu. Çözüm listeYap(n,değer) (TEK SEFERDE ayırma, O(n)) üzerine
# kurulu BÜYÜYEN TAMPON — liste bellek DÜZENİNE dokunmuyor, sadece dış
# kutularda (tamponKutu, nKutu) AYRI kapasite/uzunluk izliyor. "kod" artık
# düz liste değişkeni değil, bu iki kutuyla temsil ediliyor; fonksiyon
# bitince tamponSonuc ile TEK SEFERDE (O(nihai boy)) düz listeye kırpılıyor.
#
# NOT (tip çıkarımı sınırı): karışık tipli liste ([liste, sayı]) elf'te
# çalışmıyor — öge tipi yalnız 0. öğeden çıkarılıyor. Bu yüzden TEK bir
# karışık kutu yerine İKİ AYRI kutu (tamponKutu: liste, nKutu: sayı)
# kullanılıyor — Go'nun sağladığı Tampon.tan örneğiyle birebir aynı desen.
işlev tamponOlustur()
    döndür [listeYap(64, 0)]
son

işlev tamponEkle(tamponKutu, nKutu, deger)
    liste = tamponKutu[0]
    n = nKutu[0]
    kap = uzunluk(liste)
    eğer n >= kap ise
        yeniKap = kap * 2
        eğer yeniKap < 64 ise
            yeniKap = 64
        son
        yeni = listeYap(yeniKap, 0)
        i = 0
        iken i < n
            yeni[i] = liste[i]
            i = i + 1
        son
        tamponKutu[0] = yeni
        liste = yeni
    son
    liste[n] = deger
    nKutu[0] = n + 1
    döndür 0
son

# tamponEkleTumu: bir bandın (liste) TÜM ögelerini tampona ekler —
# "kod = listeBirlestir(kod, X)" yerine kullanılır.
işlev tamponEkleTumu(tamponKutu, nKutu, digerListe)
    her x digerListe içinde
        z = tamponEkle(tamponKutu, nKutu, x)
    son
    döndür 0
son

# tamponSonuc: tamponu TAM boyuta (n) kırpılmış düz liste olarak döndürür —
# TEK SEFERLİK O(n) maliyet, fonksiyon dönerken bir kez çağrılır.
işlev tamponSonuc(tamponKutu, nKutu)
    liste = tamponKutu[0]
    n = nKutu[0]
    sonuc = listeYap(n, 0)
    i = 0
    iken i < n
        sonuc[i] = liste[i]
        i = i + 1
    son
    döndür sonuc
son

# alan(s, alanNo): SOH ayraçlı 3-alanlı bir kaydın alanNo'ıncı (0/1/2) alanı
işlev alan(s, alanNo)
    # metinAl/metinEsit/metinBirlestir kullanılıyor, "s[i]"/"=="/"+ DEĞİL —
    # s bir PARAMETRE olduğundan tipi hep "tam" sanılıyordu (TancElf.tan'ın
    # kendi parametre tipi çıkarımı yok — bkz. islevDerle notu); "s[i]" bu
    # yüzden metin baytı DEĞİL 8-bayt-adımlı liste ögesi gibi okunuyordu.
    # alan() TÜM token/RPN alan ayıklamasının merkezinde olduğundan bu,
    # sabit nokta denemesinde gen2'nin baştan sona bozuk üretilmesinin kök
    # nedeniydi (bkz. metinAl CAGRI notu).
    soh = karakter(1)
    n = uzunluk(s)
    mevcutAlan = 0
    sonuc = ""
    i = 0
    iken i < n
        eğer metinEsit(metinAl(s, i), soh) ise
            mevcutAlan = mevcutAlan + 1
        değilse eğer mevcutAlan == alanNo ise
            sonuc = metinBirlestir(sonuc, metinAl(s, i))
        son
        i = i + 1
    son
    döndür sonuc
son

işlev karakterVarMi(s, aranan)
    # metinAl/metinEsit — s parametre olduğundan tipi hep "tam" sanılıyordu.
    n = uzunluk(s)
    i = 0
    iken i < n
        eğer metinEsit(metinAl(s, i), aranan) ise
            döndür 1
        son
        i = i + 1
    son
    döndür 0
son

işlev bc(op, a1, a2)
    # ÖNCEDEN "op + soh + a1 + soh + a2" (düz "+") kullanıyordu. op/a1/a2
    # PARAMETRE olduğundan TancElf.tan'ın kendi tip çıkarımı onları hep
    # "tam" sanıyor (parametre tipi çıkarımı YOK — bkz. islevDerle notu).
    # "+" solTip/sagTip'e bakıp metin/sayı kararı verdiğinden, "tam"
    # sanılan bir metin parametresi SAYI gibi (f_sayi_metne ile pointer
    # değerinin kendisi metne çevrilerek) birleştiriliyordu — bc() TÜM
    # bant kodlamasının (bcBayt/bcEtiket/bcRel32) temeli olduğundan bu,
    # gen1-native'in ürettiği HER ŞEYİN çöp bant üretmesinin kök nedeniydi
    # (metinEsit/metinAl/metinBirlestir ailesindeki DÖRDÜNCÜ örnek).
    # metinBirlestir() statik tipten BAĞIMSIZ olduğundan güvenli.
    soh = karakter(1)
    sonuc = metinBirlestir(op, soh)
    sonuc = metinBirlestir(sonuc, a1)
    sonuc = metinBirlestir(sonuc, soh)
    döndür metinBirlestir(sonuc, a2)
son

# --- konum imleci yardımcıları: pozKutu HER ZAMAN tek elemanlı liste ---
işlev pTur(tokenler, pozKutu)
    döndür alan(tokenler[pozKutu[0]], 0)
son

işlev pDeger(tokenler, pozKutu)
    döndür alan(tokenler[pozKutu[0]], 1)
son

işlev pIlerle(tokenler, pozKutu)
    eğer pozKutu[0] < uzunluk(tokenler) - 1 ise
        pozKutu[0] = pozKutu[0] + 1
    son
    döndür 0
son

işlev pSatirlariAtla(tokenler, pozKutu)
    iken pTur(tokenler, pozKutu) == "SATIRSONU"
        x = pIlerle(tokenler, pozKutu)
    son
    döndür 0
son

# ifadeAyristir == en düşük öncelik (mantıksal ve/veya) — DOKUMANTASYON.md
# öncelik tablosuyla birebir: 1 ve/veya, 2 karşılaştırma, 3 +/-, 4 */%%,
# ardından son-ek [indeks], en içte temel (sabit/ad/çağrı/parantez/tekli-).
işlev ifadeAyristir(tokenler, pozKutu, sayacKutu)
    döndür mantiksalAyristir(tokenler, pozKutu, sayacKutu)
son

işlev mantiksalAyristir(tokenler, pozKutu, sayacKutu)
    bant = karsilastirmaAyristir(tokenler, pozKutu, sayacKutu)
    iken pTur(tokenler, pozKutu) == "ANAHTAR" ve (pDeger(tokenler, pozKutu) == "ve" veya pDeger(tokenler, pozKutu) == "veya")
        islec = pDeger(tokenler, pozKutu)
        x = pIlerle(tokenler, pozKutu)
        x = pSatirlariAtla(tokenler, pozKutu)
        sag = karsilastirmaAyristir(tokenler, pozKutu, sayacKutu)
        bant = listeBirlestir(bant, kisaDevreBirlestir(islec, sag, sayacKutu))
    son
    döndür bant
son

# kisaDevreBirlestir: "ve"/"veya" İÇİN KISA DEVRE üretir — sağ operandın
# RPN'i (sag) SOLUN sonucuna göre HİÇ ÇALIŞTIRILMAYABİLİR (üretilen makine
# kodunda jcc ile atlanır). Bulundu: RPN düz (postfix) bant
# olduğu için "IKILI ve/veya" öncekiyle AYNI şekilde ele alınıyordu — yani
# iki operand da HER ZAMAN çalıştırılıyordu, kısa devre YOKTU. TancElf'in
# KENDİ kaynağı (harfMi, rakamMi, ...) 35 yerde ve/veya kullanıyor; kısa
# devre olmadan örn. "k >= 128 ve dizininDisi(k)" gibi bir desen sınır
# kontrolünden SONRA erişim yapması gereken durumlarda çökebilir (ki bu
# TAM OLARAK ELF çıktısının kendi kaynağını derlerken düşeceği durum).
# Çözüm: RPN "op,arg1,arg2" üçlüsü ile AYNI kodlanan HAM bant girişlerini
# (BAYT/REL32/ETIKET — jccBant/jmpBant/bcEtiket zaten bu türden üretiyor)
# doğrudan RPN'e gömüyoruz; ifadeBantYaz bunları OLDUĞU GİBİ geçiriyor
# (aşağıda yeni pass-through dalları). Bölüm 2'nin Bölüm 4 fonksiyonlarını
# (popKayit, jccBant, ...) çağırması bu dosyada zaten YERLEŞİK bir desen —
# ileri-referans (forward reference) her yerde çalışıyor.
#
# ve: sol yanlışsa (0) SAĞ HİÇ ÇALIŞMAZ, sonuç 0. sol doğruysa sağ çalışır,
#     sonucu (0/1'e normalize edilmiş) kullanılır.
# veya: sol doğruysa (≠0) SAĞ HİÇ ÇALIŞMAZ, sonuç 1. sol yanlışsa sağ çalışır.
işlev kisaDevreBirlestir(islec, sagBant, sayacKutu)
    etAtla = yeniEtiket(sayacKutu, "Lkd")
    etSon = yeniEtiket(sayacKutu, "Lkdson")
    kanonikDeger = 0
    jccKodu = 132   # jz (0x84) — "ve": sol yanlışsa atla
    eğer islec == "veya" ise
        kanonikDeger = 1
        jccKodu = 133   # jnz (0x85) — "veya": sol doğruysa atla
    son

    # KISADEVREBASLA/ORTA/BITTI: ifadeBantYaz'ın tip yığını (tipYigin) için
    # AÇIK işaretleyiciler. Ham BAYT/REL32/ETIKET pass-through'u tipYigin'e
    # dokunmuyor (aşağı bkz.) ama popKayit(sol) ve popKayit(sağ) ÇALIŞMA
    # ZAMANI yığınından birer değer TÜKETİYOR — tipYigin bunu bilmezse
    # (sol/sağın STALE tipleri yığında kalır) sonraki bir ifadenin tip
    # yığını sayımı KAYAR. BASLA sol'un tipini atar, ORTA sağ'ınkini atar,
    # BITTI nihai "tam" (ve/veya HER ZAMAN boolean döner) tipini ekler —
    # net sayı DEĞİŞMEZ (N gir, N çık), sadece en üstteki tip düzeltilir.
    bant = [bc("KISADEVREBASLA", "", "")]
    bant = listeBirlestir(bant, popKayit(0))                # rax = sol
    bant = listeBirlestir(bant, testKayit(0, 0))
    bant = listeBirlestir(bant, jccBant(jccKodu, etAtla))
    bant = listeBirlestir(bant, sagBant)                    # sağ SADECE burada çalışır
    bant = ekle(bant, bc("KISADEVREORTA", "", ""))
    bant = listeBirlestir(bant, popKayit(0))                # rax = sağ
    bant = listeBirlestir(bant, testKayit(0, 0))
    bant = listeBirlestir(bant, setccBant(149))  # setne — sağ doğruysa 1
    bant = listeBirlestir(bant, movzxAlBant())
    bant = listeBirlestir(bant, pushKayit(0))
    bant = listeBirlestir(bant, jmpBant(etSon))
    bant = ekle(bant, bcEtiket(etAtla))
    bant = listeBirlestir(bant, movImm32(0, kanonikDeger))
    bant = listeBirlestir(bant, pushKayit(0))
    bant = ekle(bant, bcEtiket(etSon))
    bant = ekle(bant, bc("KISADEVREBITTI", "", ""))
    döndür bant
son

işlev karsilastirmaAyristir(tokenler, pozKutu, sayacKutu)
    bant = toplamaAyristir(tokenler, pozKutu, sayacKutu)
    iken pTur(tokenler, pozKutu) == "ISLEC" ve (pDeger(tokenler, pozKutu) == ">" veya pDeger(tokenler, pozKutu) == "<" veya pDeger(tokenler, pozKutu) == ">=" veya pDeger(tokenler, pozKutu) == "<=" veya pDeger(tokenler, pozKutu) == "==" veya pDeger(tokenler, pozKutu) == "!=")
        islec = pDeger(tokenler, pozKutu)
        x = pIlerle(tokenler, pozKutu)
        x = pSatirlariAtla(tokenler, pozKutu)
        sag = toplamaAyristir(tokenler, pozKutu, sayacKutu)
        bant = listeBirlestir(bant, sag)
        bant = ekle(bant, bc("IKILI", islec, ""))
    son
    döndür bant
son

işlev toplamaAyristir(tokenler, pozKutu, sayacKutu)
    bant = carpmaAyristir(tokenler, pozKutu, sayacKutu)
    iken pTur(tokenler, pozKutu) == "ISLEC" ve (pDeger(tokenler, pozKutu) == "+" veya pDeger(tokenler, pozKutu) == "-")
        islec = pDeger(tokenler, pozKutu)
        x = pIlerle(tokenler, pozKutu)
        x = pSatirlariAtla(tokenler, pozKutu)
        sag = carpmaAyristir(tokenler, pozKutu, sayacKutu)
        bant = listeBirlestir(bant, sag)
        bant = ekle(bant, bc("IKILI", islec, ""))
    son
    döndür bant
son

işlev carpmaAyristir(tokenler, pozKutu, sayacKutu)
    bant = sonEkAyristir(tokenler, pozKutu, sayacKutu)
    iken pTur(tokenler, pozKutu) == "ISLEC" ve (pDeger(tokenler, pozKutu) == "*" veya pDeger(tokenler, pozKutu) == "/" veya pDeger(tokenler, pozKutu) == "%")
        islec = pDeger(tokenler, pozKutu)
        x = pIlerle(tokenler, pozKutu)
        x = pSatirlariAtla(tokenler, pozKutu)
        sag = sonEkAyristir(tokenler, pozKutu, sayacKutu)
        bant = listeBirlestir(bant, sag)
        bant = ekle(bant, bc("IKILI", islec, ""))
    son
    döndür bant
son

# sonEkAyristir: temel değeri alır, ardından zincirleme [indeks] uygular
# (liste[0], m[i][j]). Referans Parser.go'daki birincil()/sonEk() ikilisinin
# birleştirilmiş hali (orada ikisi de aynı döngüyü tekrar ediyordu).
işlev sonEkAyristir(tokenler, pozKutu, sayacKutu)
    bant = temelAyristir(tokenler, pozKutu, sayacKutu)
    iken pTur(tokenler, pozKutu) == "KOSAC"
        x = pIlerle(tokenler, pozKutu)
        indeksBant = ifadeAyristir(tokenler, pozKutu, sayacKutu)
        x = pIlerle(tokenler, pozKutu)
        bant = listeBirlestir(bant, indeksBant)
        bant = ekle(bant, bc("INDEKS", "", ""))
    son
    döndür bant
son

# temelAyristir: sabitler, ad/çağrı, parantez, liste sabiti, tekli - / değil.
# NOT (referans davranışla birebir uyum): tekli "-" yalnız temel'i alır
# (son-ek indekslemeyi İÇERMEZ — "-x[0]" == "(-x)[0]"), ama "değil" son-ek
# dahil sonEkAyristir'i alır ("değil x[0]" == "değil (x[0])"). Bu asimetri
# Parser.go'da da böyle (temel() kendini çağırır, "değil" birincil() çağırır).
işlev temelAyristir(tokenler, pozKutu, sayacKutu)
    tur = pTur(tokenler, pozKutu)
    deger = pDeger(tokenler, pozKutu)

    eğer tur == "ISLEC" ve deger == "-" ise
        x = pIlerle(tokenler, pozKutu)
        ic = temelAyristir(tokenler, pozKutu, sayacKutu)
        döndür ekle(ic, bc("NEGATIF", "", ""))
    son

    eğer tur == "SAYI" ise
        x = pIlerle(tokenler, pozKutu)
        eğer karakterVarMi(deger, ".") ise
            döndür [bc("SAYIKESIR", deger, "")]
        son
        döndür [bc("SAYITAM", deger, "")]
    son

    eğer tur == "METIN" ise
        x = pIlerle(tokenler, pozKutu)
        döndür [bc("METIN", deger, "")]
    son

    eğer tur == "ANAHTAR" ve deger == "doğru" ise
        x = pIlerle(tokenler, pozKutu)
        döndür [bc("DOGRU", "", "")]
    son
    eğer tur == "ANAHTAR" ve deger == "yanlış" ise
        x = pIlerle(tokenler, pozKutu)
        döndür [bc("YANLIS", "", "")]
    son
    eğer tur == "ANAHTAR" ve deger == "yok" ise
        x = pIlerle(tokenler, pozKutu)
        döndür [bc("YOK", "", "")]
    son
    eğer tur == "ANAHTAR" ve deger == "değil" ise
        x = pIlerle(tokenler, pozKutu)
        ic = sonEkAyristir(tokenler, pozKutu, sayacKutu)
        döndür ekle(ic, bc("DEGIL", "", ""))
    son

    eğer tur == "PARAC" ise
        x = pIlerle(tokenler, pozKutu)
        ic = ifadeAyristir(tokenler, pozKutu, sayacKutu)
        x = pIlerle(tokenler, pozKutu)
        döndür ic
    son

    eğer tur == "KOSAC" ise
        x = pIlerle(tokenler, pozKutu)
        bant = []
        sayac = 0
        iken pTur(tokenler, pozKutu) != "KOSKAPA" ve pTur(tokenler, pozKutu) != "DOSYASONU"
            x = pSatirlariAtla(tokenler, pozKutu)
            eğer pTur(tokenler, pozKutu) == "KOSKAPA" ise
                dur
            son
            oge = ifadeAyristir(tokenler, pozKutu, sayacKutu)
            bant = listeBirlestir(bant, oge)
            sayac = sayac + 1
            x = pSatirlariAtla(tokenler, pozKutu)
            eğer pTur(tokenler, pozKutu) == "VIRGUL" ise
                x = pIlerle(tokenler, pozKutu)
            son
            x = pSatirlariAtla(tokenler, pozKutu)
        son
        x = pIlerle(tokenler, pozKutu)
        döndür ekle(bant, bc("LISTE", metin(sayac), ""))
    son

    eğer tur == "AD" ise
        ad = deger
        x = pIlerle(tokenler, pozKutu)
        eğer pTur(tokenler, pozKutu) == "PARAC" ise
            x = pIlerle(tokenler, pozKutu)
            bant = []
            sayac = 0
            iken pTur(tokenler, pozKutu) != "PARKAPA" ve pTur(tokenler, pozKutu) != "DOSYASONU"
                arg = ifadeAyristir(tokenler, pozKutu, sayacKutu)
                bant = listeBirlestir(bant, arg)
                sayac = sayac + 1
                eğer pTur(tokenler, pozKutu) == "VIRGUL" ise
                    x = pIlerle(tokenler, pozKutu)
                son
            son
            x = pIlerle(tokenler, pozKutu)
            döndür ekle(bant, bc("CAGRI", ad, metin(sayac)))
        son
        döndür [bc("AD", ad, "")]
    son

    # tanınmayan/beklenmeyen token — ilerle, boş bant döndür (referans YokDugum'a düşer)
    x = pIlerle(tokenler, pozKutu)
    döndür [bc("YOK", "", "")]
son



# ---------------- BÖLÜM 3: DEĞİŞKEN TABLOSU ----------------
# Tan'da gösterici yok. Tabloyu "kutu" ile taşıyoruz: adlarKutu İKİ elemanlı
# bir listedir — [0]=adlar, [1]=tipler (paralel listeler, aynı indeks aynı
# değişkene karşılık gelir). İndeks ataması çağırana yansıdığı için kutu
# güncellemesi dışarıdan görülür.
# Değişkenler ana çerçevede rbp-göreli yuvalarda:  yuva i -> disp = -(8*(i+1))
#
# TİP İZLEME (metin desteği için): TancElf.tan'ın statik tip çıkarımı YOK —
# DerleElf.go'daki gibi tam bir AST/tipCikar sistemi kurmak yerine SADECE
# "metin mi değil mi" ayrımını, "+"/"=="/"!="/indeksleme kod üretiminde doğru
# dalı seçmek için, DEĞİŞKEN BAŞINA izliyoruz. Varsayılan "tam". İşlev DÖNÜŞ
# TİPİ izlenmiyor (kapsam dışı) — bir işlevden metin döndürüp sonucu
# değişkene atayıp "+" ile kullanmak İSTENMEYEN sonuç verir (tam sanılır).
# Metin1/Metin2 örnekleri bu sınırın İÇİNDE kalacak şekilde yazıldı.

işlev adAra(adlarKutu, ad)
    # ÖNCEDEN "adlar[i] == ad" (düz "==") — ad PARAMETRE olduğundan tipi
    # "tam" sanılıyordu, karşılaştırma HİÇBİR ZAMAN eşleşmiyordu — adEkle
    # bu yüzden HER değişken REFERANSI için YENİ bir yuva açıyordu (aynı
    # ada tekrar tekrar rastlansa bile), değişken sayısını devasa şişirip
    # (TancElf.tan kendini derlerken 16 yerine 119) atama ile okumanın
    # FARKLI yuvalara düşmesine, dolayısıyla okunan değerin ÇÖP olmasına
    # yol açıyordu — en temel ve en yaygın etkili örnek (metinEsit
    # ailesindeki YEDİNCİ).
    adlar = adlarKutu[0]
    i = 0
    iken i < uzunluk(adlar)
        eğer metinEsit(adlar[i], ad) ise
            döndür i
        son
        i = i + 1
    son
    döndür 0 - 1
son

işlev adEkle(adlarKutu, ad)
    bulunan = adAra(adlarKutu, ad)
    eğer bulunan >= 0 ise
        döndür bulunan
    son
    adlarKutu[0] = ekle(adlarKutu[0], ad)
    adlarKutu[1] = ekle(adlarKutu[1], "tam")
    döndür uzunluk(adlarKutu[0]) - 1
son

işlev adTipiAl(adlarKutu, ad)
    yuva = adAra(adlarKutu, ad)
    eğer yuva < 0 ise
        döndür "tam"
    son
    döndür adlarKutu[1][yuva]
son

işlev adTipiAyarla(adlarKutu, ad, tip)
    yuva = adEkle(adlarKutu, ad)
    tipler = adlarKutu[1]
    tipler[yuva] = tip
    döndür 0
son

işlev yuvaDisp(indeks)
    döndür 0 - (8 * (indeks + 1))
son

# ilkNHaric: listenin SON n elemanı çıkarılmış hali (tip yığını "pop N" için
# — Tan'da dilim/slice yerleşiği yok, elle kopyalanıyor; yığın derinliği
# ifade iç içeliği kadar küçük olduğundan O(derinlik) maliyet önemsiz).
işlev ilkNHaric(l, n)
    sonuc = []
    sinir = uzunluk(l) - n
    i = 0
    iken i < sinir
        sonuc = ekle(sonuc, l[i])
        i = i + 1
    son
    döndür sonuc
son

# benzersiz etiket üreteci — sayacKutu tek elemanlı liste
işlev yeniEtiket(sayacKutu, onEk)
    # ÖNCEDEN "onEk + metin(...)" — onEk PARAMETRE olduğundan tipi "tam"
    # sanılıyordu, "+" onEk'i SAYI gibi f_sayi_metne'den geçirip etiket
    # adını (Legerson/Ldegilse/Lbas/... öneki) ÇÖPE çeviriyordu — TÜM
    # kontrol akışı (eğer/iken/her/işlev) etiketleri bu yüzden bozuktu.
    sayacKutu[0] = sayacKutu[0] + 1
    döndür metinBirlestir(onEk, metin(sayacKutu[0]))
son

# ---------------- BÖLÜM 3b: DEYİM DERLEYİCİ ----------------
# Deyimlerde RPN bandı KULLANILMIYOR — doğrudan özyinelemeli bant yayma.
# Atlama düzeltmesi tek yerde: bagla(). İkinci bir fixup sistemi yok.

# ifadeSonuc: ifadeyi derler, sonucu rax'a POP eder (yığın dengede kalır).
# tipKutu: TEK elemanlı çıkış kutusu — ifadeBantYaz sonucun tipini
# ("tam"/"metin") tipKutu[0]'a yazar. Çağıran ilgilenmiyorsa tek kullanımlık
# [""] geçip yok sayabilir (yaz/eğer/iken/döndür), ilgileniyorsa (atama)
# adTipiAyarla ile değişken tablosuna kaydeder.
işlev ifadeSonuc(tokenler, pozKutu, adlarKutu, sayacKutu, tipKutu, islevTipKutu)
    rpn = ifadeAyristir(tokenler, pozKutu, sayacKutu)
    kod = ifadeBantYaz(rpn, adlarKutu, sayacKutu, tipKutu, islevTipKutu)
    döndür listeBirlestir(kod, popKayit(0))
son

# blokDerle: "son" (veya "değilse") görene kadar deyimleri derler.
# dBas/dSon: en içteki (kapsayan) döngünün "devam"/"dur" hedef etiketleri.
# Döngü dışında ikisi de "" (boş metin) — dur/devam orada kullanılırsa
# bagla() "etiket bulunamadi" ile yakalar, sessiz kalmaz. Tan'da global
# mutable yığın olmadığından bu ikili STACK yerine ÖZYİNELİ ÇAĞRI
# PARAMETRESİ olarak taşınıyor — iç içe döngülerde her çağrı kendi
# seviyesini doğal olarak taşır, ayrı push/pop mekanizması gerekmez.
# dEtiketler: [dBas, dSon] tek listede — parametre sayısı 6 (System V AMD64
# kayıt sınırı: rdi/rsi/rdx/rcx/r8/r9) sınırını AŞMAMAK için dBas+dSon TEK
# parametreye ("dEtiketler") sıkıştırıldı (islevTipKutu eklenince 8 parametre
# olurdu — Go referans derleyicisi bunu 7. argümanda "index out of range
# [6] with length 6" ile YAKALADI, sessizce yanlış kod üretmedi, iyi haber).
işlev blokDerle(tokenler, pozKutu, adlarKutu, sayacKutu, dEtiketler, islevTipKutu)
    # TAMPON KULLANIYOR (bkz. "TAMPON" başlığı) — bu döngü TancElf.tan'ın
    # KENDİ kaynağı (~2400 satır, yüzlerce deyim) için en büyük O(n²)
    # kaynağıydı: her deyim "kod = listeBirlestir(kod, ...)" ile MEVCUT
    # boyut kadar kopyalıyordu. Sabit nokta denemesinde WSL'i çökertti.
    kodKutu = tamponOlustur()
    nKutu = [0]
    iken doğru
        x = pSatirlariAtla(tokenler, pozKutu)
        t = pTur(tokenler, pozKutu)
        eğer t == "DOSYASONU" ise
            döndür tamponSonuc(kodKutu, nKutu)
        son
        d = pDeger(tokenler, pozKutu)
        eğer t == "ANAHTAR" ve (d == "son" veya d == "değilse") ise
            döndür tamponSonuc(kodKutu, nKutu)
        son
        z = tamponEkleTumu(kodKutu, nKutu, deyimDerle(tokenler, pozKutu, adlarKutu, sayacKutu, dEtiketler, islevTipKutu))
    son
    döndür tamponSonuc(kodKutu, nKutu)
son

işlev deyimDerle(tokenler, pozKutu, adlarKutu, sayacKutu, dEtiketler, islevTipKutu)
    t = pTur(tokenler, pozKutu)
    d = pDeger(tokenler, pozKutu)

    # --- yaz <ifade>  /  yaz(<ifade>) ---
    eğer t == "ANAHTAR" ve d == "yaz" ise
        x = pIlerle(tokenler, pozKutu)
        tipKutu = [""]
        kodKutu = tamponOlustur()
        nKutu = [0]
        z = tamponEkleTumu(kodKutu, nKutu, ifadeSonuc(tokenler, pozKutu, adlarKutu, sayacKutu, tipKutu, islevTipKutu))
        z = tamponEkleTumu(kodKutu, nKutu, movKayit(7, 0))      # mov rdi, rax
        eğer tipKutu[0] == "metin" ise
            z = tamponEkleTumu(kodKutu, nKutu, callBant("f_yaz_metin"))
            döndür tamponSonuc(kodKutu, nKutu)
        son
        eğer tipKutu[0] == "kesir" ise
            # FAZ 6: kesir değeri f_kesir_metne ile metne çevrilir (Go
            # yazDugum'da CKesir dalı — f_yaz_kesir yardımcısı).
            z = tamponEkleTumu(kodKutu, nKutu, callBant("f_yaz_kesir"))
            döndür tamponSonuc(kodKutu, nKutu)
        son
        z = tamponEkleTumu(kodKutu, nKutu, callBant("yaz_sayi"))
        döndür tamponSonuc(kodKutu, nKutu)
    son

    # --- eğer <ifade> ise ... [değilse eğer ... ise ...]* [değilse ...] son ---
    # BULUNDU (sabit nokta denemesinde, ÜÇÜNCÜ ve EN CİDDİ kök neden): eskiden
    # "değilse eğer B ise..." KENDİ İÇİNDE deyimDerle'nin "eğer" dalını
    # ÖZYİNELİ çağırıyordu — o iç çağrı ZİNCİRİN TEK "son"unu KENDİ kapanışı
    # sanıp tüketiyordu. Kontrol dıştaki "eğer A ise..."ye dönünce, O DA
    # kendi "son" kontrolünü (811-813) çalıştırıyor ama gerçek "son" ZATEN
    # YOK — bulduğu ilk "son" her neyse (çevreleyen iken/işlevin KENDİ
    # kapanışı) onu YANLIŞLIKLA yutuyordu. Sonuç: "eğer/değilse eğer" zinciri
    # bir döngünün SON deyimiyse, döngüden SONRAKİ kod (ör. döndür) döngü
    # gövdesine sızıyor — HER YİNELEMEDE erken dönüş/çıkış. tokenle()'nin
    # KENDİ ana anahtar-kelime/AD ayrımı TAM BU KALIPTA (iken içinde eğer/
    # değilse eğer/değilse zinciri, döngüden sonra döndür) olduğundan bu,
    # gen2'nin HER girdide sessizce (boş çıktı, exit 0) bozuk üretilmesinin
    # kök nedeniydi. Çözüm: özyineleme YERİNE döngü — TÜM elif dallarını TEK
    # "iken doğru" ile gez, "son"u SADECE ZİNCİRİN SONUNDA, TEK SEFER tüket.
    eğer t == "ANAHTAR" ve d == "eğer" ise
        x = pIlerle(tokenler, pozKutu)
        etSon = yeniEtiket(sayacKutu, "Legerson")
        kodKutu = tamponOlustur()
        nKutu = [0]
        iken doğru
            etDegilse = yeniEtiket(sayacKutu, "Ldegilse")
            z = tamponEkleTumu(kodKutu, nKutu, ifadeSonuc(tokenler, pozKutu, adlarKutu, sayacKutu, [""], islevTipKutu))
            # "ise" anahtarını yut
            eğer pTur(tokenler, pozKutu) == "ANAHTAR" ve pDeger(tokenler, pozKutu) == "ise" ise
                x = pIlerle(tokenler, pozKutu)
            son
            z = tamponEkleTumu(kodKutu, nKutu, cmpImm32(0, 0))
            z = tamponEkleTumu(kodKutu, nKutu, jccBant(132, etDegilse))   # jz
            z = tamponEkleTumu(kodKutu, nKutu, blokDerle(tokenler, pozKutu, adlarKutu, sayacKutu, dEtiketler, islevTipKutu))
            z = tamponEkleTumu(kodKutu, nKutu, jmpBant(etSon))
            z = tamponEkleTumu(kodKutu, nKutu, [bcEtiket(etDegilse)])
            eğer pTur(tokenler, pozKutu) == "ANAHTAR" ve pDeger(tokenler, pozKutu) == "değilse" ise
                x = pIlerle(tokenler, pozKutu)
                eğer pTur(tokenler, pozKutu) == "ANAHTAR" ve pDeger(tokenler, pozKutu) == "eğer" ise
                    # "değilse eğer" — zincire devam, koşulu ayrıştırmak için
                    # döngü başına dön ("eğer" anahtarını yut, "son" YOK)
                    x = pIlerle(tokenler, pozKutu)
                değilse
                    # son (koşulsuz) "değilse" gövdesi — zincir burada biter
                    z = tamponEkleTumu(kodKutu, nKutu, blokDerle(tokenler, pozKutu, adlarKutu, sayacKutu, dEtiketler, islevTipKutu))
                    dur
                son
            değilse
                # ne "değilse eğer" ne "değilse" — zincir burada biter
                dur
            son
        son
        # "son" anahtarını yut — TÜM zincir için TEK SEFER
        eğer pTur(tokenler, pozKutu) == "ANAHTAR" ve pDeger(tokenler, pozKutu) == "son" ise
            x = pIlerle(tokenler, pozKutu)
        son
        z = tamponEkleTumu(kodKutu, nKutu, [bcEtiket(etSon)])
        döndür tamponSonuc(kodKutu, nKutu)
    son

    # --- iken <ifade> ... son ---
    eğer t == "ANAHTAR" ve d == "iken" ise
        x = pIlerle(tokenler, pozKutu)
        etBas = yeniEtiket(sayacKutu, "Lbas")
        etSon = yeniEtiket(sayacKutu, "Lson")
        kodKutu = tamponOlustur()
        nKutu = [0]
        z = tamponEkle(kodKutu, nKutu, bcEtiket(etBas))
        z = tamponEkleTumu(kodKutu, nKutu, ifadeSonuc(tokenler, pozKutu, adlarKutu, sayacKutu, [""], islevTipKutu))
        z = tamponEkleTumu(kodKutu, nKutu, cmpImm32(0, 0))
        z = tamponEkleTumu(kodKutu, nKutu, jccBant(132, etSon))       # jz
        z = tamponEkleTumu(kodKutu, nKutu, blokDerle(tokenler, pozKutu, adlarKutu, sayacKutu, [etBas, etSon], islevTipKutu))
        z = tamponEkleTumu(kodKutu, nKutu, jmpBant(etBas))
        eğer pTur(tokenler, pozKutu) == "ANAHTAR" ve pDeger(tokenler, pozKutu) == "son" ise
            x = pIlerle(tokenler, pozKutu)
        son
        z = tamponEkleTumu(kodKutu, nKutu, [bcEtiket(etSon)])
        döndür tamponSonuc(kodKutu, nKutu)
    son

    # --- her <ad> <liste-ifadesi> içinde ... son ---
    # Yığın deseni DerleElf.go HerDugum ile birebir aynı: [rsp]=sayaç (0'dan
    # başlar), [rsp+8]=liste işaretçisi. "dur" -> temizle etiketine (rsp+16,
    # döngü biter), "devam" -> sayaç artırılıp başa dönen etikete.
    eğer t == "ANAHTAR" ve d == "her" ise
        x = pIlerle(tokenler, pozKutu)          # 'her' yut
        degisken = pDeger(tokenler, pozKutu)
        x = pIlerle(tokenler, pozKutu)          # değişken adı yut
        listeBant = ifadeAyristir(tokenler, pozKutu, sayacKutu)
        eğer pTur(tokenler, pozKutu) == "ANAHTAR" ve pDeger(tokenler, pozKutu) == "içinde" ise
            x = pIlerle(tokenler, pozKutu)
        son

        etBas = yeniEtiket(sayacKutu, "Lherbas")
        etDevam = yeniEtiket(sayacKutu, "Lherdevam")
        etTemiz = yeniEtiket(sayacKutu, "Lhertemiz")

        # ifadeBantYaz zaten sonucu (liste işaretçisi) yığının tepesine push
        # ediyor (her RPN op'un kendi pushKayit'i ile biter) — burada AYRICA
        # push etmek çift-push/yığın kayması yaratır (nested her dongude
        # crash'e yol açan bug buydu). Sadece sayacı ekle: [rsp]=sayaç,
        # [rsp+8]=liste (ifadeBantYaz'ın zaten push ettiği değer).
        kodKutu = tamponOlustur()
        nKutu = [0]
        z = tamponEkleTumu(kodKutu, nKutu, ifadeBantYaz(listeBant, adlarKutu, sayacKutu, [""], islevTipKutu))
        z = tamponEkleTumu(kodKutu, nKutu, pushImm32(0))     # [rsp] = sayaç, liste artık [rsp+8]
        z = tamponEkle(kodKutu, nKutu, bcEtiket(etBas))
        z = tamponEkleTumu(kodKutu, nKutu, movRspOku(1, 0))  # rcx = sayaç
        z = tamponEkleTumu(kodKutu, nKutu, movRspOku(0, 8))  # rax = liste
        z = tamponEkleTumu(kodKutu, nKutu, movPtrOku(2, 0))  # rdx = *rax (uzunluk)
        z = tamponEkleTumu(kodKutu, nKutu, cmpKayit(1, 2))
        z = tamponEkleTumu(kodKutu, nKutu, jccBant(141, etTemiz))  # jge -> bitir
        z = tamponEkleTumu(kodKutu, nKutu, leaOge(0, 0, 1))        # rax = &liste[sayaç]
        z = tamponEkleTumu(kodKutu, nKutu, movPtrOku(0, 0))        # rax = eleman değeri
        yuva = adEkle(adlarKutu, degisken)
        z = tamponEkleTumu(kodKutu, nKutu, movYerelYaz(yuvaDisp(yuva), 0))
        z = tamponEkleTumu(kodKutu, nKutu, blokDerle(tokenler, pozKutu, adlarKutu, sayacKutu, [etDevam, etTemiz], islevTipKutu))
        z = tamponEkle(kodKutu, nKutu, bcEtiket(etDevam))
        z = tamponEkleTumu(kodKutu, nKutu, incRspSifir())    # sayaç++
        z = tamponEkleTumu(kodKutu, nKutu, jmpBant(etBas))
        z = tamponEkle(kodKutu, nKutu, bcEtiket(etTemiz))
        z = tamponEkleTumu(kodKutu, nKutu, addImm32(4, 16))  # rsp += 16 (sayaç+liste temizle)
        eğer pTur(tokenler, pozKutu) == "ANAHTAR" ve pDeger(tokenler, pozKutu) == "son" ise
            x = pIlerle(tokenler, pozKutu)
        son
        döndür tamponSonuc(kodKutu, nKutu)
    son

    # --- dur / devam ---
    eğer t == "ANAHTAR" ve d == "dur" ise
        x = pIlerle(tokenler, pozKutu)
        döndür jmpBant(dEtiketler[1])
    son
    eğer t == "ANAHTAR" ve d == "devam" ise
        x = pIlerle(tokenler, pozKutu)
        döndür jmpBant(dEtiketler[0])
    son

    # --- işlev <ad>(<param, ...>) ... son ---
    # Çağrı kuralı: System V AMD64 — argümanlar sırayla rdi,rsi,rdx,rcx,r8,r9.
    # Kod, gövdenin bulunduğu yere GÖMÜLÜ üretilir (ayrı bir "işlev bandı"
    # biriktirme mekanizması yok — Tan'da iç içe liste desteği sınırlı,
    # bkz. Bölüm 1 başlığı) ama üstünden bir jmp ile ATLANIR, böylece ana akış
    # işlev gövdesine "düşerek" girmez. bagla() iki geçişli olduğu için
    # çağrının işlev tanımından ÖNCE ya da SONRA geçmesi fark etmez.
    eğer t == "ANAHTAR" ve d == "işlev" ise
        x = pIlerle(tokenler, pozKutu)      # 'işlev' yut
        ad = pDeger(tokenler, pozKutu)      # işlev adı
        x = pIlerle(tokenler, pozKutu)      # ad yut -> pos '('
        x = pIlerle(tokenler, pozKutu)      # '(' yut -> pos ilk param / ')'
        parametreler = []
        iken pTur(tokenler, pozKutu) != "PARKAPA" ve pTur(tokenler, pozKutu) != "DOSYASONU"
            eğer pTur(tokenler, pozKutu) == "AD" ise
                parametreler = ekle(parametreler, pDeger(tokenler, pozKutu))
                x = pIlerle(tokenler, pozKutu)
            değilse
                x = pIlerle(tokenler, pozKutu)   # virgül vb. — atla
            son
        son
        x = pIlerle(tokenler, pozKutu)      # ')' yut

        # --- FAZ 5 (A): erişilemeyen işlevi derleme (ölü budama) ---
        # islevTipKutu[4] erişilebilir işlev kümesidir. Boş/geçersizse eski
        # davranış: TÜM işlevler derlenir. Erişilebilir değilse gövdeyi atla.
        eğer uzunluk(islevTipKutu) > 4 ve uzunluk(islevTipKutu[4]) > 0 ve adIndisBul(islevTipKutu[4], ad) == 0 - 1 ise
            govdeSonuc = islevGovdeSonBul(tokenler, pozKutu[0])
            iken pozKutu[0] < govdeSonuc[0]
                x = pIlerle(tokenler, pozKutu)
            son
            döndür []
        son

        etAtla = yeniEtiket(sayacKutu, "Lislevatla")
        kodKutu = tamponOlustur()
        nKutu = [0]
        z = tamponEkleTumu(kodKutu, nKutu, jmpBant(etAtla))
        z = tamponEkleTumu(kodKutu, nKutu, islevDerle(ad, parametreler, tokenler, pozKutu, sayacKutu, islevTipKutu))
        z = tamponEkle(kodKutu, nKutu, bcEtiket(etAtla))
        döndür tamponSonuc(kodKutu, nKutu)
    son

    # --- döndür <ifade> ---
    eğer t == "ANAHTAR" ve d == "döndür" ise
        x = pIlerle(tokenler, pozKutu)
        kodKutu = tamponOlustur()
        nKutu = [0]
        z = tamponEkleTumu(kodKutu, nKutu, ifadeSonuc(tokenler, pozKutu, adlarKutu, sayacKutu, [""], islevTipKutu))
        z = tamponEkleTumu(kodKutu, nKutu, leaveBant())
        z = tamponEkleTumu(kodKutu, nKutu, retBant())
        döndür tamponSonuc(kodKutu, nKutu)
    son

    # --- <ad>[<indeks>] = <ifade>   (liste yerinde değiştirme) ---
    # --- <ad> = <ifade> ---
    eğer t == "AD" ise
        ad = d
        x = pIlerle(tokenler, pozKutu)

        eğer pTur(tokenler, pozKutu) == "KOSAC" ise
            # ad[i1][i2]...[ik] = değer — son köşeli parantez YAZMA hedefi,
            # öncekiler bir alt listeye inmek için OKUMA (m[0][0]=99 gibi
            # iç içe liste ataması bunu gerektiriyor).
            indeksBantlari = []
            iken pTur(tokenler, pozKutu) == "KOSAC"
                x = pIlerle(tokenler, pozKutu)          # '[' yut
                ib = ifadeAyristir(tokenler, pozKutu, sayacKutu)
                x = pIlerle(tokenler, pozKutu)          # ']' yut
                indeksBantlari = ekle(indeksBantlari, ib)
            son
            eğer pTur(tokenler, pozKutu) == "ISLEC" ve pDeger(tokenler, pozKutu) == "=" ise
                x = pIlerle(tokenler, pozKutu)
                degerBant = ifadeAyristir(tokenler, pozKutu, sayacKutu)
                yuva = adAra(adlarKutu, ad)
                eğer yuva < 0 ise
                    yuva = adEkle(adlarKutu, ad)
                son
                adet = uzunluk(indeksBantlari)
                kodKutu = tamponOlustur()
                nKutu = [0]
                z = tamponEkleTumu(kodKutu, nKutu, movYerelOku(0, yuvaDisp(yuva)))    # rax = en dış liste işaretçisi
                i = 0
                iken i < adet - 1
                    z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))
                    z = tamponEkleTumu(kodKutu, nKutu, ifadeBantYaz(indeksBantlari[i], adlarKutu, sayacKutu, [""], islevTipKutu))
                    z = tamponEkleTumu(kodKutu, nKutu, popKayit(2))     # rdx = indeks
                    z = tamponEkleTumu(kodKutu, nKutu, popKayit(1))     # rcx = bir üst liste
                    z = tamponEkleTumu(kodKutu, nKutu, leaOge(0, 1, 2)) # rax = &liste[indeks]
                    z = tamponEkleTumu(kodKutu, nKutu, movPtrOku(0, 0)) # rax = *rax (bir alt liste)
                    i = i + 1
                son
                # rax = yazılacak son-seviye liste işaretçisi
                z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))
                z = tamponEkleTumu(kodKutu, nKutu, ifadeBantYaz(indeksBantlari[adet - 1], adlarKutu, sayacKutu, [""], islevTipKutu))
                z = tamponEkleTumu(kodKutu, nKutu, ifadeBantYaz(degerBant, adlarKutu, sayacKutu, [""], islevTipKutu))
                z = tamponEkleTumu(kodKutu, nKutu, popKayit(2))        # rdx = değer
                z = tamponEkleTumu(kodKutu, nKutu, popKayit(1))        # rcx = son indeks
                z = tamponEkleTumu(kodKutu, nKutu, popKayit(0))        # rax = son-seviye liste
                z = tamponEkleTumu(kodKutu, nKutu, leaOge(0, 0, 1))    # rax = &liste[indeks]
                z = tamponEkleTumu(kodKutu, nKutu, movPtrYaz(0, 2))   # [rax] = rdx
                döndür tamponSonuc(kodKutu, nKutu)
            son
            döndür []
        son

        eğer pTur(tokenler, pozKutu) == "ISLEC" ve pDeger(tokenler, pozKutu) == "=" ise
            x = pIlerle(tokenler, pozKutu)
            yuva = adEkle(adlarKutu, ad)
            tipKutu = [""]
            kod = ifadeSonuc(tokenler, pozKutu, adlarKutu, sayacKutu, tipKutu, islevTipKutu)
            adTipiAyarla(adlarKutu, ad, tipKutu[0])
            döndür listeBirlestir(kod, movYerelYaz(yuvaDisp(yuva), 0))
        son

        eğer pTur(tokenler, pozKutu) == "PARAC" ise
            # İFADE DEYİMİ: sonucu bir değişkene atamadan çağrı (yan etki
            # için — oku()/yazBaytlar() gibi). Bulundu: bu dal
            # hiç yoktu, "yazBaytlar(yol, liste)" gibi bağımsız çağrılar
            # SESSİZCE atlanıyordu (aşağıdaki eski yorum: "ifade deyimi
            # henüz desteklenmiyor" — dosya G/Ç bunu ZORUNLU kıldı). Konumu
            # AD'a geri alıp tüm ifadeyi normal yoldan derliyoruz; sonuç
            # rax'a pop edilir ama kullanılmaz.
            pozKutu[0] = pozKutu[0] - 1
            döndür ifadeSonuc(tokenler, pozKutu, adlarKutu, sayacKutu, [""], islevTipKutu)
        son

        # atama/çağrı değilse: satırı atla (henüz desteklenmiyor)
        döndür []
    son

    # tanınmayan deyim: ÖNCEDEN sessizce yutup devam ediyordu — TAM avladığımız
    # 8 hatanın deseniyle aynı sınıf (sessiz bozulma, açık hata yok). dene/
    # yakala (Bucket C) bu yüzden [FARKLI] veriyordu: lexer tanıyor, buraya
    # düşüyor, sessizce atlanıyordu. Artık açık hata + dur — TancElf'e
    # eklenmemiş HİÇBİR deyim bundan sonra sessizce geçemez.
    yaz("DERLEME HATASI: bilinmeyen deyim: " + d)
    sistemDur(1)
son

# ---------------- BÖLÜM 4 (ÇEKİRDEK): MAKİNE KODU + ELF YAZICI ----------------
# Kural değişikliği (kod incelemesi sonrası): deyimler (eğer/iken/işlev/her)
# RPN banda YAZILMAYACAK — DerleElf.go nasıl yapıyorsa öyle, doğrudan
# özyinelemeli kod yayımı + TEK etiket/rel32 düzeltme sistemi (aşağıdaki
# etiketler/duzeltmeler). RPN sadece İFADELER için kalıyor (Bölüm 2).
#
# "Kutu" (pozKutu gibi tek elemanlı liste, göstericiyi simüle eden) teknik
# SADECE konum imleci için kullanılır ve ASLA ekle()'den geçirilmez —
# ekle() her zaman YENİ liste döndürdüğü için (yerinde değil) göstericiyi
# kırar, hata sessiz kalır. Aşağıdaki kod baytı tamponları ("kod" değişkeni)
# bunun TERSİ desenle çalışır: her fonksiyon KENDİ genişletilmiş bandını
# DÖNDÜRÜR, çağıran yeniden atar (kod = fonk(kod, ...)) — hiçbir zaman kutu
# değil, hep düz döndür-yeniden-ata.
#
# Bayt kodlaması Tan'da bitwise işleç YOK (& | << >> tanımsız) — bu yüzden
# çok baytlı tam sayıları (i32/i64) taban-256 KAT BÖLME/KALAN ile ayrıştırıyoruz.
# İşaretli sayılarda Tan'ın "/" ve "%" işleci SIFIRA DOĞRU KESER (idiv
# donanım semantiği) — negatif değerlerde bu YANLIŞ bayt verir. Bu yüzden
# tabanBol256 KENDİ taban (floor) bölmesini elle hesaplıyor.

işlev tabanBol256(v)
    eğer v >= 0 ise
        döndür tamBol(v, 256)
    son
    döndür 0 - tamBol((0 - v) + 255, 256)
son

işlev tamdanBaytlar(v, sayisi)
    sonuc = []
    kalan = v
    i = 0
    iken i < sayisi
        q = tabanBol256(kalan)
        b = kalan - q * 256
        sonuc = ekle(sonuc, b)
        kalan = q
        i = i + 1
    son
    döndür sonuc
son

# baytListesiBirlestir: listeBirlestir'in TAM SAYI bayt listeleri için AYRI
# kopyası. NEDEN AYRI: listeBirlestir Bölüm 4'te HEMEN HEMEN HER YERDE bant
# (bc-kodlu METIN girişleri) birleştirmek için kullanılıyor — Go'nun statik
# tip çıkarımı fonksiyon parametresi başına TEK tip öğreniyor (bkz. SURUM.md
# "parametre tipleri" notu). kodEkleN/bagla/elfUret ise HAM TAM SAYI bayt
# listeleri birleştiriyor — aynı fonksiyonu ikisi için de kullanmak Go'nun
# elf arka ucunda "b" parametresinin tipini METNE sabitliyor, kodEkleN/bagla/
# elfUret'teki TAM SAYI kullanımı o zaman YANLIŞ derleniyor (self-hosting
# sırasında binlerce baytlık programlarda rastgele bir noktada çöküyor —
# TancElf'in KENDİSİ derlenirken bulundu, DOKUMANTASYON.md 5. kural: "Fark
# testi TancElf ↔ TancElf tutarlılığını kanıtlar, doğruluğu değil" örneği).
# baytTampon*: "TAMPON" ailesinin TAM SAYI bayt listeleri için AYRI kopyası
# — tamponOlustur/tamponEkle/... zaten Bölüm 2/3b'de METİN (bant, bc-kodlu)
# listeleri için HER YERDE kullanılıyor; Go'nun statik tip çıkarımı fonksiyon
# parametresi başına TEK tip öğrendiğinden (bkz. yukarıdaki NEDEN AYRI notu)
# aynı tampon fonksiyonlarını TAM SAYI baytlar için de kullanmak "liste"/
# "deger" parametrelerinin tipini METNE sabitleyip elfUret'i yanlış derletir.
# BULUNDU (sabit nokta denemesinde, ÜÇÜNCÜ O(n²) kaynağı): tokenle/bagla/
# blokDerle/ifadeBantYaz/islevDerle/deyimDerle VE govde-birleştirme hepsi
# tamponla düzeltildikten SONRA bile hâlâ çöküyordu — sebebi elfUret'in
# SONUNDAKİ "baytListesiBirlestir(b, kodBaytlari)" çağrısıydı: kodBaytlari
# (TancElf kendini derlerken ~90 KB) TEK bir çağrıyla, eski ekle()-kopyalayan
# listeBirlestir deseniyle ekleniyordu — O(|kodBaytlari|²).
işlev baytTamponOlustur()
    döndür [listeYap(64, 0)]
son

işlev baytTamponEkle(tamponKutu, nKutu, deger)
    liste = tamponKutu[0]
    n = nKutu[0]
    kap = uzunluk(liste)
    eğer n >= kap ise
        yeniKap = kap * 2
        eğer yeniKap < 64 ise
            yeniKap = 64
        son
        yeni = listeYap(yeniKap, 0)
        i = 0
        iken i < n
            yeni[i] = liste[i]
            i = i + 1
        son
        tamponKutu[0] = yeni
        liste = yeni
    son
    liste[n] = deger
    nKutu[0] = n + 1
    döndür 0
son

işlev baytTamponEkleTumu(tamponKutu, nKutu, digerListe)
    her x digerListe içinde
        z = baytTamponEkle(tamponKutu, nKutu, x)
    son
    döndür 0
son

işlev baytTamponSonuc(tamponKutu, nKutu)
    liste = tamponKutu[0]
    n = nKutu[0]
    sonuc = listeYap(n, 0)
    i = 0
    iken i < n
        sonuc[i] = liste[i]
        i = i + 1
    son
    döndür sonuc
son

işlev baytListesiBirlestir(a, b)
    tk = baytTamponOlustur()
    nk = [0]
    z = baytTamponEkleTumu(tk, nk, a)
    z = baytTamponEkleTumu(tk, nk, b)
    döndür baytTamponSonuc(tk, nk)
son

işlev kodEkleN(kod, v, n)
    döndür baytListesiBirlestir(kod, tamdanBaytlar(v, n))
son

# ModRM baytı: mod(2) reg(3) rm(3). Alanlar bit-ayrık olduğundan toplama
# bitwise OR ile aynı sonucu verir (reg/rm daima 0-11 arası, negatif değil).
işlev modrmBayt(mod, reg, rm)
    döndür mod * 64 + (reg % 8) * 8 + (rm % 8)
son

işlev metneTamSayi(s)
    # ÖNCEDEN "s[i]" (ham indeksleme) kullanıyordu — s PARAMETRE olduğundan
    # tipi hep "tam" sanılıyordu, indeksleme metin baytı yerine YANLIŞ bir
    # değer (gözlemlenen: doğrudan bayt kodu, metin işaretçisi DEĞİL)
    # üretiyordu — kod(s[i]) bu yüzden kod()'u GEÇERSİZ bir "işaretçi" ile
    # çağırıp SIGSEGV veriyordu (metneTamSayi HER SAYI token'ı için
    # çağrıldığından self-hosting'i doğrudan bloke ediyordu). metinAl()
    # statik tipten BAĞIMSIZ olduğundan güvenli.
    n = uzunluk(s)
    i = 0
    deger = 0
    iken i < n
        deger = deger * 10 + (kod(metinAl(s, i)) - 48)
        i = i + 1
    son
    döndür deger
son

# ---------------- FAZ 6: ONDALIK LITERAL -> IEEE754 BIT DESENI ----------------
# Go tarafında int64(math.Float64bits(ParseFloat(s,64))) TEK SATIRDA bit
# deseni üretir; TancElf'ta float YOK, bu yüzden "d.ddd" metnini tamamen
# TAMSAYI aritmetiğiyle IEEE754 double bit desenine çeviren saf bir rutin
# gerekli. Yöntem: değer = M/10^F (M = tüm basamaklar, F = nokta sonrası
# basamak sayısı, her zaman F >= 0). Tam kısım t = M/10^F ve kesirli kısım
# k/olcek (k = M % olcek) ayrıştırılır; kesirli kısım UZUN BÖLME ile ikili
# bitlere (2^-1, 2^-2, ...) açılır; 53-bit mantis toplanır, 54. bit
# YUVARLA-YARIYA-EŞİT (round-half-even) ile yuvarlanır; biased üs + mantis
# birleştirilir. İşaret biti NEGATIF kolu tarafından xor ile eklenir.
# Sınır: ~15 anlamlı basamak (M int64'e sığmalı) ve normal double aralığı
# (2^-1022'den küçük değerler subnormal — gerçek literal'lerde asla oluşmaz).

işlev guc2(k)
    g = 1
    j = 0
    iken j < k
        g = g * 2
        j = j + 1
    son
    döndür g
son

# kesirBit: k/olcek'in fi'inci ikili biti (fi=1 -> 2^-1). Uzun bölme:
# bit_i = tamBol(f*2, olcek) OLMADAN önce, kalan f = (f*2) mod olcek.
işlev kesirBit(k, olcek, fi)
    f = k
    j = 0
    bit = 0
    iken j < fi
        f = f * 2
        bit = tamBol(f, olcek)
        f = f % olcek
        j = j + 1
    son
    döndür bit
son

# kesirKalan: fi bit çıkarıldıktan SONRAKI kuyruk (f) — yuvarlama sticky'si.
# f != 0 ise aşağıda en az bir 1 daha var demektir.
işlev kesirKalan(k, olcek, n)
    f = k
    j = 0
    iken j < n
        f = f * 2
        f = f % olcek
        j = j + 1
    son
    döndür f
son

işlev kesirBits(s)
    n = uzunluk(s)
    M = 0
    F = 0
    sonraNokta = 0
    i = 0
    iken i < n
        c = metinAl(s, i)
        eğer c == "." ise
            sonraNokta = 1
        değilse
            M = M * 10 + (kod(c) - 48)
            eğer sonraNokta == 1 ise
                F = F + 1
            son
        son
        i = i + 1
    son
    eğer M == 0 ise
        döndür 0
    son
    olcek = 1
    j = 0
    iken j < F
        olcek = olcek * 10
        j = j + 1
    son
    t = tamBol(M, olcek)
    k = M % olcek
    tt = t
    L = 0
    iken tt > 0
        L = L + 1
        tt = tamBol(tt, 2)
    son
    e = 0
    mantis = 0
    eğer t == 0 ise
        # kesirli kısmın ilk set bitini bul (2^-p konumu), üs = -p
        p = 1
        iken kesirBit(k, olcek, p) == 0
            p = p + 1
        son
        e = 0 - p
        j = 1
        iken j <= 52
            mantis = mantis * 2 + kesirBit(k, olcek, p + j)
            j = j + 1
        son
        rB = kesirBit(k, olcek, p + 53)
        kalan = kesirKalan(k, olcek, p + 53)
    değilse
        e = L - 1
        j = 1
        iken j <= 52
            pos = L - 1 - j
            eğer pos >= 0 ise
                bit = tamBol(t, guc2(pos)) % 2
            değilse
                bit = kesirBit(k, olcek, j - L + 1)
            son
            mantis = mantis * 2 + bit
            j = j + 1
        son
        eğer L - 54 >= 0 ise
            rB = tamBol(t, guc2(L - 54)) % 2
            kalan = t % guc2(L - 54)
            eğer k != 0 ise
                kalan = 1
            son
        değilse
            rB = kesirBit(k, olcek, 54 - L)
            kalan = kesirKalan(k, olcek, 54 - L)
        son
    son
    eğer rB == 1 ise
        eğer kalan != 0 veya mantis % 2 == 1 ise
            mantis = mantis + 1
            eğer mantis == 9007199254740992 ise
                mantis = 0
                e = e + 1
            son
        son
    son
    döndür (e + 1023) * 4503599627370496 + mantis
son

# ---------------- BANT (etiket/rel32 destekli kod temsili) ----------------
# Kayıt/mov/syscall kodlayıcıları artık HAM BAYT değil "bant" (bc() ile
# kodlanmış işaretleyici dizisi) üretiyor — RPN ile AYNI SOH kodlaması,
# üç giriş türü: "BAYT<SOH>n", "ETIKET<SOH>ad", "REL32<SOH>ad" (4 baytlık
# yer tutucu, bağla() aşamasında hedefKonum-(buradaKonum+4) ile doldurulur).
# Bu, DerleElf.go'daki TEK etiket/duzeltmeler mekanizmasının Tan'daki
# karşılığı — deyimler (Bölüm sonrası) doğrudan bu bandı özyinelemeli
# üretecek, RPN'den AYRI bir ikinci düzeltme sistemi DEĞİL.

işlev bcBayt(n)
    döndür bc("BAYT", metin(n), "")
son
işlev bcEtiket(ad)
    döndür bc("ETIKET", ad, "")
son
işlev bcRel32(ad)
    döndür bc("REL32", ad, "")
son

işlev baytlarBant(baytlar)
    bant = []
    her b baytlar içinde
        bant = ekle(bant, bcBayt(b))
    son
    döndür bant
son

işlev nBant(v, sayisi)
    döndür baytlarBant(tamdanBaytlar(v, sayisi))
son

işlev pushKayit(r)
    bant = []
    eğer r >= 8 ise
        bant = ekle(bant, bcBayt(65)) # 0x41 REX.B
    son
    döndür ekle(bant, bcBayt(80 + (r % 8))) # 0x50+r
son

işlev popKayit(r)
    bant = []
    eğer r >= 8 ise
        bant = ekle(bant, bcBayt(65))
    son
    döndür ekle(bant, bcBayt(88 + (r % 8))) # 0x58+r
son

# mov r64, imm64 (movabs) — REX.W B8+rd imm64
işlev movImm64(r, v)
    rex = 72 # 0x48
    eğer r >= 8 ise
        rex = rex + 1
    son
    bant = [bcBayt(rex), bcBayt(184 + (r % 8))] # 0xB8+r
    döndür listeBirlestir(bant, nBant(v, 8))
son

# mov r64, imm32 (işaretli genişletme) — REX.W C7 /0 id
işlev movImm32(r, v)
    rex = 72
    eğer r >= 8 ise
        rex = rex + 1
    son
    bant = [bcBayt(rex), bcBayt(199), bcBayt(modrmBayt(3, 0, r))]
    döndür listeBirlestir(bant, nBant(v, 4))
son

# iki kayıtlı 64-bit işlem: opkod rm, reg  (89=mov 01=add 29=sub 39=cmp 31=xor)
işlev ikiliKayit(opkod, rm, reg)
    rex = 72
    eğer reg >= 8 ise
        rex = rex + 4
    son
    eğer rm >= 8 ise
        rex = rex + 1
    son
    döndür [bcBayt(rex), bcBayt(opkod), bcBayt(modrmBayt(3, reg, rm))]
son

işlev movKayit(hedef, kaynak)
    döndür ikiliKayit(137, hedef, kaynak) # 0x89
son
işlev addKayit(hedef, kaynak)
    döndür ikiliKayit(1, hedef, kaynak) # 0x01
son
işlev subKayit(hedef, kaynak)
    döndür ikiliKayit(41, hedef, kaynak) # 0x29
son
işlev cmpKayit(sol, sag)
    döndür ikiliKayit(57, sol, sag) # 0x39
son
işlev xorKayit(hedef, kaynak)
    döndür ikiliKayit(49, hedef, kaynak) # 0x31
son
işlev andKayit(hedef, kaynak)
    döndür ikiliKayit(33, hedef, kaynak) # 0x21
son

# ---------------- SSE (ondalık/kesir sayı) komut kodlayıcıları ----------------
# DerleElf.go satır 604-691 ile BİREBİR. Kesir değerleri kayıtlarda HAM BIT
# DESENİ olarak taşınır (tip farkı statik) — xmm'ler yalnız aritmetikte
# geçici kullanılır. Kodlayıcı rex kuralları: modrm'deki reg alanı xmm8+ için
# REX.R(4), rm alanı gpr/xmm8+ için REX.B(1); comisd/sseIkili rex'i 0x40'tan
# başlar (W biti YOK), movq/cvt çiftleri 0x48'den (W biti VAR).

# movq xmm<x>, r64<r>   (66 REX.W 0F 6E /r) — gpr bit desenini xmm'e taşı
işlev movqXmmKayit(x, r)
    rex = 72
    eğer x >= 8 ise
        rex = rex + 4
    son
    eğer r >= 8 ise
        rex = rex + 1
    son
    döndür [bcBayt(102), bcBayt(rex), bcBayt(15), bcBayt(110), bcBayt(modrmBayt(3, x, r))]
son

# movq r64<r>, xmm<x>   (66 REX.W 0F 7E /r) — sonucu GPR'e geri al
işlev movqKayitXmm(r, x)
    rex = 72
    eğer x >= 8 ise
        rex = rex + 4
    son
    eğer r >= 8 ise
        rex = rex + 1
    son
    döndür [bcBayt(102), bcBayt(rex), bcBayt(15), bcBayt(126), bcBayt(modrmBayt(3, x, r))]
son

# F2 0F <op> /r : addsd(58) subsd(5C) mulsd(59) divsd(5E) xmm<hedef>, xmm<kaynak>
işlev sseIkili(op, hedef, kaynak)
    bant = [bcBayt(242)]
    eğer hedef >= 8 veya kaynak >= 8 ise
        rex = 64
        eğer hedef >= 8 ise
            rex = rex + 4
        son
        eğer kaynak >= 8 ise
            rex = rex + 1
        son
        bant = ekle(bant, bcBayt(rex))
    son
    bant = ekle(bant, bcBayt(15))
    bant = ekle(bant, bcBayt(op))
    döndür ekle(bant, bcBayt(modrmBayt(3, hedef, kaynak)))
son

# cvtsi2sd xmm<x>, r64<r>   (F2 REX.W 0F 2A /r) — tam sayıyı double'a çevir
işlev cvtTamKesir(x, r)
    rex = 72
    eğer x >= 8 ise
        rex = rex + 4
    son
    eğer r >= 8 ise
        rex = rex + 1
    son
    döndür [bcBayt(242), bcBayt(rex), bcBayt(15), bcBayt(42), bcBayt(modrmBayt(3, x, r))]
son

# cvttsd2si r64<r>, xmm<x>   (F2 REX.W 0F 2C /r) — double'ı SIFIRA DOĞRU kes
işlev cvtKesirTam(r, x)
    rex = 72
    eğer r >= 8 ise
        rex = rex + 4
    son
    eğer x >= 8 ise
        rex = rex + 1
    son
    döndür [bcBayt(242), bcBayt(rex), bcBayt(15), bcBayt(44), bcBayt(modrmBayt(3, r, x))]
son

# comisd xmm<a>, xmm<b>   (66 [rex] 0F 2F /r) — işaretsiz bayrak kullanır
# (ondalık karşılaştırma setcc kodları tamsayı kodlarından FARKLI).
işlev comisd(a, b)
    bant = [bcBayt(102)]
    eğer a >= 8 veya b >= 8 ise
        rex = 64
        eğer a >= 8 ise
            rex = rex + 4
        son
        eğer b >= 8 ise
            rex = rex + 1
        son
        bant = ekle(bant, bcBayt(rex))
    son
    bant = ekle(bant, bcBayt(15))
    bant = ekle(bant, bcBayt(47))
    döndür ekle(bant, bcBayt(modrmBayt(3, a, b)))
son

# imul r64, r64 (REX.W 0F AF /r)
işlev imulKayit(hedef, kaynak)
    rex = 72
    eğer hedef >= 8 ise
        rex = rex + 4
    son
    eğer kaynak >= 8 ise
        rex = rex + 1
    son
    döndür [bcBayt(rex), bcBayt(15), bcBayt(175), bcBayt(modrmBayt(3, hedef, kaynak))]
son

işlev cqo()
    döndür [bcBayt(72), bcBayt(153)] # 0x48 0x99
son

# idiv r64 (F7 /7) — isaretli
işlev idivKayit(r)
    rex = 72
    eğer r >= 8 ise
        rex = rex + 1
    son
    döndür [bcBayt(rex), bcBayt(247), bcBayt(modrmBayt(3, 7, r))]
son

# div r64 (F7 /6) — isaretsiz (yaz_sayı basamak çıkarımı için)
işlev divKayit(r)
    rex = 72
    eğer r >= 8 ise
        rex = rex + 1
    son
    döndür [bcBayt(rex), bcBayt(247), bcBayt(modrmBayt(3, 6, r))]
son

# neg r64 (F7 /3)
işlev negKayit(r)
    rex = 72
    eğer r >= 8 ise
        rex = rex + 1
    son
    döndür [bcBayt(rex), bcBayt(247), bcBayt(modrmBayt(3, 3, r))]
son

# dec r64 (FF /1)
işlev decKayit(r)
    rex = 72
    eğer r >= 8 ise
        rex = rex + 1
    son
    döndür [bcBayt(rex), bcBayt(255), bcBayt(modrmBayt(3, 1, r))]
son

# cmp r64, imm32 (81 /7)
işlev cmpImm32(r, v)
    rex = 72
    eğer r >= 8 ise
        rex = rex + 1
    son
    bant = [bcBayt(rex), bcBayt(129), bcBayt(modrmBayt(3, 7, r))]
    döndür listeBirlestir(bant, nBant(v, 4))
son

# sub r64, imm32 (81 /5) — rsp'yi azaltmak için (subImm32(4, n) = sub rsp,n)
işlev subImm32(r, v)
    rex = 72
    eğer r >= 8 ise
        rex = rex + 1
    son
    bant = [bcBayt(rex), bcBayt(129), bcBayt(modrmBayt(3, 5, r))]
    döndür listeBirlestir(bant, nBant(v, 4))
son

# mov [rbp+disp32], r64 (89 /r, mod=2)
işlev movYerelYaz(disp, kaynak)
    rex = 72
    eğer kaynak >= 8 ise
        rex = rex + 4
    son
    bant = [bcBayt(rex), bcBayt(137), bcBayt(modrmBayt(2, kaynak, 5))]
    döndür listeBirlestir(bant, nBant(disp, 4))
son

# mov r64, [rbp+disp32] (8B /r, mod=2)
işlev movYerelOku(hedef, disp)
    rex = 72
    eğer hedef >= 8 ise
        rex = rex + 4
    son
    bant = [bcBayt(rex), bcBayt(139), bcBayt(modrmBayt(2, hedef, 5))]
    döndür listeBirlestir(bant, nBant(disp, 4))
son

# lea r64, [rbp+disp8] (8D /r, mod=1) — disp8 -128..127 aralığında olmalı
işlev leaRbp(hedef, disp)
    rex = 72
    eğer hedef >= 8 ise
        rex = rex + 4
    son
    dispBayt = disp
    eğer disp < 0 ise
        dispBayt = disp + 256
    son
    döndür [bcBayt(rex), bcBayt(141), bcBayt(modrmBayt(1, hedef, 5)), bcBayt(dispBayt)]
son

# ---------------- LİSTE/YIĞIN için genel dolaylı erişim ----------------
# Aşağıdakiler taban register'ı HER ZAMAN rax/rcx/rdx/rsi/rdi/r8/r9 olacak
# şekilde çağrılır (rsp=4/rbp=5/r12=12 gibi SIB-özel kodlamalar gerektiren
# register'lar ASLA taban olarak geçilmez) — bu yüzden basitleştirilmiş
# mod=0 (disp yok) kodlama güvenli.

# mov hedef, [taban]  (8B /r, mod=0, disp yok)
işlev movPtrOku(hedef, taban)
    rex = 72
    eğer hedef >= 8 ise
        rex = rex + 4
    son
    eğer taban >= 8 ise
        rex = rex + 1
    son
    döndür [bcBayt(rex), bcBayt(139), bcBayt(modrmBayt(0, hedef, taban))]
son

# mov [taban], kaynak  (89 /r, mod=0, disp yok)
işlev movPtrYaz(taban, kaynak)
    rex = 72
    eğer kaynak >= 8 ise
        rex = rex + 4
    son
    eğer taban >= 8 ise
        rex = rex + 1
    son
    döndür [bcBayt(rex), bcBayt(137), bcBayt(modrmBayt(0, kaynak, taban))]
son

# ---------------- VERİ ALANI (RIP-göreli erişim) ----------------
# DerleElf.go'daki movGenelOku/movGenelYaz/leaVeri ile aynı kodlama —
# mod=00, rm=101 x86-64'te ÖZEL: RIP-göreli disp32. bagla()'nın REL32
# çözümleyicisi (hedef-(konum+4)) BU FORMÜLÜN AYNISI olduğundan yeni bir
# düzeltme sistemi gerekmiyor — bcRel32 doğrudan yeniden kullanılıyor.
# Metin literalleri VE global değişkenler (v_yigin/v_yiginSon — r12/r13
# yerine, callee-saved register kırılganlığını gidermek için) burayı kullanır.

# lea hedef, [rip+disp32]
işlev leaVeri(hedef, etiket)
    rex = 72
    eğer hedef >= 8 ise
        rex = rex + 4
    son
    döndür [bcBayt(rex), bcBayt(141), bcBayt(modrmBayt(0, hedef, 5)), bcRel32(etiket)]
son

# mov hedef, [rip+disp32]
işlev movGenelOku(hedef, etiket)
    rex = 72
    eğer hedef >= 8 ise
        rex = rex + 4
    son
    döndür [bcBayt(rex), bcBayt(139), bcBayt(modrmBayt(0, hedef, 5)), bcRel32(etiket)]
son

# mov [rip+disp32], kaynak
işlev movGenelYaz(etiket, kaynak)
    rex = 72
    eğer kaynak >= 8 ise
        rex = rex + 4
    son
    döndür [bcBayt(rex), bcBayt(137), bcBayt(modrmBayt(0, kaynak, 5)), bcRel32(etiket)]
son

# veriAyir: etiket + N sıfır bayt (mutasyona uğrayabilir global değişken
# yuvası — string literalleri için değil, v_yigin/v_yiginSon gibi
# okunup-yazılan tekil global slotlar için).
işlev veriAyir(etiket, bayt)
    b = [bcEtiket(etiket)]
    i = 0
    iken i < bayt
        b = ekle(b, bcBayt(0))
        i = i + 1
    son
    döndür b
son

# lea hedef, [taban + indeks*8 + 8]  (8D /r, mod=1, SIB, disp8=8 sabit) —
# liste düzeni [uzunluk:8][öge0:8]... olduğundan +8 baştaki uzunluk alanını
# atlıyor. DerleElf.go leaOge ile birebir aynı kodlama.
işlev leaOge(hedef, taban, indeks)
    rex = 72
    eğer hedef >= 8 ise
        rex = rex + 4
    son
    eğer indeks >= 8 ise
        rex = rex + 2
    son
    eğer taban >= 8 ise
        rex = rex + 1
    son
    sib = 192 + (indeks % 8) * 8 + (taban % 8)   # scale=11(x8)
    döndür [bcBayt(rex), bcBayt(141), bcBayt(modrmBayt(1, hedef, 4)), bcBayt(sib), bcBayt(8)]
son

# lea hedef, [taban+disp8]  (8D /r, mod=1) — taban ASLA rsp/rbp/r12/r13 değil
işlev leaDolayli(hedef, taban, disp)
    rex = 72
    eğer hedef >= 8 ise
        rex = rex + 4
    son
    eğer taban >= 8 ise
        rex = rex + 1
    son
    dispBayt = disp
    eğer disp < 0 ise
        dispBayt = disp + 256
    son
    döndür [bcBayt(rex), bcBayt(141), bcBayt(modrmBayt(1, hedef, taban)), bcBayt(dispBayt)]
son

# shl r64, imm8 (C1 /4)
işlev shlImm(r, v)
    rex = 72
    eğer r >= 8 ise
        rex = rex + 1
    son
    döndür [bcBayt(rex), bcBayt(193), bcBayt(modrmBayt(3, 4, r)), bcBayt(v)]
son

# inc r64 (FF /0)
işlev incKayit(r)
    rex = 72
    eğer r >= 8 ise
        rex = rex + 1
    son
    döndür [bcBayt(rex), bcBayt(255), bcBayt(modrmBayt(3, 0, r))]
son

# test r64, r64 (85 /r) — ikiliKayit(0x85, rm, reg) ile aynı kodlama
işlev testKayit(a, b)
    döndür ikiliKayit(133, a, b)
son

# add r64, imm32 (81 /0)
işlev addImm32(r, v)
    rex = 72
    eğer r >= 8 ise
        rex = rex + 1
    son
    bant = [bcBayt(rex), bcBayt(129), bcBayt(modrmBayt(3, 0, r))]
    döndür listeBirlestir(bant, nBant(v, 4))
son

# and r64, imm32 (81 /4)
işlev andImm32(r, v)
    rex = 72
    eğer r >= 8 ise
        rex = rex + 1
    son
    bant = [bcBayt(rex), bcBayt(129), bcBayt(modrmBayt(3, 4, r))]
    döndür listeBirlestir(bant, nBant(v, 4))
son

# push imm32 (68 id)
işlev pushImm32(v)
    döndür listeBirlestir([bcBayt(104)], nBant(v, 4))
son

# mov hedef, [rsp+disp8]  (48 8B /r 24 disp8) — rsp taban SIB zorunlu kılar
işlev movRspOku(hedef, disp)
    rex = 72
    eğer hedef >= 8 ise
        rex = rex + 4
    son
    dispBayt = disp
    eğer disp < 0 ise
        dispBayt = disp + 256
    son
    döndür [bcBayt(rex), bcBayt(139), bcBayt(modrmBayt(1, hedef, 4)), bcBayt(36), bcBayt(dispBayt)]
son

# inc qword [rsp]  (48 FF /0 24)
işlev incRspSifir()
    döndür [bcBayt(72), bcBayt(255), bcBayt(modrmBayt(0, 0, 4)), bcBayt(36)]
son

# mov al, [taban]  (8A /r, mod=0) — taban rsi/rdi gibi <8 register olmalı
işlev movBaytOku(taban)
    döndür [bcBayt(138), bcBayt(modrmBayt(0, 0, taban))]
son

# mov byte [r], imm8 (C6 /0)
işlev movBaytImm(r, v)
    döndür [bcBayt(198), bcBayt(modrmBayt(0, 0, r)), bcBayt(v)]
son

# mov [rm], reg8 (88 /r)
işlev movBaytKayit(rmR, regR)
    döndür [bcBayt(136), bcBayt(modrmBayt(0, regR, rmR))]
son

# add byte [r], imm8 (80 /0)
işlev addBaytImm(r, v)
    döndür [bcBayt(128), bcBayt(modrmBayt(3, 0, r)), bcBayt(v)]
son

işlev jmpBant(etiket)
    döndür [bcBayt(233), bcRel32(etiket)] # 0xE9 rel32
son

# jcc rel32 (0F 8x). kod: 0x84=je 0x85=jne 0x8D=jge
işlev jccBant(kod, etiket)
    döndür [bcBayt(15), bcBayt(kod), bcRel32(etiket)]
son

işlev callBant(etiket)
    döndür [bcBayt(232), bcRel32(etiket)] # 0xE8 rel32
son

işlev retBant()
    döndür [bcBayt(195)] # 0xC3
son

işlev leaveBant()
    döndür [bcBayt(201)] # 0xC9
son

işlev syscallEmit()
    döndür [bcBayt(15), bcBayt(5)] # 0x0F 0x05
son

# etiketBul: (etikAdlari, etikKonumlari) paralel düz listelerinde doğrusal arama
işlev etiketBul(ad, etikAdlari, etikKonumlari)
    n = uzunluk(etikAdlari)
    i = 0
    iken i < n
        eğer metinEsit(etikAdlari[i], ad) ise
            döndür etikKonumlari[i]
        son
        i = i + 1
    son
    döndür 0 - 1
son

# bagla: bandı İKİ GEÇİŞLE düz bayt listesine çevirir. 1. geçiş: ETIKET
# konumlarını kaydet. 2. geçiş: BAYT'ları aktar, REL32'leri
# (hedefKonum - (buradaKonum+4)) ile doldur. Tek fonksiyon, tek geçiş
# çifti — DÖNGÜSEL DEĞİL (özyineli parçalar değil), bu yüzden global/kutu
# sorunu yok, sıradan yerel listelerle çalışır.
işlev bagla(bant)
    n = uzunluk(bant)
    etikAdlariKutu = tamponOlustur()
    etikAdlariNKutu = [0]
    etikKonumlariKutu = tamponOlustur()
    etikKonumlariNKutu = [0]
    konum = 0
    i = 0
    iken i < n
        giris = bant[i]
        op = alan(giris, 0)
        eğer metinEsit(op, "BAYT") ise
            konum = konum + 1
        değilse eğer metinEsit(op, "ETIKET") ise
            z = tamponEkle(etikAdlariKutu, etikAdlariNKutu, alan(giris, 1))
            z = tamponEkle(etikKonumlariKutu, etikKonumlariNKutu, konum)
        değilse eğer metinEsit(op, "REL32") ise
            konum = konum + 4
        son
        i = i + 1
    son
    etikAdlari = tamponSonuc(etikAdlariKutu, etikAdlariNKutu)
    etikKonumlari = tamponSonuc(etikKonumlariKutu, etikKonumlariNKutu)

    sonucKutu = tamponOlustur()
    sonucNKutu = [0]
    konum = 0
    i = 0
    iken i < n
        giris = bant[i]
        op = alan(giris, 0)
        eğer metinEsit(op, "BAYT") ise
            z = tamponEkle(sonucKutu, sonucNKutu, metneTamSayi(alan(giris, 1)))
            konum = konum + 1
        değilse eğer metinEsit(op, "REL32") ise
            hedef = etiketBul(alan(giris, 1), etikAdlari, etikKonumlari)
            eğer hedef < 0 ise
                # Tanımsız etiket = eksik yerleşik çağrısı. ÖNCEDEN sadece
                # uyarıp DEVAM ediyordu -> rel çöp adres -> segfault veren
                # binary. Go bağlayıcısı burada duruyor; TancElf de durmalı.
                yaz("BAGLAMA HATASI: etiket bulunamadi: " + alan(giris, 1))
                sistemDur(1)
            son
            rel = hedef - (konum + 4)
            z = tamponEkleTumu(sonucKutu, sonucNKutu, tamdanBaytlar(rel, 4))
            konum = konum + 4
        son
        i = i + 1
    son
    döndür tamponSonuc(sonucKutu, sonucNKutu)
son

# baytListesindenMetin: bayt listesini (0-255) HAM bayt dizisi olan bir
# metne çevirir. Bu ancak elf arka ucunun karakter()/metin-birleştirme
# RUNE değil BAYT bazlı çalışması sayesinde doğru (doğrulandı: karakter(200)
# tek bir 0xC8 baytı üretiyor, 2 baytlık UTF-8 kodlaması değil).
işlev baytListesindenMetin(baytlar)
    s = ""
    her b baytlar içinde
        s = s + karakter(b)
    son
    döndür s
son

# elfUret: kod baytlarını ELF64 başlığı + TEK PT_LOAD program header ile
# sarar. Düzen DerleElf.go ile birebir aynı (elfTaban=0x400000,
# basliklar=64+56=120) — böylece ./tan elf ile ./TancElf çıktıları
# karşılaştırılabilir (fark testi, bkz. Olcum.sh yanına eklenecek karsilastir.sh).
işlev elfUret(kodBaytlari, girisOfsetKodIci)
    elfTaban = 4194304 # 0x400000
    basliklar = 120    # 64 (ELF baslik) + 56 (1 program header)
    kodBoy = uzunluk(kodBaytlari)
    giris = elfTaban + basliklar + girisOfsetKodIci
    toplam = basliklar + kodBoy

    b = []
    b = ekle(b, 127) # 0x7F
    b = ekle(b, 69)  # 'E'
    b = ekle(b, 76)  # 'L'
    b = ekle(b, 70)  # 'F'
    b = ekle(b, 2)   # ELFCLASS64
    b = ekle(b, 1)   # küçük-uçlu (little endian)
    b = ekle(b, 1)   # ELF sürümü
    b = ekle(b, 0)   # System V ABI
    i = 0
    iken i < 8
        b = ekle(b, 0)
        i = i + 1
    son
    b = kodEkleN(b, 2, 2)    # e_type = ET_EXEC
    b = kodEkleN(b, 62, 2)   # e_machine = EM_X86_64 (0x3E)
    b = kodEkleN(b, 1, 4)    # e_version
    b = kodEkleN(b, giris, 8) # e_entry
    b = kodEkleN(b, 64, 8)   # e_phoff
    b = kodEkleN(b, 0, 8)    # e_shoff
    b = kodEkleN(b, 0, 4)    # e_flags
    b = kodEkleN(b, 64, 2)   # e_ehsize
    b = kodEkleN(b, 56, 2)   # e_phentsize
    b = kodEkleN(b, 1, 2)    # e_phnum
    b = kodEkleN(b, 0, 2)    # e_shentsize
    b = kodEkleN(b, 0, 2)    # e_shnum
    b = kodEkleN(b, 0, 2)    # e_shstrndx

    b = kodEkleN(b, 1, 4)          # p_type = PT_LOAD
    b = kodEkleN(b, 7, 4)          # p_flags = R+W+X
    b = kodEkleN(b, 0, 8)          # p_offset
    b = kodEkleN(b, elfTaban, 8)   # p_vaddr
    b = kodEkleN(b, elfTaban, 8)   # p_paddr
    b = kodEkleN(b, toplam, 8)     # p_filesz
    b = kodEkleN(b, toplam, 8)     # p_memsz
    b = kodEkleN(b, 4096, 8)       # p_align

    döndür baytListesiBirlestir(b, kodBaytlari)
son

# yaz_sayı çalışma zamanı: DerleElf.go'daki yardimciYazSayi ile BİREBİR AYNI
# talimat sırası — rdi=sayı alır, ondalık metne çevirip stdout'a write
# syscall'ıyla yazar. Döngü + etiketli dallanma içerir (bagla()'nın asıl
# kanıtı burada: Ldongu geriye atlıyor, rel32 NEGATİF olmalı).
işlev yazSayiBant()
    b = [bcEtiket("yaz_sayi")]
    b = listeBirlestir(b, pushKayit(5))         # push rbp
    b = listeBirlestir(b, movKayit(5, 4))       # mov rbp, rsp
    b = listeBirlestir(b, subImm32(4, 32))      # sub rsp, 32
    b = listeBirlestir(b, movKayit(0, 7))       # mov rax, rdi
    b = listeBirlestir(b, leaRbp(1, 0 - 1))     # lea rcx, [rbp-1]
    b = listeBirlestir(b, movBaytImm(1, 10))    # mov byte [rcx], '\n'
    b = listeBirlestir(b, xorKayit(8, 8))       # xor r8, r8  (işaret bayrağı)
    b = listeBirlestir(b, cmpImm32(0, 0))       # cmp rax, 0
    b = listeBirlestir(b, jccBant(141, "Lpoz")) # jge (0x8D)
    b = listeBirlestir(b, movImm32(8, 1))       # mov r8, 1
    b = listeBirlestir(b, negKayit(0))          # neg rax
    b = ekle(b, bcEtiket("Lpoz"))
    b = listeBirlestir(b, cmpImm32(0, 0))
    b = listeBirlestir(b, jccBant(133, "Ljegit")) # jne (0x85)
    b = listeBirlestir(b, decKayit(1))
    b = listeBirlestir(b, movBaytImm(1, 48))    # '0'
    b = listeBirlestir(b, jmpBant("Lisaret"))
    b = ekle(b, bcEtiket("Ljegit"))
    b = listeBirlestir(b, movImm32(9, 10))      # mov r9, 10
    b = ekle(b, bcEtiket("Ldongu"))
    b = listeBirlestir(b, cmpImm32(0, 0))
    b = listeBirlestir(b, jccBant(132, "Lisaret")) # je (0x84)
    b = listeBirlestir(b, xorKayit(2, 2))       # xor rdx, rdx
    b = listeBirlestir(b, divKayit(9))          # div r9
    b = listeBirlestir(b, addBaytImm(2, 48))    # add dl, '0'
    b = listeBirlestir(b, decKayit(1))
    b = listeBirlestir(b, movBaytKayit(1, 2))   # mov [rcx], dl
    b = listeBirlestir(b, jmpBant("Ldongu"))    # GERİYE atlama — negatif rel32
    b = ekle(b, bcEtiket("Lisaret"))
    b = listeBirlestir(b, cmpImm32(8, 0))
    b = listeBirlestir(b, jccBant(132, "Lyazdir")) # je
    b = listeBirlestir(b, decKayit(1))
    b = listeBirlestir(b, movBaytImm(1, 45))    # '-'
    b = ekle(b, bcEtiket("Lyazdir"))
    b = listeBirlestir(b, movKayit(6, 1))       # mov rsi, rcx
    b = listeBirlestir(b, leaRbp(2, 0))         # lea rdx, [rbp]
    b = listeBirlestir(b, subKayit(2, 1))       # sub rdx, rcx
    b = listeBirlestir(b, movImm32(0, 1))       # mov rax, 1 (sys_write)
    b = listeBirlestir(b, movImm32(7, 1))       # mov rdi, 1 (stdout)
    b = listeBirlestir(b, syscallEmit())
    b = listeBirlestir(b, leaveBant())
    döndür listeBirlestir(b, retBant())
son

# ---------------- YIĞIN AYIRICI (brk tabanlı, libc YOK) ----------------
# Go referansı (DerleElf.go yardimciAyir/yiginIlkle) heap_ptr'ı bir GENEL
# (veri alanı) değişkende tutuyor — TancElf artık AYNI mekanizmayı kullanıyor
# (bkz. leaVeri/movGenelOku/movGenelYaz). ÖNCEKİ SÜRÜM r12/r13'ü register
# olarak ayırmıştı ("kırılgan: ikisi de callee-saved, üretilen bir işlev
# kaydetmeden kullanırsa yığın durumu sessizce bozulur"). Veri alanı
# mekanizması eklenince buraya taşındı, Go arka ucuyla aynı yaklaşım.
#
# SINIR KONTROLÜ (DerleElf.go'da bulunan hatanın aynısı burada da vardı):
# kontrolsüz haliyle
# 64 MB'ı aşan her çıktı programı SESSİZCE segfault veriyordu, ölçek
# bağımlı olduğu için kod üretim hatası gibi görünüyordu. v_yiginSon =
# geçerli yığın sınırı; aşılırsa brk ile 64 MB daha istenir, brk başarısız
# olursa sessizce bozulmak yerine exit(3).
işlev yiginIlkleBant()
    b = movImm32(0, 12)                    # rax = 12 (sys_brk)
    b = listeBirlestir(b, xorKayit(7, 7))  # rdi = 0
    b = listeBirlestir(b, syscallEmit())
    b = listeBirlestir(b, movGenelYaz("v_yigin", 0))   # v_yigin = rax (heap_ptr baslangici)
    b = listeBirlestir(b, movKayit(7, 0))  # rdi = rax
    b = listeBirlestir(b, addImm32(7, 67108864)) # rdi += 64*1024*1024
    b = listeBirlestir(b, pushKayit(7))
    b = listeBirlestir(b, movImm32(0, 12)) # rax = 12 (sys_brk)
    b = listeBirlestir(b, syscallEmit())
    b = listeBirlestir(b, popKayit(7))
    döndür listeBirlestir(b, movGenelYaz("v_yiginSon", 7)) # v_yiginSon = rdi (istenen sinir)
son

# tan_ayir(rdi=bayt) -> rax=işaretçi  (8'e hizalı bump allocator)
işlev tanAyirBant()
    b = [bcEtiket("f_tan_ayir")]
    b = listeBirlestir(b, addImm32(7, 7))     # rdi += 7
    b = listeBirlestir(b, andImm32(7, 0 - 8)) # rdi &= -8 (8'e hizala)
    b = listeBirlestir(b, movGenelOku(0, "v_yigin")) # rax = eski heap_ptr — dönüş değeri
    b = listeBirlestir(b, movKayit(1, 0))     # rcx = rax
    b = listeBirlestir(b, addKayit(1, 7))     # rcx += rdi (yeni bump)

    b = listeBirlestir(b, movGenelOku(2, "v_yiginSon"))
    b = listeBirlestir(b, cmpKayit(1, 2))
    b = listeBirlestir(b, jccBant(134, "Layir_tamam")) # jbe -> sinir icinde, buyutmeye gerek yok

    # --- YIGINI BUYUT: brk(yeni bump + 64 MB) ---
    b = listeBirlestir(b, pushKayit(0))       # eski heap_ptr sakla
    b = listeBirlestir(b, pushKayit(1))       # yeni bump sakla
    b = listeBirlestir(b, movKayit(7, 1))     # rdi = rcx (yeni bump)
    b = listeBirlestir(b, addImm32(7, 67108864)) # rdi += 64 MB (istenen sinir)
    b = listeBirlestir(b, pushKayit(7))
    b = listeBirlestir(b, movImm32(0, 12))    # rax = 12 (sys_brk)
    b = listeBirlestir(b, syscallEmit())
    b = listeBirlestir(b, popKayit(7))
    b = listeBirlestir(b, cmpKayit(0, 7))     # cmp rax(sonuc), rdi(istenen)
    b = listeBirlestir(b, jccBant(130, "Layir_bellekYok")) # jb -> brk basarisiz
    b = listeBirlestir(b, movGenelYaz("v_yiginSon", 7)) # yeni sinir
    b = listeBirlestir(b, popKayit(1))        # yeni bump geri
    b = listeBirlestir(b, popKayit(0))        # eski heap_ptr geri

    b = ekle(b, bcEtiket("Layir_tamam"))
    b = listeBirlestir(b, movGenelYaz("v_yigin", 1)) # yeni bump
    b = listeBirlestir(b, retBant())

    # Bellek bitti: sessizce bozulmak yerine acik cikis kodu.
    b = ekle(b, bcEtiket("Layir_bellekYok"))
    b = listeBirlestir(b, movImm32(0, 60))    # sys_exit
    b = listeBirlestir(b, movImm32(7, 3))     # 3 = bellek yetersiz
    döndür listeBirlestir(b, syscallEmit())
son

# bellek_kopyala(rdi=hedef, rsi=kaynak, rdx=adet) — bayt bayt kopyalar
işlev bellekKopyalaBant()
    b = [bcEtiket("f_bellek_kopyala")]
    b = listeBirlestir(b, testKayit(2, 2))
    b = listeBirlestir(b, jccBant(132, "Lkopya_son"))   # je
    b = ekle(b, bcEtiket("Lkopya_dongu"))
    b = listeBirlestir(b, movBaytOku(6))       # mov al, [rsi]
    b = listeBirlestir(b, movBaytKayit(7, 0))  # mov [rdi], al
    b = listeBirlestir(b, incKayit(6))
    b = listeBirlestir(b, incKayit(7))
    b = listeBirlestir(b, decKayit(2))
    b = listeBirlestir(b, jccBant(133, "Lkopya_dongu")) # jne
    b = ekle(b, bcEtiket("Lkopya_son"))
    döndür listeBirlestir(b, retBant())
son

# liste_ekle(rdi=liste, rsi=öge) -> rax=YENİ liste (kopya, DOKUMANTASYON.md
# semantiği: ekle() asla yerinde değiştirmez). DerleElf.go yardimciListeEkle
# ile birebir aynı adım sırası.
işlev listeEkleBant()
    b = [bcEtiket("f_liste_ekle")]
    b = listeBirlestir(b, pushKayit(5))          # push rbp
    b = listeBirlestir(b, movKayit(5, 4))        # mov rbp, rsp
    b = listeBirlestir(b, subImm32(4, 48))       # sub rsp, 48
    b = listeBirlestir(b, movYerelYaz(0 - 8, 7))   # [-8] = liste
    b = listeBirlestir(b, movYerelYaz(0 - 16, 6))  # [-16] = öge
    b = listeBirlestir(b, movPtrOku(0, 7))         # rax = *rdi (eski uzunluk)
    b = listeBirlestir(b, movYerelYaz(0 - 24, 0))  # [-24] = eski uzunluk
    b = listeBirlestir(b, incKayit(0))
    b = listeBirlestir(b, shlImm(0, 3))            # rax *= 8
    b = listeBirlestir(b, addImm32(0, 8))          # rax += 8 (uzunluk basligi)
    b = listeBirlestir(b, movKayit(7, 0))          # rdi = yeni boy
    b = listeBirlestir(b, callBant("f_tan_ayir"))  # rax = yeni liste
    b = listeBirlestir(b, movYerelYaz(0 - 32, 0))  # [-32] = yeni liste isaretcisi
    b = listeBirlestir(b, movYerelOku(1, 0 - 24))  # rcx = eski uzunluk
    b = listeBirlestir(b, incKayit(1))
    b = listeBirlestir(b, movPtrYaz(0, 1))         # *rax = rcx (yeni uzunluk)
    b = listeBirlestir(b, leaDolayli(7, 0, 8))     # rdi = yeniListe+8
    b = listeBirlestir(b, movYerelOku(6, 0 - 8))   # rsi = eski liste
    b = listeBirlestir(b, leaDolayli(6, 6, 8))     # rsi = eskiListe+8
    b = listeBirlestir(b, movYerelOku(2, 0 - 24))  # rdx = eski uzunluk
    b = listeBirlestir(b, shlImm(2, 3))            # rdx *= 8 (kopyalanacak bayt)
    b = listeBirlestir(b, callBant("f_bellek_kopyala"))
    b = listeBirlestir(b, movYerelOku(0, 0 - 32))  # rax = yeni liste
    b = listeBirlestir(b, movYerelOku(1, 0 - 24))  # rcx = eski uzunluk (= yeni ögenin indeksi)
    b = listeBirlestir(b, leaOge(0, 0, 1))         # rax = &yeniListe[eskiUzunluk]
    b = listeBirlestir(b, movYerelOku(6, 0 - 16))  # rsi = öge değeri
    b = listeBirlestir(b, movPtrYaz(0, 6))         # *rax = rsi
    b = listeBirlestir(b, movYerelOku(0, 0 - 32))  # rax = yeni liste (dönüş)
    b = listeBirlestir(b, leaveBant())
    döndür listeBirlestir(b, retBant())
son

# liste_yap(rdi=n, rsi=başlangıç değeri) -> rax = n öğeli liste, TEK
# SEFERDE ayrılır. ekle() ile n kez büyütmenin O(n²) maliyetini önler —
# Go referansı (f_liste_yap) ile birebir aynı. Bulundu:
# TancElf.tan'ın KENDİSİ ~72 KB kod üretiyor, kod birikimi listeBirlestir/
# ekle ile yapıldığında bu O(n²) desen kendi kendini derlerken WSL'i
# çökertecek kadar bellek istiyordu (bkz. SURUM.md). listeYap, Tampon.tan
# desenindeki (bkz. tamponEkle) büyüyen tamponun temel taşı.
işlev listeYapBant()
    b = [bcEtiket("f_liste_yap")]
    b = listeBirlestir(b, pushKayit(5))
    b = listeBirlestir(b, movKayit(5, 4))
    b = listeBirlestir(b, subImm32(4, 32))
    b = listeBirlestir(b, movYerelYaz(0 - 8, 7))    # [-8] = n
    b = listeBirlestir(b, movYerelYaz(0 - 16, 6))   # [-16] = başlangıç değeri
    b = listeBirlestir(b, movKayit(0, 7))
    b = listeBirlestir(b, shlImm(0, 3))             # rax = n*8
    b = listeBirlestir(b, addImm32(0, 16))
    b = listeBirlestir(b, movKayit(7, 0))
    b = listeBirlestir(b, callBant("f_tan_ayir"))
    b = listeBirlestir(b, movYerelYaz(0 - 24, 0))   # [-24] = yeni liste
    b = listeBirlestir(b, movYerelOku(1, 0 - 8))    # rcx = n
    b = listeBirlestir(b, movPtrYaz(0, 1))          # *liste = n (uzunluk)
    b = listeBirlestir(b, xorKayit(1, 1))           # rcx = 0 (sayaç)
    b = ekle(b, bcEtiket("Lly_dongu"))
    b = listeBirlestir(b, movYerelOku(2, 0 - 8))
    b = listeBirlestir(b, cmpKayit(1, 2))
    b = listeBirlestir(b, jccBant(141, "Lly_bitti")) # jge
    b = listeBirlestir(b, movYerelOku(0, 0 - 24))
    b = listeBirlestir(b, leaOge(0, 0, 1))          # rax = &liste[rcx]
    b = listeBirlestir(b, movYerelOku(6, 0 - 16))
    b = listeBirlestir(b, movPtrYaz(0, 6))          # *rax = başlangıç değeri
    b = listeBirlestir(b, incKayit(1))
    b = listeBirlestir(b, jmpBant("Lly_dongu"))
    b = ekle(b, bcEtiket("Lly_bitti"))
    b = listeBirlestir(b, movYerelOku(0, 0 - 24))   # rax = yeni liste (dönüş)
    b = listeBirlestir(b, leaveBant())
    döndür listeBirlestir(b, retBant())
son

# ---------------- METİN ÇALIŞMA ZAMANI ----------------
# Bellek düzeni DerleElf.go ile BİREBİR aynı: [uzunluk:8][baytlar...].
# ÖNEMLİ (üç hataya sebep olan tuzak — bkz. SURUM.md): metin elf'te BAYT
# dizisidir, RUNE değil. Aşağıdaki hiçbir yerde 128 üstü bayt değerlerine
# üst sınır KONMADI (harfMi'deki gibi). metinVerisiBant kod() ile bayt
# bazlı üretir — ASCII (kod<128) içerik interpreter/native arasında bire
# bir aynı, çok baytlı UTF-8 karakterler DerleElf.go'nun ZATEN belgelenmiş
# kod()/karakter() rune-vs-bayt sınırını miras alır (ÇÖZÜLMEDİ, kapsam
# dışı — Metin1/Metin2 örnekleri ASCII).

# metinVerisiBant: bir metin DEĞERİNİ [uzunluk:8][baytlar...] ham veri
# bandına çevirir (leaVeri ile işaretlenen etiketin ALTINA gömülür).
işlev metinVerisiBant(deger)
    # ÖNCEDEN "deger[i]" (ham indeksleme) — deger PARAMETRE olduğundan tipi
    # "tam" sanılıyordu, aynı metneTamSayi/alan hatası (metinEsit ailesi).
    n = uzunluk(deger)
    b = nBant(n, 8)
    i = 0
    iken i < n
        b = ekle(b, bcBayt(kod(metinAl(deger, i))))
        i = i + 1
    son
    döndür b
son

# sayi_metne(rdi=tam sayı) -> rax=YENİ metin. yazSayiBant'ın basamak
# çıkarma mantığıyla BİREBİR aynı (rbp-göreli tampon, sondan yazma), ama
# stdout'a yazmak yerine yeni bir metin ayırıp baytları oraya kopyalıyor.
# sayiMetneBant: İKİ GEÇİŞLİ. ÖNCEKİ tek geçişli sürüm bir STACK tamponuna
# basamakları yazıp SONRA f_tan_ayir çağırıp f_bellek_kopyala ile HEAP'e
# kopyalıyordu — 8 baytı (bir 64-bit kelime) aşan sayılarda (9+ basamak)
# baştaki basamaklar sessizce bozuluyordu (kanıt: metin(999999999) ->
# ilk basamak NUL, kalan 8 doğru; metin(9999999999)/(99999999999) baştaki
# birkaç bayt bozuk + geri kalan ÇÖP — f_sayi_metne/f_tan_ayir/f_bellek_kopyala
# ayrı ayrı disassemble edilip mantıken doğru bulundu, kesin kök neden
# izole edilemedi ama STACK-tampon+ARA-ÇAĞRI+kopyala deseni her zaman
# tetikleyiciydi — metinBirlestir aynı f_tan_ayir/f_bellek_kopyala ikilisini
# kullanıp HEAP kaynaktan kopyalayınca 9+ baytta SORUNSUZDU). Bu sürüm o
# deseni TAMAMEN ELİYOR: 1. geçiş basamak SAYAR (yazmadan), doğru boyutta
# HEAP ayrılır, 2. geçiş basamakları DOĞRUDAN heap tamponuna yazar — ara
# stack tamponu ve f_bellek_kopyala çağrısı hiç yok.
işlev sayiMetneBant()
    b = [bcEtiket("f_sayi_metne")]
    b = listeBirlestir(b, pushKayit(5))         # push rbp
    b = listeBirlestir(b, movKayit(5, 4))       # mov rbp, rsp
    b = listeBirlestir(b, subImm32(4, 32))      # sub rsp, 32 (3 kalıcı slot: mutlak deger, uzunluk, yeni metin)
    b = listeBirlestir(b, movKayit(0, 7))       # rax = sayı
    b = listeBirlestir(b, xorKayit(8, 8))       # r8 = işaret bayrağı
    b = listeBirlestir(b, cmpImm32(0, 0))
    b = listeBirlestir(b, jccBant(141, "Lm2_poz")) # jge
    b = listeBirlestir(b, movImm32(8, 1))
    b = listeBirlestir(b, negKayit(0))
    b = ekle(b, bcEtiket("Lm2_poz"))
    b = listeBirlestir(b, movYerelYaz(0 - 8, 0))    # [-8] = mutlak değer (2. geçiş için SAKLA)

    # --- GEÇİŞ 1: basamak SAY (yazmadan) ---
    b = listeBirlestir(b, cmpImm32(0, 0))
    b = listeBirlestir(b, jccBant(133, "Lm2_sayNonzero")) # jne
    b = listeBirlestir(b, movImm32(1, 1))           # rcx = 1 (sıfır -> tek basamak)
    b = listeBirlestir(b, jmpBant("Lm2_sayBitti"))
    b = ekle(b, bcEtiket("Lm2_sayNonzero"))
    b = listeBirlestir(b, xorKayit(1, 1))           # rcx = 0
    b = listeBirlestir(b, movImm32(9, 10))          # r9 = 10
    b = ekle(b, bcEtiket("Lm2_sayDongu"))
    b = listeBirlestir(b, cmpImm32(0, 0))
    b = listeBirlestir(b, jccBant(132, "Lm2_sayBitti")) # je
    b = listeBirlestir(b, xorKayit(2, 2))
    b = listeBirlestir(b, divKayit(9))
    b = listeBirlestir(b, incKayit(1))              # rcx++
    b = listeBirlestir(b, jmpBant("Lm2_sayDongu"))
    b = ekle(b, bcEtiket("Lm2_sayBitti"))
    b = listeBirlestir(b, addKayit(1, 8))           # rcx += r8 (işaret varsa +1)
    b = listeBirlestir(b, movYerelYaz(0 - 16, 1))   # [-16] = toplam uzunluk

    # --- AYIR ---
    b = listeBirlestir(b, movKayit(7, 1))           # rdi = toplam uzunluk
    b = listeBirlestir(b, addImm32(7, 8))           # rdi += 8 (başlık)
    b = listeBirlestir(b, callBant("f_tan_ayir"))   # rax = yeni metin
    b = listeBirlestir(b, movYerelYaz(0 - 24, 0))   # [-24] = yeni metin işaretçisi
    b = listeBirlestir(b, movYerelOku(1, 0 - 16))   # rcx = toplam uzunluk
    b = listeBirlestir(b, movPtrYaz(0, 1))          # *yeniMetin = toplam uzunluk

    # --- GEÇİŞ 2: basamakları DOĞRUDAN yeni metne yaz (sondan başa) ---
    b = listeBirlestir(b, movKayit(1, 0))           # rcx = yeni metin
    b = listeBirlestir(b, addImm32(1, 8))           # rcx += 8 (veri başlangıcı)
    b = listeBirlestir(b, movYerelOku(2, 0 - 16))   # rdx = toplam uzunluk
    b = listeBirlestir(b, addKayit(1, 2))           # rcx += toplam uzunluk (yazma ucu = veri SONU)
    b = listeBirlestir(b, movYerelOku(0, 0 - 8))    # rax = mutlak değer (GERİ YÜKLE)
    b = listeBirlestir(b, cmpImm32(0, 0))
    b = listeBirlestir(b, jccBant(133, "Lm2_yazNonzero")) # jne
    b = listeBirlestir(b, decKayit(1))
    b = listeBirlestir(b, movBaytImm(1, 48))        # '0'
    b = listeBirlestir(b, jmpBant("Lm2_isaretYaz"))
    b = ekle(b, bcEtiket("Lm2_yazNonzero"))
    b = listeBirlestir(b, movImm32(9, 10))
    b = ekle(b, bcEtiket("Lm2_yazDongu"))
    b = listeBirlestir(b, cmpImm32(0, 0))
    b = listeBirlestir(b, jccBant(132, "Lm2_isaretYaz")) # je
    b = listeBirlestir(b, xorKayit(2, 2))
    b = listeBirlestir(b, divKayit(9))
    b = listeBirlestir(b, addBaytImm(2, 48))
    b = listeBirlestir(b, decKayit(1))
    b = listeBirlestir(b, movBaytKayit(1, 2))
    b = listeBirlestir(b, jmpBant("Lm2_yazDongu"))
    b = ekle(b, bcEtiket("Lm2_isaretYaz"))
    b = listeBirlestir(b, cmpImm32(8, 0))
    b = listeBirlestir(b, jccBant(132, "Lm2_tamam")) # je
    b = listeBirlestir(b, decKayit(1))
    b = listeBirlestir(b, movBaytImm(1, 45))        # '-'
    b = ekle(b, bcEtiket("Lm2_tamam"))
    b = listeBirlestir(b, movYerelOku(0, 0 - 24))   # rax = yeni metin (dönüş)
    b = listeBirlestir(b, leaveBant())
    döndür listeBirlestir(b, retBant())
son

# metin_birlestir(rdi=metinA, rsi=metinB) -> rax=YENİ metin (A+B baytları).
# f_bellek_kopyala rdi/rsi'yi KENDİ İÇİNDE ilerlettiği için (incKayit her
# baytta) B'nin kopyalanacağı nokta A'dan SONRA otomatik doğru yerde —
# aradan ayrı bir toplama gerekmiyor.
işlev metinBirlestirBant()
    b = [bcEtiket("f_metin_birlestir")]
    b = listeBirlestir(b, pushKayit(5))
    b = listeBirlestir(b, movKayit(5, 4))
    b = listeBirlestir(b, subImm32(4, 48))
    b = listeBirlestir(b, movYerelYaz(0 - 8, 7))    # [-8] = metinA
    b = listeBirlestir(b, movYerelYaz(0 - 16, 6))   # [-16] = metinB
    b = listeBirlestir(b, movPtrOku(0, 7))          # rax = uzunlukA
    b = listeBirlestir(b, movYerelYaz(0 - 24, 0))   # [-24] = uzunlukA
    b = listeBirlestir(b, movPtrOku(1, 6))          # rcx = uzunlukB
    b = listeBirlestir(b, movYerelYaz(0 - 32, 1))   # [-32] = uzunlukB
    b = listeBirlestir(b, addKayit(0, 1))           # rax = uzunlukA+uzunlukB
    b = listeBirlestir(b, movYerelYaz(0 - 40, 0))   # [-40] = toplam uzunluk
    b = listeBirlestir(b, addImm32(0, 8))
    b = listeBirlestir(b, movKayit(7, 0))
    b = listeBirlestir(b, callBant("f_tan_ayir"))   # rax = yeni metin
    b = listeBirlestir(b, movYerelYaz(0 - 48, 0))   # [-48] = yeni metin işaretçisi (KALICI)
    b = listeBirlestir(b, movYerelOku(1, 0 - 40))   # rcx = toplam uzunluk
    b = listeBirlestir(b, movPtrYaz(0, 1))          # *yeniMetin = toplam uzunluk

    b = listeBirlestir(b, leaDolayli(7, 0, 8))      # rdi = yeniMetin+8
    b = listeBirlestir(b, movYerelOku(6, 0 - 8))    # rsi = A
    b = listeBirlestir(b, leaDolayli(6, 6, 8))      # rsi = A+8
    b = listeBirlestir(b, movYerelOku(2, 0 - 24))   # rdx = uzunlukA
    b = listeBirlestir(b, callBant("f_bellek_kopyala"))
    # rdi/rsi artik A'dan sonraki dogru konumda (bellek_kopyala kendi ilerletti)

    b = listeBirlestir(b, movYerelOku(6, 0 - 16))   # rsi = B
    b = listeBirlestir(b, leaDolayli(6, 6, 8))      # rsi = B+8
    b = listeBirlestir(b, movYerelOku(2, 0 - 32))   # rdx = uzunlukB
    b = listeBirlestir(b, callBant("f_bellek_kopyala"))

    b = listeBirlestir(b, movYerelOku(0, 0 - 48))   # rax = yeni metin (dönüş)
    b = listeBirlestir(b, leaveBant())
    döndür listeBirlestir(b, retBant())
son

# metin_esit(rdi=metinA, rsi=metinB) -> rax=1 (aynı içerik) / 0 (farklı).
# BAYT BAZLI karşılaştırma — ham gösterici DEĞİL (DerleElf.go'da bulunan
# "metin==metin pointer karşılaştırıyordu" hatasının aynısına düşme).
işlev metinEsitBant()
    b = [bcEtiket("f_metin_esit")]
    b = listeBirlestir(b, movPtrOku(8, 7))      # r8 = uzunlukA (SAYAÇ)
    b = listeBirlestir(b, movPtrOku(1, 6))      # rcx = uzunlukB
    b = listeBirlestir(b, cmpKayit(8, 1))
    b = listeBirlestir(b, jccBant(133, "Lesit_farkli")) # jne
    b = listeBirlestir(b, leaDolayli(7, 7, 8))  # rdi = A+8
    b = listeBirlestir(b, leaDolayli(6, 6, 8))  # rsi = B+8
    b = ekle(b, bcEtiket("Lesit_dongu"))
    b = listeBirlestir(b, testKayit(8, 8))
    b = listeBirlestir(b, jccBant(132, "Lesit_ayni")) # je -> r8==0, hepsi eşit
    b = listeBirlestir(b, movBaytOku(7))        # al = [rdi] (A'nın baytı)
    b = listeBirlestir(b, movzxAlBant())        # rax = zero-extend(al)
    b = listeBirlestir(b, pushKayit(0))
    b = listeBirlestir(b, movBaytOku(6))        # al = [rsi] (B'nin baytı)
    b = listeBirlestir(b, movzxAlBant())
    b = listeBirlestir(b, popKayit(1))          # rcx = A'nın baytı
    b = listeBirlestir(b, cmpKayit(0, 1))       # cmp rax(B), rcx(A)
    b = listeBirlestir(b, jccBant(133, "Lesit_farkli")) # jne
    b = listeBirlestir(b, incKayit(7))
    b = listeBirlestir(b, incKayit(6))
    b = listeBirlestir(b, decKayit(8))
    b = listeBirlestir(b, jmpBant("Lesit_dongu"))
    b = ekle(b, bcEtiket("Lesit_ayni"))
    b = listeBirlestir(b, movImm32(0, 1))
    b = listeBirlestir(b, retBant())
    b = ekle(b, bcEtiket("Lesit_farkli"))
    b = listeBirlestir(b, movImm32(0, 0))
    döndür listeBirlestir(b, retBant())
son

# metin_indeks(rdi=metin, rsi=indeks) -> rax=YENİ tek-baytlık metin
işlev metinIndeksBant()
    b = [bcEtiket("f_metin_indeks")]
    b = listeBirlestir(b, pushKayit(5))
    b = listeBirlestir(b, movKayit(5, 4))
    b = listeBirlestir(b, subImm32(4, 16))
    b = listeBirlestir(b, leaDolayli(0, 7, 8))      # rax = metin+8
    b = listeBirlestir(b, addKayit(0, 6))           # rax += indeks
    b = listeBirlestir(b, movBaytOku(0))            # al = *rax (istenen bayt)
    b = listeBirlestir(b, movzxAlBant())
    b = listeBirlestir(b, movYerelYaz(0 - 16, 0))   # [-16] = bayt değeri
    b = listeBirlestir(b, movImm32(7, 9))           # rdi = 9 (8 başlık + 1 bayt)
    b = listeBirlestir(b, callBant("f_tan_ayir"))
    b = listeBirlestir(b, movImm32(1, 1))
    b = listeBirlestir(b, movPtrYaz(0, 1))          # uzunluk = 1
    b = listeBirlestir(b, movYerelOku(1, 0 - 16))   # rcx = bayt değeri
    b = listeBirlestir(b, leaDolayli(2, 0, 8))      # rdx = yeniMetin+8
    b = listeBirlestir(b, movBaytKayit(2, 1))       # [rdx] = cl
    b = listeBirlestir(b, leaveBant())
    döndür listeBirlestir(b, retBant())
son

# kod(rdi=metin) -> rax = ilk baytın kodu (BAYT bazlı, bkz. bölüm başlığı)
işlev kodBant()
    b = [bcEtiket("f_kod")]
    b = listeBirlestir(b, leaDolayli(0, 7, 8))  # rax = metin+8
    b = listeBirlestir(b, movBaytOku(0))        # al = *rax
    b = listeBirlestir(b, movzxAlBant())
    döndür listeBirlestir(b, retBant())
son

# karakter(rdi=kod) -> rax = YENİ tek-baytlık metin
işlev karakterBant()
    b = [bcEtiket("f_karakter")]
    b = listeBirlestir(b, pushKayit(5))
    b = listeBirlestir(b, movKayit(5, 4))
    b = listeBirlestir(b, subImm32(4, 16))
    b = listeBirlestir(b, movYerelYaz(0 - 8, 7))    # [-8] = kod değeri
    b = listeBirlestir(b, movImm32(7, 9))
    b = listeBirlestir(b, callBant("f_tan_ayir"))
    b = listeBirlestir(b, movImm32(1, 1))
    b = listeBirlestir(b, movPtrYaz(0, 1))
    b = listeBirlestir(b, movYerelOku(1, 0 - 8))    # rcx = kod değeri
    b = listeBirlestir(b, leaDolayli(2, 0, 8))
    b = listeBirlestir(b, movBaytKayit(2, 1))
    b = listeBirlestir(b, leaveBant())
    döndür listeBirlestir(b, retBant())
son

# yaz_metin(rdi=metin) — ham baytları + yeni satırı stdout'a yazar. rsp/rbp
# gibi SIB-özel register'lar movBaytImm'e taban olarak GEÇİRİLMEZ (rax
# kullanılıyor) — bkz. Bölüm 4 "LİSTE/YIĞIN için genel dolaylı erişim" notu.
işlev yazMetinBant()
    b = [bcEtiket("f_yaz_metin")]
    b = listeBirlestir(b, pushKayit(5))
    b = listeBirlestir(b, movKayit(5, 4))
    b = listeBirlestir(b, subImm32(4, 16))
    b = listeBirlestir(b, movPtrOku(2, 7))          # rdx = uzunluk
    b = listeBirlestir(b, leaDolayli(6, 7, 8))      # rsi = metin+8
    b = listeBirlestir(b, movImm32(0, 1))           # rax = 1 (sys_write)
    b = listeBirlestir(b, movImm32(7, 1))           # rdi = 1 (stdout)
    b = listeBirlestir(b, syscallEmit())
    b = listeBirlestir(b, leaRbp(0, 0 - 16))        # rax = &[rbp-16] (yeni satır tamponu)
    b = listeBirlestir(b, movBaytImm(0, 10))        # [rax] = '\n'
    b = listeBirlestir(b, movKayit(6, 0))           # rsi = &yeni satır
    b = listeBirlestir(b, movImm32(2, 1))           # rdx = 1
    b = listeBirlestir(b, movImm32(0, 1))
    b = listeBirlestir(b, movImm32(7, 1))
    b = listeBirlestir(b, syscallEmit())
    b = listeBirlestir(b, leaveBant())
    döndür listeBirlestir(b, retBant())
son

# ---------------- FAZ 6: KESİR (ONDALIK) RUNTIME YARDIMCILARI ----------------
# f_kesir_metne(rdi = double bit deseni) -> rax = YENİ metin.
# DerleElf.go yardimciKesirMetne (5081-5213) ile BİREBİR port: 6 ondalık
# basamak, sondaki sıfırlar kırpılır, tam kısım 0 ise "0" yazılır, kesirli
# kısım 0 ise noktasız tam sayı yazılır. Yazma rbp-tamponundan GERİYE
# (rbp-40..rbp-1) yapılır; çıktı HEAP'e metin olarak kopyalanır.
# Yuvarlama: kesirli kısım *1e6 + 0.5 ile kesilir; 1000000 taşarsa tam kısım
# 1 artırılır (0.9999995+ kenarı — "log(e)" gibi değerlerde 6 basamağa
# sığmayan 1000000 üretiyordu). İşaret biti rbp-56'da saklanır (Go -9223...=
# maskesiyle; TancElf aynı maskeyi -1'u 63 kez kaydırıp üretiyor).
işlev kesirMetneBant()
    b = [bcEtiket("f_kesir_metne")]
    b = listeBirlestir(b, pushKayit(5))
    b = listeBirlestir(b, movKayit(5, 4))
    b = listeBirlestir(b, subImm32(4, 160))
    b = listeBirlestir(b, movYerelYaz(0 - 48, 7))   # [-48] = giriş bitleri
    # isaret biti: rcx = 0x8000000000000000
    b = listeBirlestir(b, movKayit(0, 7))
    b = listeBirlestir(b, movImm32(1, 0 - 1))
    b = listeBirlestir(b, shlImm(1, 63))
    b = listeBirlestir(b, andKayit(0, 1))
    b = listeBirlestir(b, movYerelYaz(0 - 56, 0))   # [-56] = işaret (0 veya 0x8000...)
    # mutlak değer: rcx = 0x7FFFFFFFFFFFFFFF (9223372036854775807)
    b = listeBirlestir(b, movKayit(0, 7))
    b = listeBirlestir(b, movImm64(1, 9223372036854775807))
    b = listeBirlestir(b, andKayit(0, 1))
    b = listeBirlestir(b, movqXmmKayit(0, 0))       # xmm0 = mutlak değer
    # tam kısım
    b = listeBirlestir(b, cvtKesirTam(1, 0))        # rcx = tam kısım
    b = listeBirlestir(b, movYerelYaz(0 - 64, 1))   # [-64] = tam kısım
    b = listeBirlestir(b, cvtTamKesir(1, 1))        # xmm1 = tam kısım (double)
    b = listeBirlestir(b, sseIkili(92, 0, 1))       # subsd xmm0, xmm1 -> kesirli kısım
    # *1e6 (0x412E848000000000)
    b = listeBirlestir(b, movImm64(0, 4696837146684686336))
    b = listeBirlestir(b, movqXmmKayit(2, 0))
    b = listeBirlestir(b, sseIkili(89, 0, 2))       # mulsd xmm0, xmm2
    # +0.5 (0x3FE0000000000000) — yuvarlama
    b = listeBirlestir(b, movImm64(0, 4602678819172646912))
    b = listeBirlestir(b, movqXmmKayit(2, 0))
    b = listeBirlestir(b, sseIkili(88, 0, 2))       # addsd xmm0, xmm2
    b = listeBirlestir(b, cvtKesirTam(2, 0))        # rdx = kesir*1e6+0.5 (kes)
    b = listeBirlestir(b, movYerelYaz(0 - 72, 2))   # [-72] = kesir basamakları

    # --- YUVARLAMA TAŞMASI ---
    b = listeBirlestir(b, cmpImm32(2, 1000000))
    b = listeBirlestir(b, jccBant(133, "Lkm_tasmayok")) # jne
    b = listeBirlestir(b, movYerelOku(0, 0 - 64))
    b = listeBirlestir(b, incKayit(0))
    b = listeBirlestir(b, movYerelYaz(0 - 64, 0))
    b = listeBirlestir(b, movImm32(2, 0))
    b = listeBirlestir(b, movYerelYaz(0 - 72, 2))
    b = ekle(b, bcEtiket("Lkm_tasmayok"))

    # --- SONDAKİ SIFIRLARI KIRP (r10 kaç basamak kalacağını sayar) ---
    b = listeBirlestir(b, movImm32(10, 6))
    b = listeBirlestir(b, movYerelOku(0, 0 - 72))
    b = ekle(b, bcEtiket("Lkm_trim"))
    b = listeBirlestir(b, cmpImm32(10, 1))
    b = listeBirlestir(b, jccBant(142, "Lkm_fdone")) # jle
    b = listeBirlestir(b, movImm32(9, 10))
    b = listeBirlestir(b, xorKayit(2, 2))
    b = listeBirlestir(b, divKayit(9))
    b = listeBirlestir(b, testKayit(2, 2))
    b = listeBirlestir(b, jccBant(133, "Lkm_undo"))  # jnz
    b = listeBirlestir(b, decKayit(10))
    b = listeBirlestir(b, jmpBant("Lkm_trim"))
    b = ekle(b, bcEtiket("Lkm_undo"))
    b = listeBirlestir(b, movImm32(9, 10))
    b = listeBirlestir(b, imulKayit(0, 9))
    b = listeBirlestir(b, addKayit(0, 2))
    b = ekle(b, bcEtiket("Lkm_fdone"))

    # --- basamakları rbp-tamponuna GERİYE doğru yaz ---
    b = listeBirlestir(b, leaRbp(1, 0))             # rcx = rbp (tampon SONU)
    b = listeBirlestir(b, testKayit(0, 0))          # kesirli kısım 0 mı?
    b = listeBirlestir(b, jccBant(132, "Lkm_tamsayi")) # jz -> "4" yaz, "4.0" değil
    b = listeBirlestir(b, movKayit(11, 10))         # r11 = kalan basamak sayısı
    b = ekle(b, bcEtiket("Lkm_fd"))
    b = listeBirlestir(b, testKayit(11, 11))
    b = listeBirlestir(b, jccBant(132, "Lkm_dot"))  # jz
    b = listeBirlestir(b, movImm32(9, 10))
    b = listeBirlestir(b, xorKayit(2, 2))
    b = listeBirlestir(b, divKayit(9))
    b = listeBirlestir(b, addBaytImm(2, 48))        # dl += '0'
    b = listeBirlestir(b, decKayit(1))
    b = listeBirlestir(b, movBaytKayit(1, 2))       # [rcx] = dl
    b = listeBirlestir(b, decKayit(11))
    b = listeBirlestir(b, jmpBant("Lkm_fd"))
    b = ekle(b, bcEtiket("Lkm_dot"))
    b = listeBirlestir(b, decKayit(1))
    b = listeBirlestir(b, movBaytImm(1, 46))        # [rcx] = '.'
    b = ekle(b, bcEtiket("Lkm_tamsayi"))
    # tam kısım
    b = listeBirlestir(b, movYerelOku(0, 0 - 64))
    b = listeBirlestir(b, testKayit(0, 0))
    b = listeBirlestir(b, jccBant(133, "Lkm_id"))   # jnz
    b = listeBirlestir(b, decKayit(1))
    b = listeBirlestir(b, movBaytImm(1, 48))        # '0'
    b = listeBirlestir(b, jmpBant("Lkm_sign"))
    b = ekle(b, bcEtiket("Lkm_id"))
    b = ekle(b, bcEtiket("Lkm_idl"))
    b = listeBirlestir(b, testKayit(0, 0))
    b = listeBirlestir(b, jccBant(132, "Lkm_sign")) # jz
    b = listeBirlestir(b, movImm32(9, 10))
    b = listeBirlestir(b, xorKayit(2, 2))
    b = listeBirlestir(b, divKayit(9))
    b = listeBirlestir(b, addBaytImm(2, 48))
    b = listeBirlestir(b, decKayit(1))
    b = listeBirlestir(b, movBaytKayit(1, 2))
    b = listeBirlestir(b, jmpBant("Lkm_idl"))
    b = ekle(b, bcEtiket("Lkm_sign"))
    # işaret
    b = listeBirlestir(b, movYerelOku(9, 0 - 56))
    b = listeBirlestir(b, cmpImm32(9, 0))
    b = listeBirlestir(b, jccBant(132, "Lkm_fin"))  # je
    b = listeBirlestir(b, decKayit(1))
    b = listeBirlestir(b, movBaytImm(1, 45))        # '-'
    b = ekle(b, bcEtiket("Lkm_fin"))
    # uzunluk = rbp - rcx; yeni metin ayır, kopyala
    b = listeBirlestir(b, movKayit(2, 5))           # rdx = rbp
    b = listeBirlestir(b, subKayit(2, 1))           # rdx = rbp - rcx (uzunluk)
    b = listeBirlestir(b, movYerelYaz(0 - 80, 1))   # [-80] = veri başlangıcı (rcx)
    b = listeBirlestir(b, movYerelYaz(0 - 88, 2))   # [-88] = uzunluk
    b = listeBirlestir(b, movKayit(7, 2))           # rdi = uzunluk
    b = listeBirlestir(b, addImm32(7, 16))          # rdi += 16 (başlık + pay)
    b = listeBirlestir(b, callBant("f_tan_ayir"))
    b = listeBirlestir(b, movYerelYaz(0 - 96, 0))   # [-96] = yeni metin
    b = listeBirlestir(b, movYerelOku(1, 0 - 88))   # rcx = uzunluk
    b = listeBirlestir(b, movPtrYaz(0, 1))          # *yeniMetin = uzunluk
    b = listeBirlestir(b, leaDolayli(7, 0, 8))      # rdi = yeniMetin+8
    b = listeBirlestir(b, movYerelOku(6, 0 - 80))   # rsi = veri başlangıcı
    b = listeBirlestir(b, movYerelOku(2, 0 - 88))   # rdx = uzunluk
    b = listeBirlestir(b, callBant("f_bellek_kopyala"))
    b = listeBirlestir(b, movYerelOku(0, 0 - 96))   # rax = yeni metin
    b = listeBirlestir(b, leaveBant())
    döndür listeBirlestir(b, retBant())
son

# yaz_kesir(rdi = double bit deseni) — Go yardimciYazKesir (5216-5223) portu.
# Çerçevesiz: f_kesir_metne -> rdi=metin -> f_yaz_metin.
işlev yazKesirBant()
    b = [bcEtiket("f_yaz_kesir")]
    b = listeBirlestir(b, callBant("f_kesir_metne"))
    b = listeBirlestir(b, movKayit(7, 0))
    b = listeBirlestir(b, callBant("f_yaz_metin"))
    döndür listeBirlestir(b, retBant())
son

# hata_sifira_bolme: "/" veya "%" operasyonunda sıfır bölen görülünce
# (jz hedefi). Mesajı INLINE gömer (METIN dalı deseni), stderr'e yazar,
# exit(4) yapar — SIGFPE'nin opak 136'sı yerine kontrollü çıkış (Go
# yardimciHataSifiraBolme 2895-2904; Go veri bölümüne gömüyor, TancElf
# kod içine gömüyor).
işlev hataSifiraBolmeBant()
    b = [bcEtiket("f_hata_sifira_bolme")]
    b = listeBirlestir(b, jmpBant("Lsifir_atla"))
    b = ekle(b, bcEtiket("Lsifir_veri"))
    b = listeBirlestir(b, metinVerisiBant("HATA: sıfıra bölme\n"))
    b = ekle(b, bcEtiket("Lsifir_atla"))
    b = listeBirlestir(b, leaVeri(6, "Lsifir_veri")) # rsi = &veri
    b = listeBirlestir(b, addImm32(6, 8))            # rsi += 8 (uzunluk başlığını atla)
    b = listeBirlestir(b, movImm32(7, 2))            # rdi = 2 (stderr)
    b = listeBirlestir(b, movImm32(2, 22))           # rdx = 22 (bayt uzunluğu)
    b = listeBirlestir(b, movImm32(0, 1))            # rax = 1 (sys_write)
    b = listeBirlestir(b, syscallEmit())
    b = listeBirlestir(b, movImm32(7, 4))            # rdi = 4 (çıkış kodu)
    b = listeBirlestir(b, movImm32(0, 60))           # rax = 60 (sys_exit)
    döndür listeBirlestir(b, syscallEmit())
son


# ---------------- DOSYA G/Ç (ham syscall, libc YOK) ----------------
# DerleElf.go yardimciOku/yardimciYazBaytlar ile AYNI yaklaşım. Yol metnini
# NULL-SONLANDIRILMIŞ C-string'e çevirmek gerekiyor (open() syscall'ı
# bekliyor) ama Tan metinleri [uzunluk:8][baytlar] — sonlandırıcı YOK.
# Çözüm: gereken boydan 16 BAYT FAZLA ayır, sadece yol baytlarını kopyala.
# Fazla baytlar YAZILMADAN kalır — brk() ile büyütülen YENİ (hiç
# dokunulmamış) bellek çekirdek tarafından SIFIRLANMIŞ gelir (Linux anonim
# bellek garantisi), bump ayırıcı asla eski alanı YENİDEN kullanmadığı için
# (çöp toplayıcı yok) bu sıfırlar hep tazedir — ekstra bir sıfırlama kodu
# yazmaya gerek yok. Genel CAGRI dispatch "f_"+ad çağırdığı için isimler
# BİREBİR eşleşiyor: oku()->f_oku, yazBaytlar()->f_yazBaytlar (Go'nun
# f_yaz_baytlar'ından FARKLI — TancElf kendi adlandırmasını kullanıyor,
# özel bir CAGRI dalı gerekmiyor).

# oku(rdi=yol metni) -> rax=YENİ metin (dosya içeriği)
işlev okuBant()
    b = [bcEtiket("f_oku")]
    b = listeBirlestir(b, pushKayit(5))
    b = listeBirlestir(b, movKayit(5, 4))
    b = listeBirlestir(b, subImm32(4, 48))
    b = listeBirlestir(b, movYerelYaz(0 - 8, 7))     # [-8] = yol metni
    b = listeBirlestir(b, movPtrOku(0, 7))           # rax = yol uzunluğu
    b = listeBirlestir(b, movYerelYaz(0 - 16, 0))    # [-16] = yol uzunluğu
    b = listeBirlestir(b, movKayit(7, 0))
    b = listeBirlestir(b, addImm32(7, 16))
    b = listeBirlestir(b, callBant("f_tan_ayir"))    # rax = C-string tamponu
    b = listeBirlestir(b, movYerelYaz(0 - 24, 0))    # [-24] = C-string tamponu
    b = listeBirlestir(b, movKayit(7, 0))
    b = listeBirlestir(b, movYerelOku(6, 0 - 8))
    b = listeBirlestir(b, leaDolayli(6, 6, 8))       # rsi = yol+8 (baytlar)
    b = listeBirlestir(b, movYerelOku(2, 0 - 16))
    b = listeBirlestir(b, callBant("f_bellek_kopyala"))
    # open(yol, O_RDONLY=0, 0)
    b = listeBirlestir(b, movYerelOku(7, 0 - 24))
    b = listeBirlestir(b, xorKayit(6, 6))
    b = listeBirlestir(b, xorKayit(2, 2))
    b = listeBirlestir(b, movImm32(0, 2))            # sys_open
    b = listeBirlestir(b, syscallEmit())
    b = listeBirlestir(b, movYerelYaz(0 - 32, 0))    # [-32] = fd
    # arabellek ayır (16 MB)
    b = listeBirlestir(b, movImm32(7, 16777216))
    b = listeBirlestir(b, callBant("f_tan_ayir"))
    b = listeBirlestir(b, movYerelYaz(0 - 40, 0))    # [-40] = metin tamponu
    # read(fd, buf+8, 16MB-16)
    b = listeBirlestir(b, movYerelOku(7, 0 - 32))
    b = listeBirlestir(b, movYerelOku(6, 0 - 40))
    b = listeBirlestir(b, leaDolayli(6, 6, 8))
    b = listeBirlestir(b, movImm32(2, 16777200))
    b = listeBirlestir(b, xorKayit(0, 0))            # sys_read = 0
    b = listeBirlestir(b, syscallEmit())
    # uzunluğu yaz (okunan bayt sayısı rax'ta)
    b = listeBirlestir(b, movYerelOku(1, 0 - 40))
    b = listeBirlestir(b, movPtrYaz(1, 0))
    # close(fd)
    b = listeBirlestir(b, movYerelOku(7, 0 - 32))
    b = listeBirlestir(b, movImm32(0, 3))
    b = listeBirlestir(b, syscallEmit())
    b = listeBirlestir(b, movYerelOku(0, 0 - 40))
    b = listeBirlestir(b, leaveBant())
    döndür listeBirlestir(b, retBant())
son

# dosyaVarMi(rdi=yol metni) -> rax=1/0 — oku() ÖNCESİ varlık kontrolü için
# (oku() eksik dosyada hata denetimi yapmadan çöp uzunluk üretir). Mantık
# DerleElf.go'nun f_dosya_var_mi'siyle BİREBİR aynı (open+close syscall,
# fd negatifse yok) ama ETİKET ADI FARKLI: bu, TancElf'in KENDİ genel CAGRI
# dispatch'i "f_"+ad ürettiği için "f_dosyaVarMi" (alt çizgisiz) — Go'nun
# "f_dosya_var_mi" etiketiyle karıştırılmamalı, iki bağımsız derleyicinin
# kendi iç adları, davranış aynı olması yeterli. içe al'ın kendi kendini
# derlerken (gen1→gen2) modül dosyasının var olup olmadığını sınamak için
# kullanılıyor (bkz. tokenGenislet/iceAlYoluCoz, SÜRÜCÜ bölümünden önce).
işlev dosyaVarMiBant()
    b = [bcEtiket("f_dosyaVarMi")]
    b = listeBirlestir(b, pushKayit(5))
    b = listeBirlestir(b, movKayit(5, 4))
    b = listeBirlestir(b, subImm32(4, 32))
    b = listeBirlestir(b, movYerelYaz(0 - 8, 7))     # [-8] = yol metni
    b = listeBirlestir(b, movPtrOku(0, 7))           # rax = yol uzunluğu
    b = listeBirlestir(b, movYerelYaz(0 - 16, 0))    # [-16] = uzunluk
    b = listeBirlestir(b, movKayit(7, 0))
    b = listeBirlestir(b, addImm32(7, 16))
    b = listeBirlestir(b, callBant("f_tan_ayir"))    # rax = C-string tamponu (sıfırlanmış)
    b = listeBirlestir(b, movYerelYaz(0 - 24, 0))    # [-24] = C-string tamponu
    b = listeBirlestir(b, movKayit(7, 0))
    b = listeBirlestir(b, movYerelOku(6, 0 - 8))
    b = listeBirlestir(b, leaDolayli(6, 6, 8))       # rsi = yol+8 (baytlar)
    b = listeBirlestir(b, movYerelOku(2, 0 - 16))    # rdx = uzunluk
    b = listeBirlestir(b, callBant("f_bellek_kopyala"))
    b = listeBirlestir(b, movYerelOku(7, 0 - 24))    # rdi = C-string tamponu
    b = listeBirlestir(b, xorKayit(6, 6))            # rsi = 0 (O_RDONLY)
    b = listeBirlestir(b, xorKayit(2, 2))            # rdx = 0
    b = listeBirlestir(b, movImm32(0, 2))            # sys_open
    b = listeBirlestir(b, syscallEmit())
    b = listeBirlestir(b, movYerelYaz(0 - 32, 0))    # [-32] = fd (negatifse hata)
    b = listeBirlestir(b, cmpImm32(0, 0))
    b = listeBirlestir(b, jccBant(140, "Ldvm_yok"))  # jl
    b = listeBirlestir(b, movYerelOku(7, 0 - 32))
    b = listeBirlestir(b, movImm32(0, 3))            # sys_close
    b = listeBirlestir(b, syscallEmit())
    b = listeBirlestir(b, movImm32(0, 1))
    b = listeBirlestir(b, leaveBant())
    b = listeBirlestir(b, retBant())
    b = listeBirlestir(b, [bcEtiket("Ldvm_yok")])
    b = listeBirlestir(b, movImm32(0, 0))
    b = listeBirlestir(b, leaveBant())
    döndür listeBirlestir(b, retBant())
son

# yazBaytlar(rdi=yol metni, rsi=liste) -> rax=0. Listenin her ögesinin
# DÜŞÜK BAYTINI ham yazar — UTF-8 kodlaması YAPILMAZ (yazDosya'dan farkı).
işlev yazBaytlarBant()
    b = [bcEtiket("f_yazBaytlar")]
    b = listeBirlestir(b, pushKayit(5))
    b = listeBirlestir(b, movKayit(5, 4))
    b = listeBirlestir(b, subImm32(4, 64))
    b = listeBirlestir(b, movYerelYaz(0 - 8, 7))    # [-8] = yol
    b = listeBirlestir(b, movYerelYaz(0 - 16, 6))   # [-16] = liste
    # yolu C-metnine çevir
    b = listeBirlestir(b, movPtrOku(0, 7))
    b = listeBirlestir(b, movYerelYaz(0 - 24, 0))   # [-24] = yol uzunluğu
    b = listeBirlestir(b, movKayit(7, 0))
    b = listeBirlestir(b, addImm32(7, 16))
    b = listeBirlestir(b, callBant("f_tan_ayir"))
    b = listeBirlestir(b, movYerelYaz(0 - 32, 0))   # [-32] = C-string tamponu
    b = listeBirlestir(b, movKayit(7, 0))
    b = listeBirlestir(b, movYerelOku(6, 0 - 8))
    b = listeBirlestir(b, leaDolayli(6, 6, 8))
    b = listeBirlestir(b, movYerelOku(2, 0 - 24))
    b = listeBirlestir(b, callBant("f_bellek_kopyala"))
    # liste ögelerini bayt tamponuna sıkıştır
    b = listeBirlestir(b, movYerelOku(6, 0 - 16))
    b = listeBirlestir(b, movPtrOku(0, 6))
    b = listeBirlestir(b, movYerelYaz(0 - 40, 0))   # [-40] = liste uzunluğu
    b = listeBirlestir(b, movKayit(7, 0))
    b = listeBirlestir(b, addImm32(7, 16))
    b = listeBirlestir(b, callBant("f_tan_ayir"))
    b = listeBirlestir(b, movYerelYaz(0 - 48, 0))   # [-48] = bayt tamponu
    b = listeBirlestir(b, xorKayit(1, 1))           # rcx = 0 (sayaç)
    b = ekle(b, bcEtiket("Lyb_dongu"))
    b = listeBirlestir(b, movYerelOku(2, 0 - 40))
    b = listeBirlestir(b, cmpKayit(1, 2))
    b = listeBirlestir(b, jccBant(141, "Lyb_bitti")) # jge
    b = listeBirlestir(b, movYerelOku(6, 0 - 16))
    b = listeBirlestir(b, leaOge(6, 6, 1))          # rsi = &liste[rcx]
    b = listeBirlestir(b, movPtrOku(2, 6))          # rdx = liste ögesi
    b = listeBirlestir(b, movYerelOku(7, 0 - 48))
    b = listeBirlestir(b, addKayit(7, 1))           # rdi = tampon+rcx
    b = listeBirlestir(b, movBaytKayit(7, 2))       # [rdi] = dl
    b = listeBirlestir(b, incKayit(1))
    b = listeBirlestir(b, jmpBant("Lyb_dongu"))
    b = ekle(b, bcEtiket("Lyb_bitti"))
    # open(yol, O_WRONLY|O_CREAT|O_TRUNC=577, 0755=493)
    b = listeBirlestir(b, movYerelOku(7, 0 - 32))
    b = listeBirlestir(b, movImm32(6, 577))
    b = listeBirlestir(b, movImm32(2, 493))
    b = listeBirlestir(b, movImm32(0, 2))
    b = listeBirlestir(b, syscallEmit())
    b = listeBirlestir(b, movYerelYaz(0 - 56, 0))   # [-56] = fd
    # write(fd, tampon, uzunluk)
    b = listeBirlestir(b, movYerelOku(7, 0 - 56))
    b = listeBirlestir(b, movYerelOku(6, 0 - 48))
    b = listeBirlestir(b, movYerelOku(2, 0 - 40))
    b = listeBirlestir(b, movImm32(0, 1))
    b = listeBirlestir(b, syscallEmit())
    # close
    b = listeBirlestir(b, movYerelOku(7, 0 - 56))
    b = listeBirlestir(b, movImm32(0, 3))
    b = listeBirlestir(b, syscallEmit())
    b = listeBirlestir(b, movImm32(0, 0))
    b = listeBirlestir(b, leaveBant())
    döndür listeBirlestir(b, retBant())
son

# 2B - Dosya G/Ç helper'ları (TancElf.tan'a eklenmesi gerekenler)
# DOSYA AÇ: dosyaAc(yol, mod) -> fd (negatifse hata)
işlev dosyaAc(yol, mod)
    b = [bcEtiket("f_dosyaAc")]
    b = listeBirlestir(b, pushKayit(3))
    b = listeBirlestir(b, movKayit(3, 2))
    b = listeBirlestir(b, movYerelYaz(0 - 8, 0))
    b = listeBirlestir(b, movPtrOku(0, 0))
    b = listeBirlestir(b, callBant("f_tan_ayir"))
    b = listeBirlestir(b, movYerelYaz(0 - 16, 0))
    b = listeBirlestir(b, movKayit(0, 0))
    b = listeBirlestir(b, addImm32(0, 16))
    b = listeBirlestir(b, movImm32(1, 2))
    b = listeBirlestir(b, syscallEmit())
    b = listeBirlestir(b, movYerelYaz(0 - 24, 0))
    b = listeBirlestir(b, cmpImm32(0, 0))
    b = listeBirlestir(b, jccBant(1, "dosyaAc_hata"))
    b = listeBirlestir(b, movImm32(0, 0))
    b = listeBirlestir(b, jmpBant("dosyaAc_biti"))
    b = listeBirlestir(b, [bcEtiket("dosyaAc_hata")])
    b = listeBirlestir(b, movImm32(0, -1))
    b = listeBirlestir(b, [bcEtiket("dosyaAc_biti")])
    döndür listeBirlestir(b, retBant())
son

# 2B - DOSYA Oku
işlev dosyaOku(dosya)
    b = [bcEtiket("f_dosyaOku")]
    b = listeBirlestir(b, pushKayit(3))
    b = listeBirlestir(b, movKayit(3, 0))
    b = listeBirlestir(b, movYerelYaz(0 - 8, 0))
    b = listeBirlestir(b, movKayit(0, 0))
    b = listeBirlestir(b, leaDolayli(0, 0, 16))
    b = listeBirlestir(b, movImm32(0, 0))
    b = listeBirlestir(b, syscallEmit())
    b = listeBirlestir(b, movYerelYaz(0 - 24, 0))
    b = listeBirlestir(b, movImm32(0, 16))
    b = listeBirlestir(b, cmpImm32(0, 0))
    b = listeBirlestir(b, jccBant(1, "dosyaOku_hata"))
    b = listeBirlestir(b, movImm32(0, 0))
    b = listeBirlestir(b, jmpBant("dosyaOku_biti"))
    b = listeBirlestir(b, [bcEtiket("dosyaOku_hata")])
    b = listeBirlestir(b, movImm32(0, 0))
    b = listeBirlestir(b, [bcEtiket("dosyaOku_biti")])
    döndür listeBirlestir(b, retBant())
son

# 2B - DOSYA YAZ
işlev dosyaYaz(dosya, icerik)
    b = [bcEtiket("f_dosyaYaz")]
    b = listeBirlestir(b, pushKayit(3))
    b = listeBirlestir(b, movKayit(3, 1))
    b = listeBirlestir(b, movYerelYaz(0 - 8, 0))
    b = listeBirlestir(b, movKayit(0, 0))
    b = listeBirlestir(b, leaDolayli(0, 0, 16))
    b = listeBirlestir(b, movYerelYaz(0 - 16, 1))
    b = listeBirlestir(b, movPtrOku(0, 1))
    b = listeBirlestir(b, syscallEmit())
    b = listeBirlestir(b, movYerelYaz(0 - 24, 0))
    b = listeBirlestir(b, movImm32(0, 16))
    b = listeBirlestir(b, cmpImm32(0, 0))
    b = listeBirlestir(b, jccBant(1, "dosyaYaz_hata"))
    b = listeBirlestir(b, movImm32(0, 0))
    b = listeBirlestir(b, jmpBant("dosyaYaz_biti"))
    b = listeBirlestir(b, [bcEtiket("dosyaYaz_hata")])
    b = listeBirlestir(b, movImm32(0, 0))
    b = listeBirlestir(b, [bcEtiket("dosyaYaz_biti")])
    döndür listeBirlestir(b, retBant())
son

# 2B - DOSYA KAPAT
işlev dosyaKapat(dosya)
    b = [bcEtiket("f_dosyaKapat")]
    b = listeBirlestir(b, pushKayit(1))
    b = listeBirlestir(b, movKayit(1, 3))
    b = listeBirlestir(b, movYerelYaz(0 - 8, 0))
    b = listeBirlestir(b, movKayit(0, 0))
    b = listeBirlestir(b, syscallEmit())
    b = listeBirlestir(b, movImm32(0, 0))
    b = listeBirlestir(b, retBant())
son

# ---------------- PROGRAM ARGÜMANLARI (libc yok, ham yığın) ----------------
# _start'ta rsp -> [argc][argv0][argv1]... Bu taban rsp DEĞİŞTİRİLMEDEN ÖNCE
# saklanmalı — DerleElf.go argvYakala/yardimciArgsay/yardimciArg ile birebir
# aynı yaklaşım. BULUNDU (sabit nokta denemesinde): TancElf.tan'ın kendi
# sürücüsü arg(1)/arg(2) kullanıyor (girdiYolu/ciktiYolu) ama TancElf'in
# ürettiği kodda argv hiç yakalanmıyordu — "BAGLAMA HATASI: etiket
# bulunamadi: f_arg" ile ortaya çıktı (bellek DEĞİL, gerçek eksik özellik).
işlev argvYakalaBant()
    döndür movGenelYaz("v___argv", 4)   # v___argv = rsp (henüz bozulmamış)
son

işlev argsayBant()
    b = [bcEtiket("f_argsay")]
    b = listeBirlestir(b, movGenelOku(0, "v___argv"))
    b = listeBirlestir(b, movPtrOku(0, 0))   # rax = *taban = argc
    döndür listeBirlestir(b, retBant())
son

işlev argBant()
    b = [bcEtiket("f_arg")]
    b = listeBirlestir(b, pushKayit(5))
    b = listeBirlestir(b, movKayit(5, 4))
    b = listeBirlestir(b, subImm32(4, 48))
    b = listeBirlestir(b, movGenelOku(0, "v___argv"))
    b = listeBirlestir(b, leaOge(0, 0, 7))         # rax = taban + rdi*8 + 8 (argv[i])
    b = listeBirlestir(b, movPtrOku(6, 0))         # rsi = C metni
    b = listeBirlestir(b, movYerelYaz(0 - 8, 6))
    b = listeBirlestir(b, xorKayit(1, 1))          # rcx = 0
    b = ekle(b, bcEtiket("Larg_tara"))
    b = listeBirlestir(b, movYerelOku(6, 0 - 8))
    b = listeBirlestir(b, addKayit(6, 1))
    b = listeBirlestir(b, movBaytOku(6))           # al = [rsi]
    b = listeBirlestir(b, movzxAlBant())
    b = listeBirlestir(b, cmpImm32(0, 0))
    b = listeBirlestir(b, jccBant(132, "Larg_bitti")) # je
    b = listeBirlestir(b, incKayit(1))
    b = listeBirlestir(b, jmpBant("Larg_tara"))
    b = ekle(b, bcEtiket("Larg_bitti"))
    b = listeBirlestir(b, movYerelYaz(0 - 16, 1))  # uzunluk = rcx
    b = listeBirlestir(b, movKayit(7, 1))
    b = listeBirlestir(b, addImm32(7, 16))
    b = listeBirlestir(b, callBant("f_tan_ayir"))
    b = listeBirlestir(b, movYerelYaz(0 - 24, 0))
    b = listeBirlestir(b, movYerelOku(1, 0 - 16))
    b = listeBirlestir(b, movPtrYaz(0, 1))         # *rax = uzunluk
    b = listeBirlestir(b, leaDolayli(7, 0, 8))
    b = listeBirlestir(b, movYerelOku(6, 0 - 8))
    b = listeBirlestir(b, movYerelOku(2, 0 - 16))
    b = listeBirlestir(b, callBant("f_bellek_kopyala"))
    b = listeBirlestir(b, movYerelOku(0, 0 - 24))
    b = listeBirlestir(b, leaveBant())
    döndür listeBirlestir(b, retBant())
son

# cagriSonucTipi: CAGRI'nin sonuç tipi (tip yığını için). Yerleşikler için
# sabit liste; kullanıcı işlevleri için islevTipKutu'ya (bkz. aşağıdaki
# "DÖNÜŞ TİPİ ÇIKARIMI" bölümü) bakar — SINIRLI çıkarım: sadece "döndür
# <metin literali>" veya "döndür <bilinen-metin-döndüren-işlev>(...)"
# biçimindeki döndür'leri tanır, değişken üzerinden dönüşleri (ör. bir
# döngüde parça parça biriktirilen sonuç) İZLEMEZ — o durumda güvenli
# varsayılan "tam" kalır (bkz. TanDurum.md "Basit hal" vs "Gerçek kullanım"
# ayrımı, kullanıcı kararıyla kapsam bilinçli olarak burada sınırlandı).
işlev cagriSonucTipi(ad, islevTipKutu)
    # ÖNCEDEN düz "==" kullanıyordu. "ad" PARAMETRE olduğundan tipi hep
    # "tam" sanılıyordu — bu fonksiyonun KENDİSİ, tam olarak listelediği
    # işlevleri (pTur/pDeger/alan dahil) DOĞRU tanıması gerekirken HER
    # ZAMAN "tam" dönüyordu. Sonuç: t=pTur(...)/d=pDeger(...) atamalarında
    # t/d "tam" sanılıyor, blokDerle/deyimDerle'deki ONLARCA "t=="/"d=="
    # karşılaştırması hep yanlış (0) dönüyordu — self-hosting'in en
    # yaygın kırılma noktasıydı (metinEsit ailesindeki BEŞİNCİ örnek).
    eğer metinEsit(ad, "metin") veya metinEsit(ad, "karakter") veya metinEsit(ad, "oku") veya metinEsit(ad, "arg") veya metinEsit(ad, "alan") veya metinEsit(ad, "pTur") veya metinEsit(ad, "pDeger") veya metinEsit(ad, "metinBirlestir") veya metinEsit(ad, "metinAl") ise
        döndür "metin"
    son
    döndür islevTipiAra(islevTipKutu, ad)
son

# ---------------- DÖNÜŞ TİPİ ÇIKARIMI (SINIRLI, ÖN-GEÇİŞ) ----------------
# TancElf.tan'ın kendi tip çıkarımı sadece DEĞİŞKEN ATAMALARINI izler,
# parametre/dönüş tipini izlemez (bkz. yukarıdaki not + TanDurum.md madde 9).
# Bu bölüm, blokDerle/deyimDerle/ifadeBantYaz'a HİÇ DOKUNMADAN (en kırılgan
# kod, "içe al" ile aynı strateji), ana derleme başlamadan ÖNCE tüm kaynağı
# tarayıp kullanıcı işlevlerinin dönüş tipini SINIRLI bir kalıpla çıkarır:
# sadece doğrudan "döndür <metin literali>" ya da "döndür <ad>(...)" (ad
# bilinen bir metin-döndüren yerleşik ya da BAŞKA bir kullanıcı işlevi ise)
# tanınır. Döngü/değişken üzerinden biriken sonuçlar (ör. tBüyüt gibi)
# KASITLI OLARAK tanınmaz — varsayılan "tam" ile güvenli tarafta kalınır,
# hiçbir zaman ÇALIŞAN bir programı YANLIŞ metin-tipi ile bozmaz (yanlış
# negatif olur en kötü ihtimalle, yanlış pozitif olmaz).

# islevTipiAra/islevTipiKaydet: adlarKutu ile AYNI [adlar, tipler] deseni,
# ama ÖMRÜ bir işlev gövdesiyle sınırlı değil — sürücüde BİR KEZ oluşturulup
# sayacKutu gibi tüm derleme boyunca AYNI kutu olarak taşınıyor.
işlev islevTipiAra(islevTipKutu, ad)
    adlar = islevTipKutu[0]
    tipler = islevTipKutu[1]
    n = uzunluk(adlar)
    i = 0
    iken i < n
        eğer metinEsit(adlar[i], ad) ise
            döndür tipler[i]
        son
        i = i + 1
    son
    döndür "tam"
son

işlev islevTipiKaydet(islevTipKutu, ad, tip)
    adlar = islevTipKutu[0]
    n = uzunluk(adlar)
    yuva = 0 - 1
    i = 0
    iken i < n
        eğer metinEsit(adlar[i], ad) ise
            yuva = i
        son
        i = i + 1
    son
    eğer yuva >= 0 ise
        islevTipKutu[1][yuva] = tip
    değilse
        islevTipKutu[0] = ekle(islevTipKutu[0], ad)
        islevTipKutu[1] = ekle(islevTipKutu[1], tip)
    son
    döndür 0
son

işlev yerlesikMetinDonerMi(ad)
    eğer metinEsit(ad, "metin") veya metinEsit(ad, "karakter") veya metinEsit(ad, "oku") veya metinEsit(ad, "arg") veya metinEsit(ad, "alan") veya metinEsit(ad, "pTur") veya metinEsit(ad, "pDeger") veya metinEsit(ad, "metinBirlestir") veya metinEsit(ad, "metinAl") ise
        döndür 1
    son
    döndür 0
son

# islevGovdeSonBul: "işlev ad(...)" parantezi kapandıktan SONRAKİ token
# pozisyonundan başlayıp bu işlevin gövdesini kapatan "son"u bulur.
# derinlik: işlev/eğer/iken/her +1, son -1 ("değilse" derinliği etkilemez,
# aynı "son"u paylaşır — deyimDerle'nin kendi kuralıyla aynı). İçeride
# BAŞKA bir "işlev" (iç içe tanım) görülürse iceIslevVar=1 işaretlenir —
# çağıran bu durumda dönüş tipi ÇIKARIMINI ATLAR (güvenli varsayılan "tam"),
# çünkü döndür'lerin hangi işleve ait olduğunu ayırt etmek bu basit
# tarayıcının kapsamı dışında.
işlev islevGovdeSonBul(tokenler, baslangic)
    n = uzunluk(tokenler)
    derinlik = 1
    i = baslangic
    iceIslevVar = 0
    iken derinlik > 0 ve i < n
        t = alan(tokenler[i], 0)
        d = alan(tokenler[i], 1)
        eğer t == "ANAHTAR" ve (d == "işlev" veya d == "eğer" veya d == "iken" veya d == "her") ise
            eğer d == "işlev" ise
                iceIslevVar = 1
            son
            derinlik = derinlik + 1
        değilse eğer t == "ANAHTAR" ve d == "son" ise
            derinlik = derinlik - 1
        son
        i = i + 1
    son
    döndür [i, iceIslevVar]
son

# govdeDonusTipiCikar: [bas,bitis) aralığındaki TÜM "döndür" deyimlerini
# tara. Hepsi metin-literali ya da bilinen-metin-döndüren-çağrı ise
# "metin", en az bir döndür varsa VE hepsi öyleyse. Aksi HER durumda
# (döndür yok, karışık, tanınmayan desen) "tam" — güvenli varsayılan.
işlev govdeDonusTipiCikar(tokenler, bas, bitis, islevTipKutu)
    n = uzunluk(tokenler)
    i = bas
    doluMu = 0
    hepsiMetinMi = 1
    iken i < bitis ve i < n
        t = alan(tokenler[i], 0)
        d = alan(tokenler[i], 1)
        eğer t == "ANAHTAR" ve d == "döndür" ise
            doluMu = 1
            j = i + 1
            eğer j < bitis ve j < n ise
                jt = alan(tokenler[j], 0)
                jd = alan(tokenler[j], 1)
                eğer jt == "METIN" ise
                    # metin literali — hepsiMetinMi zaten 1, dokunma
                    x = 0
                değilse eğer jt == "AD" ise
                    k = j + 1
                    kt = ""
                    eğer k < bitis ve k < n ise
                        kt = alan(tokenler[k], 0)
                    son
                    eğer kt == "PARAC" ise
                        eğer yerlesikMetinDonerMi(jd) == 1 ise
                            x = 0
                        değilse eğer islevTipiAra(islevTipKutu, jd) == "metin" ise
                            x = 0
                        değilse
                            hepsiMetinMi = 0
                        son
                    değilse
                        hepsiMetinMi = 0
                    son
                değilse
                    hepsiMetinMi = 0
                son
            son
        son
        i = i + 1
    son
    eğer doluMu == 1 ve hepsiMetinMi == 1 ise
        döndür "metin"
    son
    döndür "tam"
son

# islevDonusTipleriBirGecis: kaynak token akışındaki TÜM üst-düzey "işlev"
# tanımlarını tarar, her biri için govdeDonusTipiCikar ile tip çıkarır ve
# islevTipKutu'ya yazar. Bir işlevin dönüş tipi BAŞKA bir işlevin (henüz
# taranmamış, dosyada daha sonra tanımlı) çağrısına bağlı olabileceğinden
# TEK GEÇİŞ yetmeyebilir — döndür 1 (değişti) ise çağıran tekrar çağırır.
işlev islevDonusTipleriBirGecis(tokenler, islevTipKutu)
    n = uzunluk(tokenler)
    i = 0
    degisti = 0
    iken i < n
        t = alan(tokenler[i], 0)
        d = alan(tokenler[i], 1)
        eğer t == "ANAHTAR" ve d == "işlev" ise
            i = i + 1
            eğer i >= n ise
                döndür degisti
            son
            ad = alan(tokenler[i], 1)
            i = i + 1
            iken i < n ve alan(tokenler[i], 0) != "PARKAPA"
                i = i + 1
            son
            i = i + 1
            sonuclar = islevGovdeSonBul(tokenler, i)
            govdeSonu = sonuclar[0]
            iceIslevVar = sonuclar[1]
            eğer iceIslevVar == 0 ise
                yeniTip = govdeDonusTipiCikar(tokenler, i, govdeSonu - 1, islevTipKutu)
                eskiTip = islevTipiAra(islevTipKutu, ad)
                eğer değil metinEsit(eskiTip, yeniTip) ise
                    degisti = 1
                son
                z = islevTipiKaydet(islevTipKutu, ad, yeniTip)
            son
            i = govdeSonu
        değilse
            i = i + 1
        son
    son
    döndür degisti
son

# islevDonusTipleriTara: sabit noktaya kadar (bir geçiş hiçbir şey
# değiştirmeyene kadar) tekrar tekrar tara — işlev sayısı sonlu olduğundan
# ve tipler sadece "tam"->"metin" yönünde değişebildiğinden (asla geri
# dönmez) bu doğal olarak yakınsar; guvenlikSayaci sonsuz döngüye karşı
# saf bir güvenlik ağı (beklenen yakınsama çok daha erken olur).
işlev islevDonusTipleriTara(tokenler, islevTipKutu)
    tekrar = 1
    guvenlikSayaci = 0
    iken tekrar == 1 ve guvenlikSayaci < 200
        tekrar = islevDonusTipleriBirGecis(tokenler, islevTipKutu)
        guvenlikSayaci = guvenlikSayaci + 1
    son
    döndür 0
son

# ---------------- PARAMETRE TİPİ ÇIKARIMI (SINIRLI, ÇAĞRI-YERİ TABANLI) ----------------
# ADIM 2 (devir promptu): islevDonusTipleriTara'nın (dönüş tipi) TAMAMLAYICISI
# — parametrelerin tipini çağrı YERLERİNDEKİ argüman ifadelerinden çıkarır.
# ÖNCEDEN: islevDerle her parametreyi KOŞULSUZ "tam" varsayıyordu (bkz.
# tamTipListesi çağrısı, TanDurum.md madde ADIM2 notu) — metin argüman geçip
# gövde içinde "+"/"=="/indeksleme kullanmak yanlış kod üretiyordu.
#
# AYNI kısıtlı felsefe (yanlış pozitif ASLA, bazı metin parametrelerini
# kaçırmak kabul edilebilir — döndürüş tipi çıkarımıyla BİREBİR aynı ilke):
# sadece (a) METİN LİTERALİ argüman ya da (b) TEK BAŞINA bilinen bir
# metin-döndüren çağrının sonucu tanınır. Karmaşık ifadeler (a+b, iç içe
# operatör, değişken) İZLENMEZ — güvenli varsayılan "tam" kalır.
#
# DEPOLAMA: yeni bir kutu AÇMAK YERİNE islevTipKutu 2 elemandan önce 4, Faz
# 5 (A) ölü budamasıyla 5 elemana genişletildi
# ([donusAdlar,donusTipler,parametreAdlar,parametreTipler,ulasilabilirAdlar]) —
# blokDerle/deyimDerle/islevDerle/ifadeSonuc/ifadeBantYaz ZATEN 6 parametre
# ile (ABI sınırında, bkz. Madde 9 notu) islevTipKutu'yu taşıyor; yeni bir
# 7. parametre eklemek o sınırı tekrar patlatırdı. Mevcut kutuyu genişletmek
# TEK satır threading değişikliği bile gerektirmiyor.

# parametreTipiAra/parametreTipiKaydet: islevTipiAra/islevTipiKaydet ile
# AYNI [adlar,tipler] deseni ama islevTipKutu[2]/[3]'te (anahtar =
# "islevAd/parametreAdi", islevTipiAra/Kaydet'in kullandığı [0]/[1]'den
# AYRI — aynı kutu, farklı bölme).
işlev parametreTipiAra(islevTipKutu, anahtar)
    adlar = islevTipKutu[2]
    tipler = islevTipKutu[3]
    n = uzunluk(adlar)
    i = 0
    iken i < n
        eğer metinEsit(adlar[i], anahtar) ise
            döndür tipler[i]
        son
        i = i + 1
    son
    döndür "tam"
son

işlev parametreTipiKaydet(islevTipKutu, anahtar, tip)
    adlar = islevTipKutu[2]
    n = uzunluk(adlar)
    yuva = 0 - 1
    i = 0
    iken i < n
        eğer metinEsit(adlar[i], anahtar) ise
            yuva = i
        son
        i = i + 1
    son
    eğer yuva >= 0 ise
        islevTipKutu[3][yuva] = tip
    değilse
        islevTipKutu[2] = ekle(islevTipKutu[2], anahtar)
        islevTipKutu[3] = ekle(islevTipKutu[3], tip)
    son
    döndür 0
son

# islevParametreHaritasiCikar: TÜM üst-düzey "işlev ad(p0,p1,...)"
# tanımlarını tarar, [adlar,parametreListeleri] paralel kutusu döner
# (parametreListeleri[i] = adlar[i] işlevinin parametre ADI listesi).
işlev islevParametreHaritasiCikar(tokenler)
    n = uzunluk(tokenler)
    adlar = []
    parametreListeleri = []
    i = 0
    iken i < n
        t = alan(tokenler[i], 0)
        d = alan(tokenler[i], 1)
        eğer t == "ANAHTAR" ve d == "işlev" ise
            i = i + 1
            eğer i >= n ise
                döndür [adlar, parametreListeleri]
            son
            ad = alan(tokenler[i], 1)
            i = i + 1   # ad yut -> pos '('
            i = i + 1   # '(' yut -> pos ilk param / ')'
            parametreler = []
            iken i < n ve alan(tokenler[i], 0) != "PARKAPA"
                eğer alan(tokenler[i], 0) == "AD" ise
                    parametreler = ekle(parametreler, alan(tokenler[i], 1))
                son
                i = i + 1
            son
            adlar = ekle(adlar, ad)
            parametreListeleri = ekle(parametreListeleri, parametreler)
        değilse
            i = i + 1
        son
    son
    döndür [adlar, parametreListeleri]
son

# parametreListesiniBul: islevParametreHaritasiCikar çıktısında ad'ı ara,
# bulunamazsa (yerleşik ya da bilinmeyen çağrı) boş liste döner.
işlev parametreListesiniBul(harita, ad)
    adlar = harita[0]
    listeler = harita[1]
    i = 0
    iken i < uzunluk(adlar)
        eğer metinEsit(adlar[i], ad) ise
            döndür listeler[i]
        son
        i = i + 1
    son
    döndür []
son

# cagriArgumanSinirlariniBul: pos = çağrının '(' AÇAN parantezinden HEMEN
# SONRAKİ pozisyon. Argümanları üst-düzey (derinlik 0) VİRGÜL'lerle ayırıp
# [b0,s0,b1,s1,...] düz liste döner (Tan'da liste-of-tuple yerleşiği yok).
işlev cagriArgumanSinirlariniBul(tokenler, pos)
    n = uzunluk(tokenler)
    sinirlar = []
    i = pos
    eğer i < n ve alan(tokenler[i], 0) == "PARKAPA" ise
        döndür sinirlar   # f() - boş argüman listesi
    son
    argBas = i
    derinlik = 0
    iken i < n
        t = alan(tokenler[i], 0)
        eğer t == "PARAC" ise
            derinlik = derinlik + 1
        değilse eğer t == "PARKAPA" ise
            eğer derinlik == 0 ise
                sinirlar = ekle(sinirlar, argBas)
                sinirlar = ekle(sinirlar, i)
                döndür sinirlar
            son
            derinlik = derinlik - 1
        değilse eğer t == "VIRGUL" ve derinlik == 0 ise
            sinirlar = ekle(sinirlar, argBas)
            sinirlar = ekle(sinirlar, i)
            argBas = i + 1
        son
        i = i + 1
    son
    döndür sinirlar   # dengesiz parantez (olmamalı) — bulunanla güvenli döner
son

# argumanMetinMi: [argBas,argBitis) TEK argümanın metin olup olmadığını
# SINIRLI kalıpla belirler: (a) tek METİN literali token, (b) tam olarak
# "AD(...)" biçiminde TEK çağrı VE AD bilinen metin-döndüren biri (yerleşik
# ya da islevTipiAra ile "metin"). Başka HER şey "tam" sayılır.
işlev argumanMetinMi(tokenler, argBas, argBitis, islevTipKutu)
    uzunlukTok = argBitis - argBas
    eğer uzunlukTok == 1 ve alan(tokenler[argBas], 0) == "METIN" ise
        döndür 1
    son
    eğer uzunlukTok >= 3 ve alan(tokenler[argBas], 0) == "AD" ve alan(tokenler[argBas + 1], 0) == "PARAC" ve alan(tokenler[argBitis - 1], 0) == "PARKAPA" ise
        cagrilanAd = alan(tokenler[argBas], 1)
        eğer yerlesikMetinDonerMi(cagrilanAd) == 1 ise
            döndür 1
        son
        eğer islevTipiAra(islevTipKutu, cagrilanAd) == "metin" ise
            döndür 1
        son
    son
    döndür 0
son

# parametreTipleriniTara: tüm kaynağı TEK geçişte tarar; her CAGRI (AD
# hemen ardından PARAC) görüldüğünde AD bilinen bir KULLANICI işleviyse
# argümanları sınırlandırıp metin olanları islevTipKutu[2]/[3]'e yazar.
# Fixed-point GEREKMİYOR: sınıflandırma sadece islevTipKutu'nun dönüş-tipi
# yarısına (ÖNCEDEN sabit noktaya ulaşmış, bkz. islevDonusTipleriTara) ve
# literal token'lara bakıyor — parametre yarısına geri beslenen bir
# bağımlılık yok, TEK geçiş yeterli ve doğru.
işlev parametreTipleriniTara(tokenler, islevTipKutu)
    harita = islevParametreHaritasiCikar(tokenler)
    n = uzunluk(tokenler)
    i = 0
    iken i < n
        t = alan(tokenler[i], 0)
        eğer t == "AD" ve i + 1 < n ve alan(tokenler[i + 1], 0) == "PARAC" ise
            ad = alan(tokenler[i], 1)
            parametreler = parametreListesiniBul(harita, ad)
            eğer uzunluk(parametreler) > 0 ise
                sinirlar = cagriArgumanSinirlariniBul(tokenler, i + 2)
                argIndex = 0
                k = 0
                iken k < uzunluk(sinirlar)
                    argBas = sinirlar[k]
                    argBitis = sinirlar[k + 1]
                    eğer argIndex < uzunluk(parametreler) ve argumanMetinMi(tokenler, argBas, argBitis, islevTipKutu) == 1 ise
                        anahtar = metinBirlestir(ad, metinBirlestir("/", parametreler[argIndex]))
                        z = parametreTipiKaydet(islevTipKutu, anahtar, "metin")
                    son
                    argIndex = argIndex + 1
                    k = k + 2
                son
            son
        son
        i = i + 1
    son
    döndür 0
son

# parametreTipListesiOlustur: islevDerle'nin yerelAdlarKutu[1] başlangıç
# tipi — ÖNCEDEN koşulsuz tamTipListesi (hepsi "tam"), ARTIK her parametre
# için parametreTipiAra ile çağrı-yeri çıkarımı sonucu (bulunamazsa "tam",
# aynı güvenli varsayılan).
işlev parametreTipListesiOlustur(ad, parametreler, islevTipKutu)
    sonuc = []
    i = 0
    iken i < uzunluk(parametreler)
        anahtar = metinBirlestir(ad, metinBirlestir("/", parametreler[i]))
        sonuc = ekle(sonuc, parametreTipiAra(islevTipKutu, anahtar))
        i = i + 1
    son
    döndür sonuc
son

# ifadeBantYaz: Bölüm 2'nin RPN bandını yığın-makinesi mantığıyla makine
# koduna çevirir. tipYigin ÇALIŞMA-ZAMANI yığınıyla (push/pop) BİREBİR AYNI
# SIRADA ilerleyen bir DERLEME-ZAMANI paralel yığın — "metin mi tam mı"
# ayrımını (yalnızca bunu, tam tip çıkarımı DEĞİL) izler; "+"/"=="/"!="/
# indeksleme hangi kod yolunun üretileceğine bununla karar verir.
# tipKutu (tek elemanlı çıkış kutusu): bant bitince en üstteki (son
# sonucun) tipini tipKutu[0]'a yazar — çağıran (ör. atama, yaz) okur.
işlev ifadeBantYaz(rpnBant, adlarKutu, sayacKutu, tipKutu, islevTipKutu)
    # TAMPON KULLANIYOR (bkz. "TAMPON" başlığı) — her RPN girişi için birden
    # çok listeBirlestir çağrısı yapılıyordu, karmaşık ifadelerde O(n²).
    kodKutu = tamponOlustur()
    nKutu = [0]
    tipYigin = []
    her giris rpnBant içinde
        op = alan(giris, 0)
        a1 = alan(giris, 1)

        eğer op == "BAYT" veya op == "REL32" veya op == "ETIKET" ise
            # kisaDevreBirlestir (ve/veya kısa devre) RPN'in İÇİNE doğrudan
            # ham makine kodu (jcc/jmp/etiket) gömüyor — bagla() zaten bu
            # üçünü TANIYOR (etiket/rel32 çözümü tüm bant üzerinden tek
            # geçişte yapılıyor), burada SADECE olduğu gibi aktarılıyor.
            # tipYigin BİLEREK dokunulmuyor — gerçek pop/push muhasebesi
            # KISADEVREBASLA/ORTA/BITTI işaretleyicileriyle yapılıyor
            # (aşağıda), çünkü buradaki ham popKayit/pushKayit BAYT'ları
            # tek tek görülüyor, "bu bir pop" diye ayırt edilemiyor.
            z = tamponEkle(kodKutu, nKutu, giris)

        değilse eğer op == "KISADEVREBASLA" ise
            # kısa devrenin ham popKayit(sol)'ü çalışma zamanı yığınından
            # BİR değer tüketiyor — sol'un (artık geçersiz) tipini at.
            tipYigin = ilkNHaric(tipYigin, 1)

        değilse eğer op == "KISADEVREORTA" ise
            # sağBant kendi tipini zaten pushladı (normal RPN işlemesiyle);
            # ham popKayit(sağ) onu çalışma zamanı yığınından tüketiyor —
            # aynı şekilde at.
            tipYigin = ilkNHaric(tipYigin, 1)

        değilse eğer op == "KISADEVREBITTI" ise
            # ve/veya HER ZAMAN boolean (tam) döner — nihai tip.
            tipYigin = ekle(tipYigin, "tam")

        değilse eğer op == "SAYITAM" ise
            # movImm32 (REX.W C7/0, "mov r/m64, imm32") sadece 32-bit
            # İŞARETLİ ALANI kodlayabilir — 2^31'i aşan literaller (ör.
            # 9999999999) SESSİZCE 32-bit'e KESİLİYORDU (bilinen bug,
            # bkz. SabitNokta_... teşhis notları). movImm64 (movabs,
            # B8+r imm64) ZATEN vardı ama SAYITAM hiç kullanmıyordu —
            # aralık dışına çıkınca ona geç.
            v = metneTamSayi(a1)
            eğer v >= 0 - 2147483648 ve v <= 2147483647 ise
                z = tamponEkleTumu(kodKutu, nKutu, movImm32(0, v))
            değilse
                z = tamponEkleTumu(kodKutu, nKutu, movImm64(0, v))
            son
            z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))
            tipYigin = ekle(tipYigin, "tam")

        değilse eğer op == "SAYIKESIR" ise
            # FAZ 6: ondalık (kesir) literal. ÖNCEDEN (Faz 6 öncesi) burada
            # SESSİZCE atlanıyordu (pushKayit YOK — "3+0.5" pop ile push
            # edilmemiş değeri çekip RSP'yi kaydırıp SEGFAULT veriyordu),
            # sonra "henüz desteklenmiyor" hatası veriyordu. Artık gerçek
            # IEEE754 kodlaması: kesirBits("d.ddd") ham bit desenini saf
            # tamsayı aritmetiğiyle hesaplar, movImm64 ile GPR'e yüklenir
            # (Go: math.Float64bits — değer kayıtta HAM BIT DESENİ taşınır,
            # tip farkı tamamen statik: tipYigin'e "kesir" yazılır). İşaret
            # biti pozitif kısımda YOK — NEGATIF kolu xor ile ekler.
            v = kesirBits(a1)
            z = tamponEkleTumu(kodKutu, nKutu, movImm64(0, v))
            z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))
            tipYigin = ekle(tipYigin, "kesir")

        değilse eğer op == "METIN" ise
            # Metin literali: veri BULUNDUĞU YERE gömülü üretilir (işlev
            # tanımındaki jmp-etrafında-atlama deseniyle aynı — bkz. deyimDerle
            # "işlev" dalı), sonra [rip+disp32] ile işaretçisi alınır.
            etVeri = yeniEtiket(sayacKutu, "Ls")
            etAtla = yeniEtiket(sayacKutu, "Lsatla")
            z = tamponEkleTumu(kodKutu, nKutu, jmpBant(etAtla))
            z = tamponEkle(kodKutu, nKutu, bcEtiket(etVeri))
            z = tamponEkleTumu(kodKutu, nKutu, metinVerisiBant(a1))
            z = tamponEkle(kodKutu, nKutu, bcEtiket(etAtla))
            z = tamponEkleTumu(kodKutu, nKutu, leaVeri(0, etVeri))
            z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))
            tipYigin = ekle(tipYigin, "metin")

        değilse eğer op == "DOGRU" ise
            # BULUNDU (sabit nokta denemesinde): "doğru"/"yanlış"/"yok"
            # anahtar kelimeleri temelAyristir'de RPN'e "DOGRU"/"YANLIS"/"YOK"
            # olarak kodlanıyordu ama ifadeBantYaz'da HİÇ İŞLENMİYORDU — kod
            # üretmeden sessizce atlanıyordu. TancElf.tan'ın kendi kaynağında
            # bu literaller HİÇ kullanılmadığından (koşullar hep gerçek
            # karşılaştırma), eksiklik hiç ortaya çıkmamıştı. deyimDerle'nin
            # "eğer/değilse eğer" düzeltmesi "iken doğru"
            # kullanmaya başlayınca (zincir döngüsü için) İLK KEZ tetiklendi:
            # "doğru" sıfır bayt üretiyor, koşul kontrolü rax'taki ÇÖP
            # değeri okuyordu — sabit nokta denemesinde gen2'nin blokDerle
            # çağrısının HİÇ ÇALIŞMAMASININ (boş çıktı/segfault) kök nedeniydi.
            z = tamponEkleTumu(kodKutu, nKutu, movImm32(0, 1))
            z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))
            tipYigin = ekle(tipYigin, "tam")

        değilse eğer op == "YANLIS" ise
            z = tamponEkleTumu(kodKutu, nKutu, movImm32(0, 0))
            z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))
            tipYigin = ekle(tipYigin, "tam")

        değilse eğer op == "YOK" ise
            z = tamponEkleTumu(kodKutu, nKutu, movImm32(0, 0))
            z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))
            tipYigin = ekle(tipYigin, "tam")

        değilse eğer op == "DEGIL" ise
            # "değil" (mantıksal NOT) — DOGRU/YANLIS/YOK ile AYNI eksiklik,
            # aynı gerekçeyle burada da hiç işlenmiyordu.
            n = uzunluk(tipYigin)
            tipYigin = ilkNHaric(tipYigin, 1)
            z = tamponEkleTumu(kodKutu, nKutu, popKayit(0))
            z = tamponEkleTumu(kodKutu, nKutu, cmpImm32(0, 0))
            z = tamponEkleTumu(kodKutu, nKutu, setccBant(148))   # sete — sıfırsa(YANLIS) 1
            z = tamponEkleTumu(kodKutu, nKutu, movzxAlBant())
            z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))
            tipYigin = ekle(tipYigin, "tam")

        değilse eğer op == "NEGATIF" ise
            # tekli eksi (-x). ÖNCEDEN sadece tam sayı negKayit ile ele
            # alınıyordu (kesir yoktu). FAZ 6: operandın tipine bakarız —
            # kesir ise İŞARET BİTİNİ (2^63) xor ile çeviririz (Go: rcx=-1;
            # xor rax, rcx ile sign biti), tamsayı ise negKayit. -1<<63'ü
            # kaynakta yazmak için -1'i 63 kez sola kaydırıyoruz (0x8000...
            # literali int64'te taşardı).
            z = tamponEkleTumu(kodKutu, nKutu, popKayit(0))
            nt = uzunluk(tipYigin)
            eğer nt > 0 ve tipYigin[nt - 1] == "kesir" ise
                z = tamponEkleTumu(kodKutu, nKutu, movImm32(1, 0 - 1))
                z = tamponEkleTumu(kodKutu, nKutu, shlImm(1, 63))
                z = tamponEkleTumu(kodKutu, nKutu, xorKayit(0, 1))
            değilse
                z = tamponEkleTumu(kodKutu, nKutu, negKayit(0))
            son
            z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))
            # tip değişmez — tek girdi tek çıktı, tipYigin'e dokunulmuyor.

        değilse eğer op == "AD" ise
            # değişken okuma: rbp-göreli yuvadan
            yuva = adAra(adlarKutu, a1)
            eğer yuva < 0 ise
                yuva = adEkle(adlarKutu, a1)
            son
            z = tamponEkleTumu(kodKutu, nKutu, movYerelOku(0, yuvaDisp(yuva)))
            z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))
            tipYigin = ekle(tipYigin, adTipiAl(adlarKutu, a1))

        değilse eğer op == "LISTE" ise
            # elemanlar zaten sırayla push edilmiş (öge0 en derinde, ögeN-1
            # en üstte). Önce [uzunluk+8*n] bayt ayır, sonra TERSTEN pop
            # ederek doğru indekse yaz (son push = son eleman = en üst).
            n2 = metneTamSayi(a1)
            tipYigin = ilkNHaric(tipYigin, n2)
            z = tamponEkleTumu(kodKutu, nKutu, movImm32(7, 8 + n2 * 8))  # rdi = ayrılacak bayt
            z = tamponEkleTumu(kodKutu, nKutu, callBant("f_tan_ayir"))   # rax = yeni liste
            z = tamponEkleTumu(kodKutu, nKutu, movKayit(1, 0))           # rcx = liste (korunacak)
            z = tamponEkleTumu(kodKutu, nKutu, movImm32(2, n2))          # rdx = uzunluk
            z = tamponEkleTumu(kodKutu, nKutu, movPtrYaz(1, 2))          # [rcx] = uzunluk
            i = n2 - 1
            iken i >= 0
                z = tamponEkleTumu(kodKutu, nKutu, popKayit(0))          # rax = eleman değeri
                z = tamponEkleTumu(kodKutu, nKutu, movImm32(2, i))       # rdx = indeks
                z = tamponEkleTumu(kodKutu, nKutu, leaOge(6, 1, 2))      # rsi = &liste[i]
                z = tamponEkleTumu(kodKutu, nKutu, movPtrYaz(6, 0))      # [rsi] = rax
                i = i - 1
            son
            z = tamponEkleTumu(kodKutu, nKutu, movKayit(0, 1))           # rax = liste işaretçisi
            z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))
            tipYigin = ekle(tipYigin, "liste")

        değilse eğer op == "INDEKS" ise
            # yığında [..., hedef, indeks] — indeks üstte. Hedef metin ise
            # tek harflik YENİ metin döner (f_metin_indeks), değilse liste
            # elemanı ham okunur (mevcut davranış, değişmedi).
            n = uzunluk(tipYigin)
            hedefTip = tipYigin[n - 2]
            tipYigin = ilkNHaric(tipYigin, 2)
            eğer hedefTip == "metin" ise
                z = tamponEkleTumu(kodKutu, nKutu, popKayit(6))    # rsi = indeks
                z = tamponEkleTumu(kodKutu, nKutu, popKayit(7))    # rdi = metin işaretçisi
                z = tamponEkleTumu(kodKutu, nKutu, callBant("f_metin_indeks"))
                tipYigin = ekle(tipYigin, "metin")
            değilse
                z = tamponEkleTumu(kodKutu, nKutu, popKayit(2))    # rdx = indeks
                z = tamponEkleTumu(kodKutu, nKutu, popKayit(1))    # rcx = liste işaretçisi
                z = tamponEkleTumu(kodKutu, nKutu, leaOge(0, 1, 2)) # rax = &liste[indeks]
                z = tamponEkleTumu(kodKutu, nKutu, movPtrOku(0, 0)) # rax = *rax
                tipYigin = ekle(tipYigin, "tam")
            son
            z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))

        değilse eğer op == "CAGRI" ise
            # argümanlar zaten sırayla push edilmiş durumda (arg0 en derinde,
            # argSayisi-1 en üstte) — System V sırasına göre kayıtlara pop et.
            ad = a1
            argSayisi = metneTamSayi(alan(giris, 2))
            kayitlar = [7, 6, 2, 1, 8, 9]   # rdi rsi rdx rcx r8 r9
            sonTip = "tam"
            eğer argSayisi > 0 ise
                sonTip = tipYigin[uzunluk(tipYigin) - 1]
            son
            tipYigin = ilkNHaric(tipYigin, argSayisi)

            eğer ad == "uzunluk" ise
                z = tamponEkleTumu(kodKutu, nKutu, popKayit(0))     # rax = liste/metin işaretçisi
                z = tamponEkleTumu(kodKutu, nKutu, movPtrOku(0, 0)) # rax = *rax (ilk 8 bayt)
                z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))
                tipYigin = ekle(tipYigin, "tam")
            değilse eğer ad == "ekle" ise
                i = argSayisi - 1
                iken i >= 0
                    z = tamponEkleTumu(kodKutu, nKutu, popKayit(kayitlar[i]))
                    i = i - 1
                son
                z = tamponEkleTumu(kodKutu, nKutu, callBant("f_liste_ekle"))
                z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))
                tipYigin = ekle(tipYigin, "liste")
            değilse eğer ad == "listeYap" ise
                # listeYap(n, değer) -> n öğeyi TEK SEFERDE ayırır, O(n²)
                # ekle() zincirini önler (Go referansı f_liste_yap ile aynı).
                i = argSayisi - 1
                iken i >= 0
                    z = tamponEkleTumu(kodKutu, nKutu, popKayit(kayitlar[i]))
                    i = i - 1
                son
                z = tamponEkleTumu(kodKutu, nKutu, callBant("f_liste_yap"))
                z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))
                tipYigin = ekle(tipYigin, "liste")
            değilse eğer ad == "metin" ise
                # metin(x): x zaten metin ise NO-OP (aynı işaretçi), tam ise
                # f_sayi_metne, kesir ise f_kesir_metne (FAZ 6) ile çevir.
                z = tamponEkleTumu(kodKutu, nKutu, popKayit(0))     # rax = x
                eğer sonTip != "metin" ise
                    z = tamponEkleTumu(kodKutu, nKutu, movKayit(7, 0))
                    eğer sonTip == "kesir" ise
                        z = tamponEkleTumu(kodKutu, nKutu, callBant("f_kesir_metne"))
                    değilse
                        z = tamponEkleTumu(kodKutu, nKutu, callBant("f_sayi_metne"))
                    son
                son
                z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))
                tipYigin = ekle(tipYigin, "metin")
            değilse eğer ad == "kod" ise
                z = tamponEkleTumu(kodKutu, nKutu, popKayit(7))     # rdi = metin
                z = tamponEkleTumu(kodKutu, nKutu, callBant("f_kod"))
                z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))
                tipYigin = ekle(tipYigin, "tam")
            değilse eğer ad == "karakter" ise
                z = tamponEkleTumu(kodKutu, nKutu, popKayit(7))     # rdi = kod (tam)
                z = tamponEkleTumu(kodKutu, nKutu, callBant("f_karakter"))
                z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))
                tipYigin = ekle(tipYigin, "metin")
            değilse eğer ad == "metinEsit" ise
                # metinEsit(a,b): İÇERİK karşılaştırması, statik tip izlemeden
                # BAĞIMSIZ (DEĞİŞKEN BAŞINA basit tip izleme parametre/her
                # döngü değişkeni için metin tipini bilemiyor — bkz. "==" IKILI
                # notu; TancElf.tan'ın kendi anahtarMi() işlevi "a==kelime" ile
                # bunu vurdu: hem her-döngü değişkeni hem parametre varsayılan
                # "tam" kaldığından "==" düz tam sayı karşılaştırması yapıp hep
                # yanlış (0) döndürüyordu — TÜM anahtar kelimeler ADSAYILDI,
                # sabit nokta denemesinde gen2'nin kendi sözcük çözümleyicisi
                # bozuk üretilmesinin kök nedeniydi).
                z = tamponEkleTumu(kodKutu, nKutu, popKayit(6))     # rsi = b
                z = tamponEkleTumu(kodKutu, nKutu, popKayit(7))     # rdi = a
                z = tamponEkleTumu(kodKutu, nKutu, callBant("f_metin_esit"))
                z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))
                tipYigin = ekle(tipYigin, "tam")
            değilse eğer ad == "metinBirlestir" ise
                # metinEsit ile aynı gerekçe — statik tip izlemeden BAĞIMSIZ
                # metin birleştirme (tokenKodla/bc gibi parametreleri "+" ile
                # zincirleyen işlevler, parametre tipi hep "tam" sanıldığından
                # bazı basamaklarda tam sayı toplaması yapıp metni bozuyordu).
                z = tamponEkleTumu(kodKutu, nKutu, popKayit(6))     # rsi = b
                z = tamponEkleTumu(kodKutu, nKutu, popKayit(7))     # rdi = a
                z = tamponEkleTumu(kodKutu, nKutu, callBant("f_metin_birlestir"))
                z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))
                tipYigin = ekle(tipYigin, "metin")
            değilse eğer ad == "metinAl" ise
                # metinAl(s,i): statik tip izlemeden BAĞIMSIZ İÇERİK indeksleme
                # — alan() gibi işlevler "s[i]" kullanıyordu; s parametre
                # olduğundan tipi hep "tam" sanılıp INDEKS dalı metin yerine
                # 8-bayt-adımlı liste ögesi gibi okuyordu (alan() TÜM alan
                # ayıklamasının merkezinde olduğundan bu, sabit nokta
                # denemesinde gen2'nin baştan sona bozuk üretilmesinin kök
                # nedeniydi).
                z = tamponEkleTumu(kodKutu, nKutu, popKayit(6))     # rsi = indeks
                z = tamponEkleTumu(kodKutu, nKutu, popKayit(7))     # rdi = metin
                z = tamponEkleTumu(kodKutu, nKutu, callBant("f_metin_indeks"))
                z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))
                tipYigin = ekle(tipYigin, "metin")
            değilse eğer ad == "sistemDur" ise
                # sistemDur(kod): DerleElf.go ile aynı — DOĞRUDAN sys_exit
                # syscall'ı (call f_sistemDur DEĞİL, öyle bir etiket yok).
                eğer argSayisi > 0 ise
                    z = tamponEkleTumu(kodKutu, nKutu, popKayit(7))    # rdi = kod
                değilse
                    z = tamponEkleTumu(kodKutu, nKutu, xorKayit(7, 7))
                son
                z = tamponEkleTumu(kodKutu, nKutu, movImm32(0, 60))    # rax = sys_exit
                z = tamponEkleTumu(kodKutu, nKutu, syscallEmit())
                z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))
                tipYigin = ekle(tipYigin, "tam")
            değilse eğer ad == "tamBol" ise
                # tamBol(a,b): DerleElf.go gibi DOĞRUDAN kod üretimi (çağrı
                # DEĞİL) — "/" ikili işleciyle AYNI cqo+idiv dizisi.
                z = tamponEkleTumu(kodKutu, nKutu, popKayit(1))     # rcx = b (bölen)
                z = tamponEkleTumu(kodKutu, nKutu, popKayit(0))     # rax = a (bölünen)
                z = tamponEkleTumu(kodKutu, nKutu, cqo())
                z = tamponEkleTumu(kodKutu, nKutu, idivKayit(1))
                z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))
                tipYigin = ekle(tipYigin, "tam")
            değilse
                i = argSayisi - 1
                iken i >= 0
                    z = tamponEkleTumu(kodKutu, nKutu, popKayit(kayitlar[i]))
                    i = i - 1
                son
                z = tamponEkleTumu(kodKutu, nKutu, callBant(metinBirlestir("f_", ad)))
                z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))
                tipYigin = ekle(tipYigin, cagriSonucTipi(ad, islevTipKutu))
            son

        değilse eğer op == "IKILI" ise
            n = uzunluk(tipYigin)
            sagTip = tipYigin[n - 1]
            solTip = tipYigin[n - 2]
            tipYigin = ilkNHaric(tipYigin, 2)
            metinVar = (solTip == "metin") veya (sagTip == "metin")

            z = tamponEkleTumu(kodKutu, nKutu, popKayit(1)) # rcx = sağ
            z = tamponEkleTumu(kodKutu, nKutu, popKayit(0)) # rax = sol

            eğer a1 == "+" ve metinVar ise
                # metin birleştirme — sayısal taraf varsa önce metne çevrilir.
                eğer solTip == "metin" ve sagTip == "metin" ise
                    z = tamponEkleTumu(kodKutu, nKutu, movKayit(7, 0))
                    z = tamponEkleTumu(kodKutu, nKutu, movKayit(6, 1))
                    z = tamponEkleTumu(kodKutu, nKutu, callBant("f_metin_birlestir"))
                değilse eğer solTip == "metin" ise
                    z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))    # sol(metin) sakla
                    z = tamponEkleTumu(kodKutu, nKutu, movKayit(7, 1))  # rdi = sağ
                    eğer sagTip == "kesir" ise
                        z = tamponEkleTumu(kodKutu, nKutu, callBant("f_kesir_metne"))
                    değilse
                        z = tamponEkleTumu(kodKutu, nKutu, callBant("f_sayi_metne"))
                    son
                    z = tamponEkleTumu(kodKutu, nKutu, movKayit(6, 0))  # rsi = sağ(metin)
                    z = tamponEkleTumu(kodKutu, nKutu, popKayit(7))     # rdi = sol(metin)
                    z = tamponEkleTumu(kodKutu, nKutu, callBant("f_metin_birlestir"))
                değilse
                    z = tamponEkleTumu(kodKutu, nKutu, pushKayit(1))    # sağ(metin) sakla
                    z = tamponEkleTumu(kodKutu, nKutu, movKayit(7, 0))  # rdi = sol
                    eğer solTip == "kesir" ise
                        z = tamponEkleTumu(kodKutu, nKutu, callBant("f_kesir_metne"))
                    değilse
                        z = tamponEkleTumu(kodKutu, nKutu, callBant("f_sayi_metne"))
                    son
                    z = tamponEkleTumu(kodKutu, nKutu, movKayit(7, 0))  # rdi = sol(metin)
                    z = tamponEkleTumu(kodKutu, nKutu, popKayit(6))     # rsi = sağ(metin)
                    z = tamponEkleTumu(kodKutu, nKutu, callBant("f_metin_birlestir"))
                son
                tipYigin = ekle(tipYigin, "metin")

            değilse eğer (a1 == "==" veya a1 == "!=") ve metinVar ise
                # metin eşitliği: İÇERİK karşılaştırması (f_metin_esit),
                # ham gösterici DEĞİL — bkz. SURUM.md DerleElf.go hatası.
                z = tamponEkleTumu(kodKutu, nKutu, movKayit(7, 0))
                z = tamponEkleTumu(kodKutu, nKutu, movKayit(6, 1))
                z = tamponEkleTumu(kodKutu, nKutu, callBant("f_metin_esit"))
                eğer a1 == "!=" ise
                    z = tamponEkleTumu(kodKutu, nKutu, testKayit(0, 0))
                    z = tamponEkleTumu(kodKutu, nKutu, setccBant(148)) # sete — esit degilse(test=0) 1
                    z = tamponEkleTumu(kodKutu, nKutu, movzxAlBant())
                son
                tipYigin = ekle(tipYigin, "tam")

            değilse eğer a1 != "%" ve (solTip == "kesir" veya sagTip == "kesir" veya a1 == "/") ise
                # FAZ 6: kesir (ondalık) aritmetiği/karşılaştırması. Tamsayı
                # operandlar cvtsi2sd ile double'a çevrilir (Go A1 kararı:
                # "/" HER ZAMAN float64; tamsayı bölmesi yalnız tamBol'da).
                # Aritmetik sonucu "kesir", karşılaştırma sonucu "tam" tipine
                # yazılır. comisd İŞARETSİZ bayrak kullanır — setcc kodları
                # tamsayı kodlarından farklıdır (bkz. kesirKarsilastirmaKodu).
                # sol'u kesirleştir (gerekirse) ÖNCE, sonra SAKLA — böylece
                # pop, dönüştürülmüş bitleri alır (tam sol için 1.0 != 1).
                eğer solTip != "kesir" ise
                    z = tamponEkleTumu(kodKutu, nKutu, cvtTamKesir(0, 0))
                    z = tamponEkleTumu(kodKutu, nKutu, movqKayitXmm(0, 0))
                son
                z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))   # sol(rax) sakla
                eğer a1 == "/" ise
                    z = tamponEkleTumu(kodKutu, nKutu, testKayit(1, 1))
                    z = tamponEkleTumu(kodKutu, nKutu, jccBant(132, "f_hata_sifira_bolme"))
                son
                eğer sagTip != "kesir" ise
                    z = tamponEkleTumu(kodKutu, nKutu, cvtTamKesir(0, 1))
                    z = tamponEkleTumu(kodKutu, nKutu, movqKayitXmm(1, 0))
                son
                z = tamponEkleTumu(kodKutu, nKutu, movqXmmKayit(1, 1)) # xmm1 = sağ
                z = tamponEkleTumu(kodKutu, nKutu, popKayit(0))        # rax = sol
                z = tamponEkleTumu(kodKutu, nKutu, movqXmmKayit(0, 0)) # xmm0 = sol
                eğer karsilastirmaMi(a1) ise
                    z = tamponEkleTumu(kodKutu, nKutu, comisd(0, 1))
                    z = tamponEkleTumu(kodKutu, nKutu, setccBant(kesirKarsilastirmaKodu(a1)))
                    z = tamponEkleTumu(kodKutu, nKutu, movzxAlBant())
                    tipYigin = ekle(tipYigin, "tam")
                değilse
                    ok = 88  # addsd
                    eğer a1 == "-" ise
                        ok = 92 # subsd
                    son
                    eğer a1 == "*" ise
                        ok = 89 # mulsd
                    son
                    eğer a1 == "/" ise
                        ok = 94 # divsd
                    son
                    z = tamponEkleTumu(kodKutu, nKutu, sseIkili(ok, 0, 1))
                    z = tamponEkleTumu(kodKutu, nKutu, movqKayitXmm(0, 0))
                    tipYigin = ekle(tipYigin, "kesir")
                son

            değilse
                eğer a1 == "+" ise
                    z = tamponEkleTumu(kodKutu, nKutu, addKayit(0, 1))
                değilse eğer a1 == "-" ise
                    z = tamponEkleTumu(kodKutu, nKutu, subKayit(0, 1))
                değilse eğer a1 == "*" ise
                    z = tamponEkleTumu(kodKutu, nKutu, imulKayit(0, 1))
                değilse eğer a1 == "/" ise
                    # GERÇEK `/` kesir yoluna düşer (A1); savunma amaçlı
                    # tamsayı yedeği (burada normalde asla çalışmaz).
                    z = tamponEkleTumu(kodKutu, nKutu, cqo())
                    z = tamponEkleTumu(kodKutu, nKutu, idivKayit(1))
                değilse eğer a1 == "%" ise
                    # FAZ 6: sıfıra bölme koruması (Go ile aynı — test rcx,rcx
                    # + je f_hata_sifira_bolme). `%` HER ZAMAN tamsayıdır.
                    z = tamponEkleTumu(kodKutu, nKutu, testKayit(1, 1))
                    z = tamponEkleTumu(kodKutu, nKutu, jccBant(132, "f_hata_sifira_bolme"))
                    z = tamponEkleTumu(kodKutu, nKutu, cqo())
                    z = tamponEkleTumu(kodKutu, nKutu, idivKayit(1))
                    z = tamponEkleTumu(kodKutu, nKutu, movKayit(0, 2)) # rax = rdx (kalan)
                değilse
                    # karşılaştırma: cmp + setcc + movzx
                    z = tamponEkleTumu(kodKutu, nKutu, cmpKayit(0, 1))
                    z = tamponEkleTumu(kodKutu, nKutu, setccBant(karsilastirmaKodu(a1)))
                    z = tamponEkleTumu(kodKutu, nKutu, movzxAlBant())
                son
                tipYigin = ekle(tipYigin, "tam")
            son
            z = tamponEkleTumu(kodKutu, nKutu, pushKayit(0))
        son
    son
    eğer uzunluk(tipYigin) > 0 ise
        tipKutu[0] = tipYigin[uzunluk(tipYigin) - 1]
    değilse
        tipKutu[0] = "tam"
    son
    döndür tamponSonuc(kodKutu, nKutu)
son

# setcc al  (0F 9x C0)
işlev setccBant(kod2)
    b = []
    b = ekle(b, bcBayt(15))
    b = ekle(b, bcBayt(kod2))
    b = ekle(b, bcBayt(192))
    döndür b
son

# movzx rax, al  (48 0F B6 C0)
işlev movzxAlBant()
    b = []
    b = ekle(b, bcBayt(72))
    b = ekle(b, bcBayt(15))
    b = ekle(b, bcBayt(182))
    b = ekle(b, bcBayt(192))
    döndür b
son

işlev karsilastirmaKodu(islec)
    eğer islec == "==" ise
        döndür 148
    son
    eğer islec == "!=" ise
        döndür 149
    son
    eğer islec == "<" ise
        döndür 156
    son
    eğer islec == ">" ise
        döndür 159
    son
    eğer islec == "<=" ise
        döndür 158
    son
    döndür 157
son

# karsilastirmaMi: islec bir KARŞILAŞTIRMA operatörü mü (sonuç tipi "tam").
işlev karsilastirmaMi(islec)
    eğer islec == "==" veya islec == "!=" veya islec == ">" veya islec == "<" veya islec == ">=" veya islec == "<=" ise
        döndür 1
    son
    döndür 0
son

# kesirKarsilastirmaKodu: comisd (66 0F 2F) İŞARETSİZ bayraklar üretir, bu
# yüzden setcc kodları tamsayı (cmp) kodlarından FARKLIDIR (Go 1452-1462):
# ==148 !=149 >151 <146 >=147 <=150.
işlev kesirKarsilastirmaKodu(islec)
    eğer islec == "==" ise
        döndür 148
    son
    eğer islec == "!=" ise
        döndür 149
    son
    eğer islec == ">" ise
        döndür 151
    son
    eğer islec == "<" ise
        döndür 146
    son
    eğer islec == ">=" ise
        döndür 147
    son
    döndür 150
son

# islevDerle: işlev gövdesini KENDİ yerel değişken tablosuyla (parametrelerle
# önceden doldurulmuş) derler. Çerçeve boyu, ana gövdedeki gibi, gövde
# derlendikten SONRA (kaç yerel değişken kullanıldığı belli olunca) hesaplanır
# — Go referansındaki (DerleElf.go islevYaz) ön-tarama yerine iki-geçişli aynı
# yaklaşım: önce derle, sonra çerçeveyi öne ekle.
# Parametreler kayıt sırasına göre rdi,rsi,rdx,rcx,r8,r9'dan yuvalara yazılır
# (System V AMD64 çağrı kuralı, en fazla 6 parametre).
# NOT (ADIM 2'de KAPANDI, bkz. "PARAMETRE TİPİ ÇIKARIMI" bölümü): parametre
# tipleri artık çağrı yerlerindeki argümanlardan (SINIRLI kalıp — metin
# literali ya da bilinen metin-döndüren tek çağrı) çıkarılıyor.
# parametreTipListesiOlustur bulunamayanlar için güvenli "tam" varsayılanına
# döner (DerleElf.go'nun parametreTipleriniOgren'i kadar derin değil ama
# aynı "asla yanlış pozitif" ilkesiyle).
işlev islevDerle(ad, parametreler, tokenler, pozKutu, sayacKutu, islevTipKutu)
    yerelAdlarKutu = [parametreler, parametreTipListesiOlustur(ad, parametreler, islevTipKutu)]
    govde = blokDerle(tokenler, pozKutu, yerelAdlarKutu, sayacKutu, ["", ""], islevTipKutu)
    eğer pTur(tokenler, pozKutu) == "ANAHTAR" ve pDeger(tokenler, pozKutu) == "son" ise
        x = pIlerle(tokenler, pozKutu)
    son

    degiskenSayisi = uzunluk(yerelAdlarKutu[0])
    cerceveBoy = 8 * degiskenSayisi
    eğer cerceveBoy % 16 != 0 ise
        cerceveBoy = cerceveBoy + 8
    son

    onSozKutu = tamponOlustur()
    onSozNKutu = [0]
    # ÖNCEDEN "f_" + ad (düz "+") — ad işlevin KENDİ PARAMETRESİ olduğundan
    # tipi hep "tam" sanılıyordu, üretilen etiket adı GERÇEK işlev adı
    # DEĞİL (ad'ın sayısal/pointer değerinin metne çevrilmiş hali) oluyordu
    # — çağrı tarafı (ifadeBantYaz CAGRI, "ad" orada DOĞRU tipli bir yerel
    # değişken) doğru "f_<ad>" üretirken TANIM tarafı yanlış etiket
    # ürettiğinden bagla() "etiket bulunamadi" veriyordu (metinEsit
    # ailesindeki ALTINCI örnek — self-hosting'i KULLANICI TANIMLI HER
    # İŞLEVİN etiketi için bloke ediyordu).
    z = tamponEkle(onSozKutu, onSozNKutu, bcEtiket(metinBirlestir("f_", ad)))
    z = tamponEkleTumu(onSozKutu, onSozNKutu, pushKayit(5))     # push rbp
    z = tamponEkleTumu(onSozKutu, onSozNKutu, movKayit(5, 4))   # mov rbp, rsp
    eğer cerceveBoy > 0 ise
        z = tamponEkleTumu(onSozKutu, onSozNKutu, subImm32(4, cerceveBoy))
    son

    kayitlar = [7, 6, 2, 1, 8, 9]   # rdi rsi rdx rcx r8 r9
    i = 0
    iken i < uzunluk(parametreler)
        z = tamponEkleTumu(onSozKutu, onSozNKutu, movYerelYaz(yuvaDisp(i), kayitlar[i]))
        i = i + 1
    son

    z = tamponEkleTumu(onSozKutu, onSozNKutu, govde)

    # döndür yoksa işlev 0 döner (DOKUMANTASYON.md) — düşme yolu için de
    # aynı leave/ret kullanılır.
    z = tamponEkleTumu(onSozKutu, onSozNKutu, movImm32(0, 0))
    z = tamponEkleTumu(onSozKutu, onSozNKutu, leaveBant())
    z = tamponEkleTumu(onSozKutu, onSozNKutu, retBant())

    döndür tamponSonuc(onSozKutu, onSozNKutu)
son

# ---------------- İÇE AL (MODÜL) GENİŞLETME — derleme-zamanı statik ekleme ----------------
# elf yolu çalışma anında dosya sistemine bakamaz — Go'nun DerleElf.go'daki
# "elfIceAlGenislet" ile AYNI strateji: "içe al" TOKEN AKIŞINDA (blokDerle'ye
# hiç girmeden ÖNCE) çözülür, modülün token'ları olduğu yere satır içi
# eklenir. deyimDerle/blokDerle'ye HİÇ DOKUNULMADI (bu ikisi self-hosting'i
# defalarca kıran en kırılgan kod) — tüm yeni mantık SADECE tokenle()'nin
# çıktısı üzerinde, deyimDerle'den TAMAMEN BAĞIMSIZ çalışıyor.

# dosyaDizini(yol): son "/" karakterine kadar olan kısmı döndürür (yoksa ".").
işlev dosyaDizini(yol)
    n = uzunluk(yol)
    i = n - 1
    iken i >= 0 ve değil metinEsit(metinAl(yol, i), "/")
        i = i - 1
    son
    eğer i < 0 ise
        döndür "."
    son
    sonuc = ""
    j = 0
    iken j < i
        sonuc = metinBirlestir(sonuc, metinAl(yol, j))
        j = j + 1
    son
    döndür sonuc
son

# iceAlYoluCoz: basitleştirilmiş modül arama — 1) kaynak dosyanın yanı,
# 2) kaynak dosyanın kutuphane/ alt dizini, 3) verilen yol olduğu gibi
# (çalışma dizinine göre, "kutuphane/X.tan" tarzı çağrılar için).
işlev iceAlYoluCoz(yol, kaynakDizin)
    aday1 = metinBirlestir(kaynakDizin, metinBirlestir("/", yol))
    eğer dosyaVarMi(aday1) ise
        döndür aday1
    son
    aday2 = metinBirlestir(kaynakDizin, metinBirlestir("/kutuphane/", yol))
    eğer dosyaVarMi(aday2) ise
        döndür aday2
    son
    döndür yol
son

# tokenGenislet: token akışını baştan sona tarar, "içe al "yol"" gördüğü
# yerde o üç token'ı SİLİP yerine modülün (yinelemeli genişletilmiş)
# token'larını yerleştirir. Aynı modül (mutlak/verilen yola göre) bir daha
# alınmaz (gorulenlerKutu[0] ile izlenir, döngüsel içe almaya karşı da korur).
işlev tokenGenislet(tokenler, kaynakDizin, gorulenlerKutu)
    cikisKutu = tamponOlustur()
    cN = [0]
    poz = [0]
    iken pTur(tokenler, poz) != "DOSYASONU"
        t = pTur(tokenler, poz)
        d = pDeger(tokenler, poz)
        eğer t == "ANAHTAR" ve d == "içe" ise
            x = pIlerle(tokenler, poz)
            eğer pTur(tokenler, poz) == "ANAHTAR" ve pDeger(tokenler, poz) == "al" ise
                x = pIlerle(tokenler, poz)
            son
            yol = pDeger(tokenler, poz)
            x = pIlerle(tokenler, poz)

            tamYol = iceAlYoluCoz(yol, kaynakDizin)

            zatenVar = 0
            gorulen = gorulenlerKutu[0]
            i = 0
            iken i < uzunluk(gorulen)
                eğer metinEsit(gorulen[i], tamYol) ise
                    zatenVar = 1
                son
                i = i + 1
            son

            eğer zatenVar == 1 ise
                # atla — bu modül daha önce alınmış (döngüsel/tekrar koruması)
            değilse
                gorulenlerKutu[0] = ekle(gorulenlerKutu[0], tamYol)
                icKaynak = oku(tamYol)
                icTokenler = tokenle(icKaynak)
                icDizin = dosyaDizini(tamYol)
                genisTokenler = tokenGenislet(icTokenler, icDizin, gorulenlerKutu)
                j = 0
                iken j < uzunluk(genisTokenler) - 1
                    z = tamponEkle(cikisKutu, cN, genisTokenler[j])
                    j = j + 1
                son
            son
        değilse
            z = tamponEkle(cikisKutu, cN, tokenler[poz[0]])
            x = pIlerle(tokenler, poz)
        son
    son
    z = tamponEkle(cikisKutu, cN, tokenler[poz[0]])
    döndür tamponSonuc(cikisKutu, cN)
son

# ================= FAZ 5 (A): ÖLÜ İŞLEV BUDAMASI =================
# islevGovdeHaritasiCikar: üst-seviye TÜM işlevlerin [adlar, basListe,
# bitisListe] paralel listelerini tek geçişte çıkarır. bitis = kapanış "son"
# sonrası ilk pozisyon (islevGovdeSonBul semantiği). İç içe işlevler AYRI
# kaydedilmez — gövdeleri üst işlevin [bas, bitis) aralığında kalır; üst
# erişilebilirse gövde taraması zaten onları da kapsar.
işlev islevGovdeHaritasiCikar(tokenler, haritaKutu)
    n = uzunluk(tokenler)
    adlar = []
    basListe = []
    bitisListe = []
    i = 0
    iken i < n
        t = alan(tokenler[i], 0)
        d = alan(tokenler[i], 1)
        eğer t == "ANAHTAR" ve d == "işlev" ise
            i = i + 1
            eğer i >= n ise
                döndür 0
            son
            ad = alan(tokenler[i], 1)
            i = i + 1
            iken i < n ve alan(tokenler[i], 0) != "PARKAPA"
                i = i + 1
            son
            i = i + 1
            sonuclar = islevGovdeSonBul(tokenler, i)
            govdeSonu = sonuclar[0]
            adlar = ekle(adlar, ad)
            basListe = ekle(basListe, i)
            bitisListe = ekle(bitisListe, govdeSonu)
            i = govdeSonu
        son
        i = i + 1
    son
    haritaKutu[0] = adlar
    haritaKutu[1] = basListe
    haritaKutu[2] = bitisListe
    döndür 0
son

işlev adListedeMi(liste, ad)
    n = uzunluk(liste)
    i = 0
    iken i < n
        eğer metinEsit(liste[i], ad) ise
            döndür 1
        son
        i = i + 1
    son
    döndür 0
son

işlev adIndisBul(liste, ad)
    n = uzunluk(liste)
    i = 0
    iken i < n
        eğer metinEsit(liste[i], ad) ise
            döndür i
        son
        i = i + 1
    son
    döndür 0 - 1
son

# işlevCagirdiklariniTopla: [bas, bitis) aralığındaki KULLANICI işlev
# çağrılarını toplar. Çağrı belirtisi: AD jetonunu hemen PARAC "(" izler VE
# ad işlev adları listesindeyse. Builtin'ler (yaz, metin, ekle, uzunluk...)
# işlev adları listesinde OLMADIĞI için elenir; yanlış-pozitifler en kötü
# ihtimalle bir işlevi budanmaktan korur (güvenli yön), yanlış-negatif yok.
işlev işlevCagirdiklariniTopla(tokenler, bas, bitis, işlevAdlari)
    sonuc = []
    i = bas
    iken i < bitis - 1
        t = alan(tokenler[i], 0)
        d = alan(tokenler[i], 1)
        eğer t == "AD" ve alan(tokenler[i + 1], 0) == "PARAC" ve adListedeMi(işlevAdlari, d) == 1 ise
            sonuc = ekle(sonuc, d)
        son
        i = i + 1
    son
    döndür sonuc
son

# ulasilabilirIslevleriTara: DerleElf.go'daki elfUlasilabilirIslevler'in
# token tabanlı karşılığı (BFS). Tohum: ana (üst-seviye) gövdenin kullanıcı
# işlev çağrıları — işlev gövdeleri [bas, bitis) aralıklarından atlanarak
# top-level jetonlar taranır. Sonuç islevTipKutu[4]'e yazılır.
işlev ulasilabilirIslevleriTara(tokenler, islevTipKutu)
    haritaKutu = [[], [], []]
    z = islevGovdeHaritasiCikar(tokenler, haritaKutu)
    adlar = haritaKutu[0]
    baslar = haritaKutu[1]
    bitisler = haritaKutu[2]
    ulasilan = []
    kuyruk = []
    n = uzunluk(tokenler)
    govdeIndis = 0
    govdeAdet = uzunluk(baslar)
    i = 0
    iken i < n
        govdedeyiz = 0
        eğer govdeIndis < govdeAdet ise
            eğer i >= baslar[govdeIndis] ve i < bitisler[govdeIndis] ise
                govdedeyiz = 1
            son
        son
        eğer govdedeyiz == 1 ise
            i = bitisler[govdeIndis]
            govdeIndis = govdeIndis + 1
        değilse
            eğer i + 1 < n ise
                t = alan(tokenler[i], 0)
                d = alan(tokenler[i], 1)
                cagriMi = 0
                eğer t == "AD" ise
                    eğer alan(tokenler[i + 1], 0) == "PARAC" ise
                        eğer adListedeMi(adlar, d) == 1 ise
                            cagriMi = 1
                            eğer i > 0 ise
                                eğer metinEsit(alan(tokenler[i - 1], 1), "işlev") ise
                                    cagriMi = 0
                                son
                            son
                        son
                    son
                son
                eğer cagriMi == 1 ise
                    eğer adListedeMi(ulasilan, d) == 0 ise
                        ulasilan = ekle(ulasilan, d)
                        kuyruk = ekle(kuyruk, d)
                    son
                son
            son
            i = i + 1
        son
    son
    j = 0
    iken j < uzunluk(kuyruk)
        suAn = kuyruk[j]
        indis = adIndisBul(adlar, suAn)
        eğer indis != 0 - 1 ise
            cagiranlar = işlevCagirdiklariniTopla(tokenler, baslar[indis], bitisler[indis], adlar)
            k = 0
            iken k < uzunluk(cagiranlar)
                cAd = cagiranlar[k]
                eğer adListedeMi(ulasilan, cAd) == 0 ise
                    ulasilan = ekle(ulasilan, cAd)
                    kuyruk = ekle(kuyruk, cAd)
                son
                k = k + 1
            son
        son
        j = j + 1
    son
    islevTipKutu[4] = ulasilan
    döndür 0
son

# ---------------- FAZ 5 (B): RUNTIME YARDIMCI BUDAMASI ----------------
# Eskiden sürücü 17 yardımcıyı KOŞULSUZ gömüyordu (satır ~3698-3714). Burada
# önce govde bandındaki REL32 hedeflerinden hangi yardımcıların gerçekten
# çağrıldığı taranır, bağımlılık kapanışı (f_tan_ayir/f_bellek_kopyala gibi
# iç çağrılar) eklenir ve SADECE o küme gömülür. Go tarafı (DerleElf.go) bu
# budamayı otomatik yapar — TancElf'in karşılığı bu üç işlevdir.
işlev yardimciBagimliliklari(ad)
    eğer metinEsit(ad, "f_liste_ekle") ise
        döndür ["f_tan_ayir", "f_bellek_kopyala"]
    değilse eğer metinEsit(ad, "f_liste_yap") ise
        döndür ["f_tan_ayir"]
    değilse eğer metinEsit(ad, "f_sayi_metne") ise
        döndür ["f_tan_ayir"]
    değilse eğer metinEsit(ad, "f_metin_birlestir") ise
        döndür ["f_tan_ayir", "f_bellek_kopyala"]
    değilse eğer metinEsit(ad, "f_metin_indeks") ise
        döndür ["f_tan_ayir"]
    değilse eğer metinEsit(ad, "f_karakter") ise
        döndür ["f_tan_ayir"]
    değilse eğer metinEsit(ad, "f_oku") ise
        döndür ["f_tan_ayir", "f_bellek_kopyala"]
    değilse eğer metinEsit(ad, "f_dosyaVarMi") ise
        döndür ["f_tan_ayir", "f_bellek_kopyala"]
    değilse eğer metinEsit(ad, "f_yazBaytlar") ise
        döndür ["f_tan_ayir", "f_bellek_kopyala"]
    değilse eğer metinEsit(ad, "f_arg") ise
        döndür ["f_tan_ayir", "f_bellek_kopyala"]
    değilse eğer metinEsit(ad, "f_kesir_metne") ise
        döndür ["f_tan_ayir", "f_bellek_kopyala"]
    değilse eğer metinEsit(ad, "f_yaz_kesir") ise
        döndür ["f_kesir_metne", "f_yaz_metin"]
    son
    döndür []
son

# yardimciKapanisi: kökler (govde'de DOĞRUDAN çağrılan yardımcılar) +
# bağımlılık kapanışı. BFS — yardimciBagimliliklari yapraklara iner.
işlev yardimciKapanisi(kokler)
    sonuc = kokler
    kuyruk = kokler
    j = 0
    iken j < uzunluk(kuyruk)
        suAn = kuyruk[j]
        baglar = yardimciBagimliliklari(suAn)
        k = 0
        iken k < uzunluk(baglar)
            b = baglar[k]
            eğer adListedeMi(sonuc, b) == 0 ise
                sonuc = ekle(sonuc, b)
                kuyruk = ekle(kuyruk, b)
            son
            k = k + 1
        son
        j = j + 1
    son
    döndür sonuc
son

# yardimciKullanimiTara: banddaki TÜM REL32 hedeflerini tarar, bilinen
# yardımcı adlarında olanları (tekil) toplar. Kullanıcı işlevleri "f_"+ad
# etiketiyle çağrıldığından whitelist (yardimciAdlar) dışında kalan tüm
# f_* hedefleri ESNEKTİR — yalnız gerçek yardımcılar yakalanır.
işlev yardimciKullanimiTara(bant, yardimciAdlar)
    sonuc = []
    n = uzunluk(bant)
    i = 0
    iken i < n
        giris = bant[i]
        op = alan(giris, 0)
        eğer metinEsit(op, "REL32") ise
            hedef = alan(giris, 1)
            eğer adListedeMi(yardimciAdlar, hedef) == 1 ise
                eğer adListedeMi(sonuc, hedef) == 0 ise
                    sonuc = ekle(sonuc, hedef)
                son
            son
        son
        i = i + 1
    son
    döndür sonuc
son

# ---------------- SÜRÜCÜ: TAM KAYNAK DOSYASI DERLEME ----------------
# Kullanim:  TancElf <girdi.tan> <cikti-binary>
# Destek: tam sayi ifadeleri, degisken atamasi, yaz, eger/degilse, iken.

girdiYolu = arg(1)
ciktiYolu = arg(2)
kaynak = oku(girdiYolu)
tokenler = tokenle(kaynak)
kaynakDizin = dosyaDizini(girdiYolu)
gorulenlerKutu = [[]]
tokenler = tokenGenislet(tokenler, kaynakDizin, gorulenlerKutu)
pozKutu = [0]
adlarKutu = [[], []]
sayacKutu = [0]
islevTipKutu = [[], [], [], [], []]
z = islevDonusTipleriTara(tokenler, islevTipKutu)
z = parametreTipleriniTara(tokenler, islevTipKutu)
z = ulasilabilirIslevleriTara(tokenler, islevTipKutu)

govde = blokDerle(tokenler, pozKutu, adlarKutu, sayacKutu, ["", ""], islevTipKutu)
# --- cerceve: degisken sayisi ancak govde derlenince belli olur ---
degiskenSayisi = uzunluk(adlarKutu[0])
cerceveBoy = 8 * degiskenSayisi + 16

# --- Faz 5 (B): kullanılan yardımcı kümesini govde bandından çıkar ---
yardimciAdlar = ["yaz_sayi", "f_tan_ayir", "f_bellek_kopyala", "f_liste_ekle", "f_liste_yap", "f_sayi_metne", "f_metin_birlestir", "f_metin_esit", "f_metin_indeks", "f_kod", "f_karakter", "f_yaz_metin", "f_oku", "f_dosyaVarMi", "f_yazBaytlar", "f_argsay", "f_arg", "f_kesir_metne", "f_yaz_kesir", "f_hata_sifira_bolme"]
yardimciBantlar = [yazSayiBant(), tanAyirBant(), bellekKopyalaBant(), listeEkleBant(), listeYapBant(), sayiMetneBant(), metinBirlestirBant(), metinEsitBant(), metinIndeksBant(), kodBant(), karakterBant(), yazMetinBant(), okuBant(), dosyaVarMiBant(), yazBaytlarBant(), argsayBant(), argBant(), kesirMetneBant(), yazKesirBant(), hataSifiraBolmeBant()]
kullanilanYardimcilar = yardimciKullanimiTara(govde, yardimciAdlar)
gomulcekYardimcilar = yardimciKapanisi(kullanilanYardimcilar)

# NOT (bulunan İKİNCİ büyük O(n²) kaynağı, sabit nokta denemesinde): burada
# önceden "bantTumu = listeBirlestir(bantTumu, X())" zinciri vardı — govde
# (TÜM program gövdesinin derlenmiş kodu, TancElf.tan kendini derlerken
# onbinlerce bant girdisi) tek bir listeBirlestir çağrısıyla ekleniyordu;
# listeBirlestir içi ekle() KOPYALAYARAK büyüdüğü için bu TEK çağrı O(|govde|²)
# idi. tokenle/bagla/blokDerle/ifadeBantYaz/islevDerle/deyimDerle tamponla
# düzeltildikten SONRA bile sabit nokta hâlâ çöküyordu — sebebi buydu.
bantTumuKutu = tamponOlustur()
bantTumuNKutu = [0]
z = tamponEkleTumu(bantTumuKutu, bantTumuNKutu, argvYakalaBant())   # v___argv=rsp (rsp henüz bozulmadan, EN BAŞTA)
z = tamponEkleTumu(bantTumuKutu, bantTumuNKutu, pushKayit(5))        # push rbp
z = tamponEkleTumu(bantTumuKutu, bantTumuNKutu, movKayit(5, 4))      # mov rbp, rsp
z = tamponEkleTumu(bantTumuKutu, bantTumuNKutu, subImm32(4, cerceveBoy))
z = tamponEkleTumu(bantTumuKutu, bantTumuNKutu, yiginIlkleBant())    # r12 = heap_ptr ilklendir
z = tamponEkleTumu(bantTumuKutu, bantTumuNKutu, govde)
z = tamponEkleTumu(bantTumuKutu, bantTumuNKutu, movImm32(0, 60))     # mov rax, 60 (exit)
z = tamponEkleTumu(bantTumuKutu, bantTumuNKutu, xorKayit(7, 7))      # xor rdi, rdi
z = tamponEkleTumu(bantTumuKutu, bantTumuNKutu, syscallEmit())
i = 0
iken i < uzunluk(yardimciAdlar)
    eğer adListedeMi(gomulcekYardimcilar, yardimciAdlar[i]) == 1 ise
        z = tamponEkleTumu(bantTumuKutu, bantTumuNKutu, yardimciBantlar[i])
    son
    i = i + 1
son
z = tamponEkleTumu(bantTumuKutu, bantTumuNKutu, veriAyir("v_yigin", 8))
z = tamponEkleTumu(bantTumuKutu, bantTumuNKutu, veriAyir("v_yiginSon", 8))
