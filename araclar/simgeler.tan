# simgeler.tan — bağımsız sembol listeleyici sarmalayıcı.
# Çekirdek kutuphane/araclar.tan içindedir (tek kaynak). Birleşik arayüz: ./tan simgeler
# Kullanım: (./TancElf araclar/simgeler.tan simgeler)  ./simgeler <dosya.tan> [--json]

içe al "kutuphane/araclar.tan"

eğer argsay() < 2 ise
    yaz("Kullanım: simgeler <dosya.tan> [--json]")
değilse
    json = yanlış
    yol = ""
    ai = 1
    iken ai < argsay()
        a = arg(ai)
        eğer metinEsit(a, "--json") ise
            json = doğru
        değilse
            eğer uzunluk(yol) == 0 ise
                yol = a
            son
        son
        ai = ai + 1
    son
    d = simgelerAna(yol, json)
son
