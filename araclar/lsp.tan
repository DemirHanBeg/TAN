# lsp.tan — TAN için minimal LSP (Language Server Protocol) sunucusu.
# stdio üzerinden: initialize, textDocument/documentSymbol, shutdown, exit.
# Kaldıraç 1'i tamamlar: gerçek editör entegrasyonu (VS Code vb.).
# Derle: ./TancElf araclar/lsp.tan tanlsp   →  editör "tanlsp" komutunu çalıştırır.
# Builtin: girdiOkuN (n bayt), yazHam (ham stdout). Ortak: tanoku.tan.

içe al "kutuphane/tanoku.tan"

# ---- LSP transport ----

# başlığı \r\n\r\n görene kadar bayt-bayt oku
işlev lspBaslikOku()
    h = ""
    iken 1 < 2
        c = girdiOkuN(1)
        eğer uzunluk(c) == 0 ise
            döndür ""
        son
        h = metinBirlestir(h, c)
        n = uzunluk(h)
        eğer n >= 4 ve metinAl(h, n - 4) == karakter(13) ve metinAl(h, n - 3) == karakter(10) ve metinAl(h, n - 2) == karakter(13) ve metinAl(h, n - 1) == karakter(10) ise
            döndür h
        son
    son
    döndür h
son

# alt metni ara, başlangıç indeksi veya -1
işlev altMetinBul(s, alt)
    ns = uzunluk(s)
    na = uzunluk(alt)
    i = 0
    iken i + na <= ns
        j = 0
        eslesme = doğru
        iken j < na
            eğer metinAl(s, i + j) != metinAl(alt, j) ise
                eslesme = yanlış
            son
            j = j + 1
        son
        eğer eslesme ise
            döndür i
        son
        i = i + 1
    son
    döndür 0 - 1
son

# indeks bas'tan itibaren rakamları tam sayıya çevir
işlev metinRakamlari(s, bas)
    n = uzunluk(s)
    i = bas
    iken i < n ve metinAl(s, i) == " "
        i = i + 1
    son
    sonuc = 0
    iken i < n
        c = metinAl(s, i)
        k = kod(c)
        eğer k >= 48 ve k <= 57 ise
            sonuc = sonuc * 10 + (k - 48)
        değilse
            i = n
        son
        i = i + 1
    son
    döndür sonuc
son

# başlıktan Content-Length değeri
işlev lspUzunluk(baslik)
    idx = altMetinBul(baslik, "Content-Length:")
    eğer idx < 0 ise
        döndür 0
    son
    döndür metinRakamlari(baslik, idx + 15)
son

# gövdeyi tam n bayt oku (kısmi dönüşleri topla)
işlev lspGovdeOku(n)
    govde = ""
    iken uzunluk(govde) < n
        kalan = n - uzunluk(govde)
        parca = girdiOkuN(kalan)
        eğer uzunluk(parca) == 0 ise
            döndür govde
        son
        govde = metinBirlestir(govde, parca)
    son
    döndür govde
son

# yanıtı çerçeveleyip yaz
işlev lspYaz(govde)
    yazHam(metinBirlestir("Content-Length: ", metinBirlestir(metin(uzunluk(govde)), metinBirlestir(karakter(13), metinBirlestir(karakter(10), metinBirlestir(karakter(13), karakter(10)))))))
    yazHam(govde)
son

# ---- JSON ayıklama (kaba string-tarama, iyi biçimli LSP için yeterli) ----

# "anahtar":"deger" → deger (metin)
işlev jsonMetin(s, anahtar)
    ara = metinBirlestir("\"", metinBirlestir(anahtar, "\""))
    idx = altMetinBul(s, ara)
    eğer idx < 0 ise
        döndür ""
    son
    # anahtar sonrası ilk çift tırnak (değerin başı)
    i = idx + uzunluk(ara)
    n = uzunluk(s)
    iken i < n ve metinAl(s, i) != "\""
        i = i + 1
    son
    i = i + 1
    deger = ""
    iken i < n ve metinAl(s, i) != "\""
        deger = metinBirlestir(deger, metinAl(s, i))
        i = i + 1
    son
    döndür deger
son

# "anahtar":TOKEN → ham token (sayı/id için, virgüle/süse kadar)
işlev jsonHam(s, anahtar)
    ara = metinBirlestir("\"", metinBirlestir(anahtar, "\":"))
    idx = altMetinBul(s, ara)
    eğer idx < 0 ise
        döndür "0"
    son
    i = idx + uzunluk(ara)
    n = uzunluk(s)
    iken i < n ve metinAl(s, i) == " "
        i = i + 1
    son
    tok = ""
    iken i < n
        c = metinAl(s, i)
        eğer c == "," veya c == "}" veya c == " " ise
            i = n
        değilse
            tok = metinBirlestir(tok, c)
            i = i + 1
        son
    son
    döndür tok
son

# uri (file:///yol) → dosya yolu
işlev uriYol(uri)
    on = "file://"
    idx = altMetinBul(uri, on)
    eğer idx < 0 ise
        döndür uri
    son
    yol = ""
    i = idx + uzunluk(on)
    n = uzunluk(uri)
    iken i < n
        yol = metinBirlestir(yol, metinAl(uri, i))
        i = i + 1
    son
    # Windows /C:/... → C:/... (baştaki tek / kaldır)
    eğer uzunluk(yol) >= 3 ve metinAl(yol, 0) == "/" ve metinAl(yol, 2) == ":" ise
        kesik = ""
        j = 1
        iken j < uzunluk(yol)
            kesik = metinBirlestir(kesik, metinAl(yol, j))
            j = j + 1
        son
        döndür kesik
    son
    döndür yol
son

# ---- documentSymbol: kaynaktan sembol listesi [ad, kind, satir] ----
işlev lspSimgeler(kaynak)
    satirlar = satiraBol(kaynak)
    liste = []
    si = 0
    iken si < uzunluk(satirlar)
        satir = satirlar[si]
        b = boslukAtla(satir, 0)
        kelime = kelimeAl(satir, b)
        eğer metinEsit(kelime, "işlev") ise
            adBasla = boslukAtla(satir, b + uzunluk(kelime))
            ad = kelimeAl(satir, adBasla)
            liste = ekle(liste, [ad, 12, si])
        son
        si = si + 1
    son
    döndür liste
son

# documentSymbol yanıtı yaz (id, kaynak)
işlev lspDocumentSymbol(id, kaynak)
    simgeler = lspSimgeler(kaynak)
    govde = metinBirlestir("{\"jsonrpc\":\"2.0\",\"id\":", metinBirlestir(id, ",\"result\":["))
    i = 0
    iken i < uzunluk(simgeler)
        sm = simgeler[i]
        eğer i > 0 ise
            govde = metinBirlestir(govde, ",")
        son
        satirNo = metin(sm[2])
        aralik = metinBirlestir("{\"start\":{\"line\":", metinBirlestir(satirNo, ",\"character\":0},\"end\":{\"line\":"))
        aralik = metinBirlestir(aralik, metinBirlestir(satirNo, ",\"character\":0}}"))
        govde = metinBirlestir(govde, metinBirlestir("{\"name\":\"", sm[0]))
        govde = metinBirlestir(govde, metinBirlestir("\",\"kind\":", metin(sm[1])))
        govde = metinBirlestir(govde, metinBirlestir(",\"range\":", aralik))
        govde = metinBirlestir(govde, metinBirlestir(",\"selectionRange\":", aralik))
        govde = metinBirlestir(govde, "}")
        i = i + 1
    son
    govde = metinBirlestir(govde, "]}")
    lspYaz(govde)
    döndür 0
son

# initialize yanıtı
işlev lspInitialize(id)
    govde = metinBirlestir("{\"jsonrpc\":\"2.0\",\"id\":", metinBirlestir(id, ",\"result\":{\"capabilities\":{\"documentSymbolProvider\":true,\"hoverProvider\":true,\"definitionProvider\":true,\"renameProvider\":true,\"textDocumentSync\":1}}}"))
    lspYaz(govde)
    döndür 0
son

# ---- hover / definition yardımcıları ----

# no'lu satırı (0-tabanlı) döndür
işlev satirAl(kaynak, no)
    satirlar = satiraBol(kaynak)
    eğer no < 0 veya no >= uzunluk(satirlar) ise
        döndür ""
    son
    döndür satirlar[no]
son

# kimlik karakteri mi? (harf/rakam/_ veya çok-baytlı Türkçe >=128)
işlev kimlikKarMi(c)
    k = kod(c)
    eğer k >= 48 ve k <= 57 ise
        döndür doğru
    son
    eğer k >= 65 ve k <= 90 ise
        döndür doğru
    son
    eğer k >= 97 ve k <= 122 ise
        döndür doğru
    son
    eğer k >= 128 ise
        döndür doğru
    son
    döndür c == "_"
son

# kar konumundaki kelimeyi (kimlik) döndür
işlev konumKelime(satir, kar)
    n = uzunluk(satir)
    eğer kar < 0 veya kar >= n ise
        döndür ""
    son
    bas = kar
    iken bas > 0 ve kimlikKarMi(metinAl(satir, bas - 1))
        bas = bas - 1
    son
    ucu = kar
    iken ucu < n ve kimlikKarMi(metinAl(satir, ucu))
        ucu = ucu + 1
    son
    kelime = ""
    i = bas
    iken i < ucu
        kelime = metinBirlestir(kelime, metinAl(satir, i))
        i = i + 1
    son
    döndür kelime
son

# ad'lı işlevin tanım satır no'su (0) ve imzası → [no, imza]; yoksa [-1, ""]
işlev islevBul(kaynak, ad)
    satirlar = satiraBol(kaynak)
    si = 0
    iken si < uzunluk(satirlar)
        satir = satirlar[si]
        b = boslukAtla(satir, 0)
        kel = kelimeAl(satir, b)
        eğer metinEsit(kel, "işlev") ise
            adBasla = boslukAtla(satir, b + uzunluk(kel))
            eğer metinEsit(kelimeAl(satir, adBasla), ad) ise
                döndür [si, kirp(satir)]
            son
        son
        si = si + 1
    son
    döndür [0 - 1, ""]
son

# hover yanıtı (id, kaynak, satirNo, kar)
işlev lspHover(id, kaynak, satirNo, kar)
    satir = satirAl(kaynak, satirNo)
    kelime = konumKelime(satir, kar)
    bulundu = islevBul(kaynak, kelime)
    eğer bulundu[0] < 0 ise
        lspYaz(metinBirlestir("{\"jsonrpc\":\"2.0\",\"id\":", metinBirlestir(id, ",\"result\":null}")))
    değilse
        deger = metinBirlestir("işlev ", metinBirlestir(kelime, " — tanım satır "))
        deger = metinBirlestir(deger, metin(bulundu[0] + 1))
        govde = metinBirlestir("{\"jsonrpc\":\"2.0\",\"id\":", metinBirlestir(id, ",\"result\":{\"contents\":{\"kind\":\"plaintext\",\"value\":\""))
        govde = metinBirlestir(govde, metinBirlestir(deger, "\"}}}"))
        lspYaz(govde)
    son
    döndür 0
son

# definition yanıtı (id, uri, kaynak, satirNo, kar)
işlev lspDefinition(id, uri, kaynak, satirNo, kar)
    satir = satirAl(kaynak, satirNo)
    kelime = konumKelime(satir, kar)
    bulundu = islevBul(kaynak, kelime)
    eğer bulundu[0] < 0 ise
        lspYaz(metinBirlestir("{\"jsonrpc\":\"2.0\",\"id\":", metinBirlestir(id, ",\"result\":null}")))
    değilse
        dno = metin(bulundu[0])
        aralik = metinBirlestir("{\"start\":{\"line\":", metinBirlestir(dno, ",\"character\":0},\"end\":{\"line\":"))
        aralik = metinBirlestir(aralik, metinBirlestir(dno, ",\"character\":0}}"))
        govde = metinBirlestir("{\"jsonrpc\":\"2.0\",\"id\":", metinBirlestir(id, ",\"result\":{\"uri\":\""))
        govde = metinBirlestir(govde, metinBirlestir(uri, metinBirlestir("\",\"range\":", aralik)))
        govde = metinBirlestir(govde, "}}")
        lspYaz(govde)
    son
    döndür 0
son

# ---- rename (tek dosya içi, whole-word) ----

# satirdaki 'kelime' whole-word geçtiği tüm başlangıç kolonlarını döndür
işlev satirdaTumKonumlar(satir, kelime)
    liste = []
    n = uzunluk(satir)
    kn = uzunluk(kelime)
    i = 0
    iken i < n
        oncekiKimlik = yanlış
        eğer i > 0 ve kimlikKarMi(metinAl(satir, i - 1)) ise
            oncekiKimlik = doğru
        son
        eğer kimlikKarMi(metinAl(satir, i)) ve oncekiKimlik == yanlış ise
            eslesme = doğru
            j = 0
            iken j < kn
                eğer i + j >= n veya metinAl(satir, i + j) != metinAl(kelime, j) ise
                    eslesme = yanlış
                son
                j = j + 1
            son
            sonrakiKimlikDegil = doğru
            eğer i + kn < n ve kimlikKarMi(metinAl(satir, i + kn)) ise
                sonrakiKimlikDegil = yanlış
            son
            eğer eslesme ve sonrakiKimlikDegil ise
                liste = ekle(liste, i)
            son
            iken i < n ve kimlikKarMi(metinAl(satir, i))
                i = i + 1
            son
        değilse
            i = i + 1
        son
    son
    döndür liste
son

# rename yanıtı (id, uri, kaynak, satirNo, kar, yeniAd) — tek dosya içindeki
# tüm whole-word geçişlerini değiştiren bir WorkspaceEdit üretir
işlev lspRename(id, uri, kaynak, satirNo, kar, yeniAd)
    satir0 = satirAl(kaynak, satirNo)
    kelime = konumKelime(satir0, kar)
    eğer uzunluk(kelime) == 0 ise
        lspYaz(metinBirlestir("{\"jsonrpc\":\"2.0\",\"id\":", metinBirlestir(id, ",\"result\":null}")))
        döndür 0
    son
    satirlar = satiraBol(kaynak)
    duzenler = ""
    ilkMi = doğru
    si = 0
    iken si < uzunluk(satirlar)
        konumlar = satirdaTumKonumlar(satirlar[si], kelime)
        ki = 0
        iken ki < uzunluk(konumlar)
            kol = konumlar[ki]
            snStr = metin(si)
            basStr = metin(kol)
            sonStr = metin(kol + uzunluk(kelime))
            aralik = "{\"start\":{\"line\":"
            aralik = metinBirlestir(aralik, snStr)
            aralik = metinBirlestir(aralik, ",\"character\":")
            aralik = metinBirlestir(aralik, basStr)
            aralik = metinBirlestir(aralik, "},\"end\":{\"line\":")
            aralik = metinBirlestir(aralik, snStr)
            aralik = metinBirlestir(aralik, ",\"character\":")
            aralik = metinBirlestir(aralik, sonStr)
            aralik = metinBirlestir(aralik, "}}")
            duzen = "{\"range\":"
            duzen = metinBirlestir(duzen, aralik)
            duzen = metinBirlestir(duzen, ",\"newText\":\"")
            duzen = metinBirlestir(duzen, yeniAd)
            duzen = metinBirlestir(duzen, "\"}")
            eğer ilkMi == yanlış ise
                duzenler = metinBirlestir(duzenler, ",")
            son
            ilkMi = yanlış
            duzenler = metinBirlestir(duzenler, duzen)
            ki = ki + 1
        son
        si = si + 1
    son
    govde = "{\"jsonrpc\":\"2.0\",\"id\":"
    govde = metinBirlestir(govde, id)
    govde = metinBirlestir(govde, ",\"result\":{\"changes\":{\"")
    govde = metinBirlestir(govde, uri)
    govde = metinBirlestir(govde, "\":[")
    govde = metinBirlestir(govde, duzenler)
    govde = metinBirlestir(govde, "]}}}")
    lspYaz(govde)
    döndür 0
son

# ---- diagnostics: kaynaktan tanı listesi [satir(0), severity, kod, mesaj] ----
işlev lspTanilar(kaynak)
    satirlar = satiraBol(kaynak)
    liste = []
    derinlik = 0
    si = 0
    iken si < uzunluk(satirlar)
        satir = satirlar[si]
        b = boslukAtla(satir, 0)
        kelime = kelimeAl(satir, b)
        eğer blokAcici(kelime) ise
            derinlik = derinlik + 1
        değilse
            eğer metinEsit(kelime, "son") ise
                eğer derinlik == 0 ise
                    liste = ekle(liste, [si, 1, "TAN001", "eşleşen blok yok, fazladan 'son'"])
                değilse
                    derinlik = derinlik - 1
                son
            son
        son
        nsatir = uzunluk(satir)
        eğer nsatir > 0 ve bosMuk(metinAl(satir, nsatir - 1)) ise
            liste = ekle(liste, [si, 2, "TAN003", "satır sonunda gereksiz boşluk"])
        son
        si = si + 1
    son
    eğer derinlik > 0 ise
        liste = ekle(liste, [0, 1, "TAN002", "blok kapatılmamış ('son' eksik)"])
    son
    döndür liste
son

# publishDiagnostics bildirimi (uri, kaynak)
işlev lspPublishDiagnostics(uri, kaynak)
    tanilar = lspTanilar(kaynak)
    govde = metinBirlestir("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"", metinBirlestir(uri, "\",\"diagnostics\":["))
    i = 0
    iken i < uzunluk(tanilar)
        t = tanilar[i]
        eğer i > 0 ise
            govde = metinBirlestir(govde, ",")
        son
        satirNo = metin(t[0])
        aralik = metinBirlestir("{\"start\":{\"line\":", metinBirlestir(satirNo, ",\"character\":0},\"end\":{\"line\":"))
        aralik = metinBirlestir(aralik, metinBirlestir(satirNo, ",\"character\":80}}"))
        govde = metinBirlestir(govde, metinBirlestir("{\"range\":", aralik))
        govde = metinBirlestir(govde, metinBirlestir(",\"severity\":", metin(t[1])))
        govde = metinBirlestir(govde, metinBirlestir(",\"code\":\"", metinBirlestir(t[2], "\"")))
        govde = metinBirlestir(govde, metinBirlestir(",\"message\":\"", metinBirlestir(t[3], "\"}")))
        i = i + 1
    son
    govde = metinBirlestir(govde, "]}}")
    lspYaz(govde)
    döndür 0
son

# ---- ana döngü ----
işlev lspCalis()
    iken 1 < 2
        baslik = lspBaslikOku()
        eğer uzunluk(baslik) == 0 ise
            döndür 0
        son
        n = lspUzunluk(baslik)
        govde = lspGovdeOku(n)
        yontem = jsonMetin(govde, "method")
        id = jsonHam(govde, "id")

        eğer metinEsit(yontem, "initialize") ise
            d = lspInitialize(id)
        değilse eğer metinEsit(yontem, "textDocument/documentSymbol") ise
            uri = jsonMetin(govde, "uri")
            yol = uriYol(uri)
            d = lspDocumentSymbol(id, oku(yol))
        değilse eğer metinEsit(yontem, "textDocument/didOpen") veya metinEsit(yontem, "textDocument/didSave") ise
            uri = jsonMetin(govde, "uri")
            yol = uriYol(uri)
            d = lspPublishDiagnostics(uri, oku(yol))
        değilse eğer metinEsit(yontem, "textDocument/hover") ise
            uri = jsonMetin(govde, "uri")
            sno = metinRakamlari(jsonHam(govde, "line"), 0)
            kno = metinRakamlari(jsonHam(govde, "character"), 0)
            d = lspHover(id, oku(uriYol(uri)), sno, kno)
        değilse eğer metinEsit(yontem, "textDocument/definition") ise
            uri = jsonMetin(govde, "uri")
            sno = metinRakamlari(jsonHam(govde, "line"), 0)
            kno = metinRakamlari(jsonHam(govde, "character"), 0)
            d = lspDefinition(id, uri, oku(uriYol(uri)), sno, kno)
        değilse eğer metinEsit(yontem, "textDocument/rename") ise
            uri = jsonMetin(govde, "uri")
            sno = metinRakamlari(jsonHam(govde, "line"), 0)
            kno = metinRakamlari(jsonHam(govde, "character"), 0)
            yeniAd = jsonMetin(govde, "newName")
            d = lspRename(id, uri, oku(uriYol(uri)), sno, kno, yeniAd)
        değilse eğer metinEsit(yontem, "shutdown") ise
            lspYaz(metinBirlestir("{\"jsonrpc\":\"2.0\",\"id\":", metinBirlestir(id, ",\"result\":null}")))
        değilse eğer metinEsit(yontem, "exit") ise
            döndür 0
        son
    son
    döndür 0
son

d = lspCalis()
