# tan.tan — TAN birleşik araç dispatcher'ı (tek toolchain binary — Kaldıraç 5).
# Derle: ./TancElf tan.tan tan   →  Kullanım: ./tan <komut> <dosya.tan> [--json]
# Go'nun tek-`go`-binary avantajını Tan'da geri getirir. Yeni araçlar buraya takılır.

içe al "kutuphane/araclar.tan"

eğer argsay() < 2 ise
    yaz("TAN aracı — Kullanım: tan <komut> <dosya.tan> [--json]")
    yaz("Komutlar:")
    yaz("  simgeler     sembol listeleyici (işlev/değişken)")
    yaz("  api          dışa-açık işlev imzaları")
    yaz("  bagimlilik   içe al grafiği")
    yaz("  ast          yapısal ayrıştırma ağacı")
    yaz("  olcum        kod metrikleri (satır/işlev/derinlik)")
    yaz("  denetle      blok dengesi linter'ı + tanı")
    yaz("  bicimlendir  kanonik formatter (bic)")
    yaz("  kilit        içerik-adresli lockfile (SHA-256, transitive)")
    yaz("  dogrula      lockfile'a karşı bütünlük kontrolü")
    yaz("  imzala       dosyayı HMAC-SHA256 ile imzala (<dosya> <anahtar>)")
    yaz("  imzadogrula  imzayı doğrula (<dosya> <anahtar> <imza>)")
    yaz("  cek          uzak paket çek + sha256 doğrula (<ip> <port> <yol> [sha])")
    yaz("  cekad        cek ama IP yerine hostname (gerçek DNS/TCP:53, TLS YOK) (<host> <port> <yol> [sha])")
    yaz("  onbellekyaz  dosyayı içerik-adresli önbelleğe yaz (<dosya> <onbellek-dizin>)")
    yaz("  onbellekal   önbellekten hash ile oku (<hash> <onbellek-dizin> <hedef|->)")
    yaz("  sürüm        toolchain bilgisi")
değilse
    komut = arg(1)

    eğer metinEsit(komut, "sürüm") veya metinEsit(komut, "surum") ise
        d = surumAna()
    değilse eğer metinEsit(komut, "imzala") ise
        eğer argsay() < 4 ise
            yaz("Kullanım: tan imzala <dosya.tan> <anahtar>")
        değilse
            d = imzalaAna(arg(2), arg(3))
        son
    değilse eğer metinEsit(komut, "imzadogrula") ise
        eğer argsay() < 5 ise
            yaz("Kullanım: tan imzadogrula <dosya.tan> <anahtar> <imza>")
        değilse
            d = imzaDogrulaAna(arg(2), arg(3), arg(4))
        son
    değilse eğer metinEsit(komut, "cek") ise
        eğer argsay() < 5 ise
            yaz("Kullanım: tan cek <ip> <port> <yol> [beklenen-sha256|-]")
        değilse eğer argsay() < 6 ise
            d = cekAna(arg(2), arg(3), arg(4), "-")
        değilse
            d = cekAna(arg(2), arg(3), arg(4), arg(5))
        son
    değilse eğer metinEsit(komut, "cekad") ise
        eğer argsay() < 5 ise
            yaz("Kullanım: tan cekad <hostname> <port> <yol> [beklenen-sha256|-]")
        değilse eğer argsay() < 6 ise
            d = cekAdAna(arg(2), arg(3), arg(4), "-")
        değilse
            d = cekAdAna(arg(2), arg(3), arg(4), arg(5))
        son
    değilse eğer metinEsit(komut, "onbellekyaz") ise
        eğer argsay() < 4 ise
            yaz("Kullanım: tan onbellekyaz <dosya> <onbellek-dizin>")
        değilse
            d = onbellekYazAna(arg(2), arg(3))
        son
    değilse eğer metinEsit(komut, "onbellekal") ise
        eğer argsay() < 5 ise
            yaz("Kullanım: tan onbellekal <hash> <onbellek-dizin> <hedef-yol|->")
        değilse
            d = onbellekAlAna(arg(2), arg(3), arg(4))
        son
    değilse
        # komuttan sonraki argümanlar: --json bayrağı + ilk dosya yolu
        json = yanlış
        yol = ""
        ai = 2
        iken ai < argsay()
            a = arg(ai)
            eğer metinEsit(a, "--json") ise
                json = doğru
            değilse
                eğer uzunluk(yol) == 0 ise
                    yol = a
                son
            son
            ai = ai + 1
        son

        eğer uzunluk(yol) == 0 ise
            yaz(metinBirlestir("Hata: dosya yolu gerekli — tan ", metinBirlestir(komut, " <dosya.tan>")))
        değilse
            eğer metinEsit(komut, "simgeler") ise
                d = simgelerAna(yol, json)
            değilse eğer metinEsit(komut, "api") ise
                d = apiAna(yol, json)
            değilse eğer metinEsit(komut, "bagimlilik") ise
                d = bagimlilikAna(yol, json)
            değilse eğer metinEsit(komut, "ast") ise
                d = astAna(yol, json)
            değilse eğer metinEsit(komut, "olcum") ise
                d = olcumAna(yol, json)
            değilse eğer metinEsit(komut, "denetle") ise
                d = denetleAna(yol, json)
            değilse eğer metinEsit(komut, "bicimlendir") veya metinEsit(komut, "bic") ise
                d = bicimlendirAna(yol)
            değilse eğer metinEsit(komut, "kilit") ise
                d = kilitAna(yol, json)
            değilse eğer metinEsit(komut, "kilityaz") ise
                d = kilitYazAna(yol)
            değilse eğer metinEsit(komut, "dogrula") ise
                d = dogrulaAna(yol)
            değilse
                yaz(metinBirlestir("Bilinmeyen komut: ", komut))
            son
        son
    son
son
