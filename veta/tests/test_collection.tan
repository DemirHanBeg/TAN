# test_collection.tan — VETA collection library smoke test
# Kompilasyon: qemu-x86_64 TancElf <bu_dosya> <cikti>
# Çalıştırma:  qemu-x86_64 <cikti>
# Kural: mevcut TancElf binary'sini kullan; bootstrap yenilenmediği sürece QEMU throttle engelliyorum.

içe al "../source/collection/source/koleksiyon.tan"

# Liste testleri
yaz("Listenin uzunluğu: ")
yaz(listeUzunluk([1, 2, 3, 4, 5]))
yaz("\n")

# Eleman ekle
liste = [1, 2, 3]
liste = listeEkle(liste, 4)
yaz("Ekleme sonucu: ")
yaz(listeUzunluk(liste))
yaz("\n")

# İçinde mi kontrolü
yaz("1 icinde mi: ")
yaz(listeIcerideMi(liste, 1))
yaz("\n")

# Her içinde
sonuç = 0
iken i < 5 {
    sonuç = sonuç + 1
}
yaz("Her 0..4 içinde: ")
yaz(sonuç)
yaz("\n")