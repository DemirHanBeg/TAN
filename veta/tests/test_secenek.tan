# option/result testleri
# Başarılı sonuç
sonuç1 = optionBasarili(42)
yaz("optionBasarili(42): ")
yaz(optionDeğerAl(sonuç1))
yaz("\n")

# Başarısız sonuç (None)
sonuç2 = optionBasarisiz()
yaz("optionBasarisiz: ")
yaz(optionDeğerAl(sonuç2))
yaz("\n")

# result: Başarılı
sonuç3 = resultBasarili("tamam")
yaz("resultBasarili: ")
yaz(resultDeğerAl(sonuç3))
yaz("\n")

# result: Başarısız
sonuç4 = resultBasarisiz("hata")
