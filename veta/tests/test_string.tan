# test_string.tan — VETA string library smoke test
# Kompilasyon: qemu-x86_64 TancElf <bu_dosya> <cikti>
# Çalıştırma:  qemu-x86_64 <cikti>
# Kural: mevcut TancElf binary'sini kullan; bootstrap yenilenmediği sürece QEMU throttle engelliyorum.

# String birleştirme
sonuç1 = metinBirlestir("merhaba", " ", "dünya")
yaz("birleştirme: ")
yaz(sonuç1)
yaz("\n")

# String eşlik kontrolü
sonuç2 = metinEsit("hello", "hello")
yaz("eşlik: ")
yaz(sonuç2)
yaz("\n")

# Metin uzunluğu
sonuç3 = metinUzunluk("merhaba")
yaz("uzunluk: ")
yaz(sonuç3)
yaz("\n")

# Alt string (slicing - TAN bay'T bazlı)
sonuç4 = metinAraliği("merhaba dünya", 0, 5)
yaz("alt metin: ")
yaz(sonuç4)
yaz("\n")