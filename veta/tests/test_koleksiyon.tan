# test_koleksiyon.tan — VETA collection library smoke test
# Kompilasyon: qemu-x86_64 TancElf <bu_dosya> <cikti>
# Çalıştırma:  qemu-x86_64 <cikti>
# Kural: mevcut TancElf binary'sini kullan; bootstrap yenilenmediği sürece QEMU throttle engelliyorum.

içe al "../source/collection/source/koleksiyon.tan"

#Liste oluştur ve uzunluğunu kontrolü
liste = [1, 2, 3]
yaz("Liste uzunluğu: ")
yaz(listeUzunluk(liste))
yaz("\n")

# Eleman ekle
liste = listeEkle(liste, 4)
yaz("Ekledikten sonraki uzunluk: ")
yaz(listeUzunluk(liste))
yaz("\n")

# İçinde mi kontrolü
yaz("3 içermiyor mu: ")
yaz(listeIcerideMi(liste, 3))
yaz("\n")

# Her içinde döngü
sonuç = 0
iken i < 5 {
    sonuç = sonuç + 1
}
yaz("Her 0..4 içinde çalıştı: ")
yaz(sonuç)
yaz("\n")