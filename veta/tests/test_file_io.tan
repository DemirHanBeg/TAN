# test_file_io.tan — VETA file I/O (2B) smoke test
# Kompilasyon: ./TancElf veta/tests/test_file_io.tan <cikti> (repo kökünden)
# Çalıştırma:  <cikti>
# 2026-08-21: GERÇEKTEN ÇALIŞTIRILDI (native WSL2, throttle yok). Önceki halinde
# yanlış import ("../source/math/source/mat.tan" — hiç var olmadı) ve "yav("
# yazım hatası vardı (yaz() olmalıydı) — bu dosya derlenmemiş bir taslaktı,
# düzeltildi.

yaz("=== File I/O Test ===\n")

fd = dosyaAc("/tmp/veta_test_output.txt", 1)
yaz("dosyaAc sonucu (fd): ")
yaz(fd)
yaz("\n")

sonuc = dosyaYaz(fd, "merhaba veta\n")
yaz("dosyaYaz sonucu: ")
yaz(sonuc)
yaz("\n")

dosyaKapat(fd)
yaz("dosyaKapat: OK\n")

fd2 = dosyaAc("/tmp/veta_test_output.txt", 0)
yaz("yeniden-ac (okuma) fd: ")
yaz(fd2)
yaz("\n")

icerik = dosyaOku(fd2)
yaz("okunan icerik: ")
yaz(icerik)

dosyaKapat(fd2)
yaz("test: dosyaAc/Yaz/Kapat/Oku dongusu tamamlandi\n")
