# araclar.tan — TAN tooling çekirdeği (fonksiyon olarak). Hem tek `tan` binary
# dispatcher (tan.tan) hem bağımsız araçlar (araclar/*.tan) bunu `içe al` eder.
# Kaldıraç 5 (tek toolchain) + Kaldıraç 1 (tooling). Ortak tarama: tanoku.tan.

içe al "kutuphane/tanoku.tan"

# anahtar kelime mi? (simgeler'de üst-seviye değişken tespitinde eleme)
işlev anahtarMiKelime(k)
    anahtarlar = ["yaz", "eğer", "ise", "değilse", "iken", "işlev", "döndür", "son", "her", "içinde", "dur", "devam", "içe", "al", "doğru", "yanlış", "yok", "ve", "veya", "değil", "köprü", "dene", "yakala"]
    her a anahtarlar içinde
        eğer metinEsit(k, a) ise
            döndür doğru
        son
    son
    döndür yanlış
son

# ---- simgeler: sembol listeleyici ----
işlev simgelerAna(yol, json)
    kaynak = oku(yol)
    satirlar = satiraBol(kaynak)

    simgeler = []
    si = 0
    iken si < uzunluk(satirlar)
        satir = satirlar[si]
        b = boslukAtla(satir, 0)
        kelime = kelimeAl(satir, b)

        eğer metinEsit(kelime, "işlev") ise
            adBasla = boslukAtla(satir, b + uzunluk(kelime))
            ad = kelimeAl(satir, adBasla)
            acKonum = karakterBul(satir, "(", adBasla)
            parametreler = ""
            eğer acKonum >= 0 ise
                parametreler = parametreAl(satir, acKonum)
            son
            simgeler = ekle(simgeler, ["işlev", ad, metin(si + 1), parametreler])
        değilse
            eğer b == 0 ise
                esit = karakterBul(satir, "=", 0)
                ad = kelimeAl(satir, 0)
                eğer esit > 0 ve uzunluk(ad) > 0 ve metinAl(ad, 0) != "#" ve anahtarMiKelime(ad) == yanlış ise
                    simgeler = ekle(simgeler, ["değişken", ad, metin(si + 1), ""])
                son
            son
        son
        si = si + 1
    son

    eğer json ise
        cikti = "{\"simgeler\":["
        si = 0
        iken si < uzunluk(simgeler)
            s = simgeler[si]
            eğer si > 0 ise
                cikti = metinBirlestir(cikti, ",")
            son
            cikti = metinBirlestir(cikti, "{\"tur\":\"")
            cikti = metinBirlestir(cikti, s[0])
            cikti = metinBirlestir(cikti, "\",\"ad\":\"")
            cikti = metinBirlestir(cikti, s[1])
            cikti = metinBirlestir(cikti, "\",\"satir\":")
            cikti = metinBirlestir(cikti, s[2])
            eğer metinEsit(s[0], "işlev") ise
                cikti = metinBirlestir(cikti, ",\"parametreler\":\"")
                cikti = metinBirlestir(cikti, s[3])
                cikti = metinBirlestir(cikti, "\"")
            son
            cikti = metinBirlestir(cikti, "}")
            si = si + 1
        son
        cikti = metinBirlestir(cikti, "]}")
        yaz(cikti)
    değilse
        si = 0
        iken si < uzunluk(simgeler)
            s = simgeler[si]
            eğer metinEsit(s[0], "işlev") ise
                cikti = metinBirlestir("işlev ", s[1])
                cikti = metinBirlestir(cikti, "(")
                cikti = metinBirlestir(cikti, s[3])
                cikti = metinBirlestir(cikti, ")")
            değilse
                cikti = metinBirlestir("değişken ", s[1])
            son
            cikti = metinBirlestir(cikti, "  satır ")
            cikti = metinBirlestir(cikti, s[2])
            yaz(cikti)
            si = si + 1
        son
    son
    döndür 0
son

# ---- denetle: blok dengesi linter'ı + STRUCTURED DIAGNOSTICS (Kaldıraç 2) ----
# Tanı kaydı: [kod, önem, satır(metin), mesaj, sebep, çözüm] — AI-native.
# JSON şeması: {"tani":[{"kod","onem","satir","mesaj","sebep","cozum"}]}
işlev denetleAna(yol, json)
    kaynak = oku(yol)
    satirlar = satiraBol(kaynak)

    tanilar = []
    derinlik = 0
    si = 0
    iken si < uzunluk(satirlar)
        satir = satirlar[si]
        b = boslukAtla(satir, 0)
        kelime = kelimeAl(satir, b)

        eğer blokAcici(kelime) ise
            derinlik = derinlik + 1
        değilse
            eğer metinEsit(kelime, "son") ise
                eğer derinlik == 0 ise
                    tanilar = ekle(tanilar, ["TAN001", "hata", metin(si + 1), "eşleşen blok yok, fazladan 'son'", "bu satırdaki 'son' hiçbir açık bloğu (işlev/eğer/iken/her/dene) kapatmıyor", "fazladan 'son' satırını sil ya da eksik blok açıcıyı ekle"])
                değilse
                    derinlik = derinlik - 1
                son
            son
        son
        si = si + 1
    son

    eğer derinlik > 0 ise
        tanilar = ekle(tanilar, ["TAN002", "hata", "0", metinBirlestir(metin(derinlik), " blok kapatılmamış ('son' eksik)"), "blok açıcı (işlev/eğer/iken/her/dene) sayısı 'son' sayısından fazla", metinBirlestir(metin(derinlik), " adet 'son' anahtar kelimesi ekle")])
    son

    eğer json ise
        cikti = "{\"tani\":["
        si = 0
        iken si < uzunluk(tanilar)
            t = tanilar[si]
            eğer si > 0 ise
                cikti = metinBirlestir(cikti, ",")
            son
            cikti = metinBirlestir(cikti, "{\"kod\":\"")
            cikti = metinBirlestir(cikti, t[0])
            cikti = metinBirlestir(cikti, "\",\"onem\":\"")
            cikti = metinBirlestir(cikti, t[1])
            cikti = metinBirlestir(cikti, "\",\"satir\":")
            cikti = metinBirlestir(cikti, t[2])
            cikti = metinBirlestir(cikti, ",\"mesaj\":\"")
            cikti = metinBirlestir(cikti, t[3])
            cikti = metinBirlestir(cikti, "\",\"sebep\":\"")
            cikti = metinBirlestir(cikti, t[4])
            cikti = metinBirlestir(cikti, "\",\"cozum\":\"")
            cikti = metinBirlestir(cikti, t[5])
            cikti = metinBirlestir(cikti, "\"}")
            si = si + 1
        son
        cikti = metinBirlestir(cikti, "]}")
        yaz(cikti)
    değilse
        eğer uzunluk(tanilar) == 0 ise
            yaz("denetim temiz — 0 tanı")
        değilse
            si = 0
            iken si < uzunluk(tanilar)
                t = tanilar[si]
                # satır 1: [KOD] önem  satır N: mesaj
                cikti = metinBirlestir("[", metinBirlestir(t[0], "] "))
                cikti = metinBirlestir(cikti, t[1])
                cikti = metinBirlestir(cikti, "  satır ")
                cikti = metinBirlestir(cikti, t[2])
                cikti = metinBirlestir(cikti, ": ")
                cikti = metinBirlestir(cikti, t[3])
                yaz(cikti)
                yaz(metinBirlestir("  sebep: ", t[4]))
                yaz(metinBirlestir("  çözüm: ", t[5]))
                si = si + 1
            son
        son
    son
    döndür 0
son

# ---- bicimlendir: kanonik formatter ----
işlev bicimlendirAna(yol)
    kaynak = oku(yol)
    satirlar = satiraBol(kaynak)

    derinlik = 0
    si = 0
    iken si < uzunluk(satirlar)
        icerik = kirp(satirlar[si])

        eğer uzunluk(icerik) == 0 ise
            yaz("")
        değilse
            ilk = kelimeAl(icerik, 0)

            eğer metinEsit(ilk, "son") ise
                eğer derinlik > 0 ise
                    derinlik = derinlik - 1
                son
                yaz(metinBirlestir(girinti(derinlik), icerik))
            değilse eğer metinEsit(ilk, "değilse") veya metinEsit(ilk, "yakala") ise
                d2 = derinlik - 1
                eğer d2 < 0 ise
                    d2 = 0
                son
                yaz(metinBirlestir(girinti(d2), icerik))
            değilse eğer blokAcici(ilk) ise
                yaz(metinBirlestir(girinti(derinlik), icerik))
                derinlik = derinlik + 1
            değilse
                yaz(metinBirlestir(girinti(derinlik), icerik))
            son
        son
        si = si + 1
    son
    döndür 0
son
