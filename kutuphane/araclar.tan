# araclar.tan — TAN tooling çekirdeği (fonksiyon olarak). Hem tek `tan` binary
# dispatcher (tan.tan) hem bağımsız araçlar (araclar/*.tan) bunu `içe al` eder.
# Kaldıraç 5 (tek toolchain) + Kaldıraç 1 (tooling). Ortak tarama: tanoku.tan.

içe al "kutuphane/tanoku.tan"
içe al "kutuphane/sha256.tan"
içe al "kutuphane/ag.tan"
içe al "kutuphane/dns.tan"

# metni tam sayıya çevir (rakamlar)
işlev metneTam(s)
    n = uzunluk(s)
    r = 0
    i = 0
    iken i < n
        k = kod(metinAl(s, i))
        eğer k >= 48 ve k <= 57 ise
            r = r * 10 + (k - 48)
        son
        i = i + 1
    son
    döndür r
son

# "127.0.0.1" → [127,0,0,1]
işlev ipParcala(ip)
    parcalar = []
    gecerli = ""
    n = uzunluk(ip)
    i = 0
    iken i < n
        c = metinAl(ip, i)
        eğer c == "." ise
            parcalar = ekle(parcalar, metneTam(gecerli))
            gecerli = ""
        değilse
            gecerli = metinBirlestir(gecerli, c)
        son
        i = i + 1
    son
    döndür ekle(parcalar, metneTam(gecerli))
son

# ---- cek: uzak paketi çek + SHA-256 bütünlük doğrula (Kaldıraç 4 registry) ----
işlev cekAna(ip, portMetin, yol, beklenenSha)
    parca = ipParcala(ip)
    port = metneTam(portMetin)
    yanit = httpGet(parca[0], parca[1], parca[2], parca[3], port, yol)
    eğer uzunluk(yanit) == 0 ise
        yaz("HATA: bağlantı yok ya da boş yanıt")
        döndür 1
    son
    govde = httpGovde(yanit)
    gercek = metinBirlestir("", sha256(govde))
    yaz(metinBirlestir("indirilen sha256: ", gercek))
    eğer metinEsit(beklenenSha, "-") ise
        yaz("--- içerik ---")
        yazHam(metinBirlestir("", govde))
    değilse eğer metinEsit(gercek, beklenenSha) ise
        yaz("[BÜTÜNLÜK TAMAM] paket doğrulandı, kabul edildi")
        yaz("--- içerik ---")
        yazHam(metinBirlestir("", govde))
    değilse
        yaz("[BÜTÜNLÜK BOZUK] sha uyuşmuyor — paket REDDEDİLDİ")
        yaz(metinBirlestir("beklenen: ", beklenenSha))
    son
    döndür 0
son

# dörtlü ip listesini "a.b.c.d" metnine çevirir
işlev ipMetneCevir(ip)
    s = metin(ip[0])
    s = metinBirlestir(s, ".")
    s = metinBirlestir(s, metin(ip[1]))
    s = metinBirlestir(s, ".")
    s = metinBirlestir(s, metin(ip[2]))
    s = metinBirlestir(s, ".")
    s = metinBirlestir(s, metin(ip[3]))
    döndür s
son

# ---- cek-ad: hostname'i GERÇEK DNS (TCP:53) ile çözüp cek'e devreder ----
# NOT (dürüstlük): DNS var, TLS YOK — kaydı düz TCP üzerinden (cekAna gibi)
# çeker. HTTPS/TLS ayrı, çok daha büyük bir iş (el ile TLS handshake riskli).
işlev cekAdAna(ad, portMetin, yol, beklenenSha)
    ip = dnsCoz(ad, 1, 1, 1, 1, 53)
    eğer uzunluk(ip) != 4 ise
        yaz(metinBirlestir("HATA: DNS çözülemedi (1.1.1.1:53 üzerinden): ", ad))
        döndür 1
    son
    ipMetin = ipMetneCevir(ip)
    yaz(metinBirlestir(metinBirlestir("DNS: ", ad), metinBirlestir(" -> ", ipMetin)))
    döndür cekAna(ipMetin, portMetin, yol, beklenenSha)
son

# bir kaynaktaki tüm `içe al "yol"` bağımlılıklarını liste olarak döndürür
işlev iceAlleriBul(kaynak)
    satirlar = satiraBol(kaynak)
    baglar = []
    si = 0
    iken si < uzunluk(satirlar)
        satir = satirlar[si]
        b = boslukAtla(satir, 0)
        eğer metinEsit(kelimeAl(satir, b), "içe") ise
            t1 = karakterBul(satir, "\"", 0)
            eğer t1 >= 0 ise
                t2 = karakterBul(satir, "\"", t1 + 1)
                eğer t2 > t1 ise
                    p = ""
                    j = t1 + 1
                    iken j < t2
                        p = metinBirlestir(p, metinAl(satir, j))
                        j = j + 1
                    son
                    baglar = ekle(baglar, p)
                son
            son
        son
        si = si + 1
    son
    döndür baglar
son

# kaynak oku: yol "-" ise stdin'den, değilse dosyadan (pipe/editör desteği)
işlev kaynakOku(yol)
    eğer metinEsit(yol, "-") ise
        döndür girdiOku()
    son
    döndür oku(yol)
son

# metin listede var mı? (metinEsit ile)
işlev metinListedeVarMi(liste, hedef)
    i = 0
    iken i < uzunluk(liste)
        eğer metinEsit(liste[i], hedef) ise
            döndür doğru
        son
        i = i + 1
    son
    döndür yanlış
son

# anahtar kelime mi? (simgeler'de üst-seviye değişken tespitinde eleme)
işlev anahtarMiKelime(k)
    anahtarlar = ["yaz", "eğer", "ise", "değilse", "iken", "işlev", "döndür", "son", "her", "içinde", "dur", "devam", "içe", "al", "doğru", "yanlış", "yok", "ve", "veya", "değil", "köprü", "dene", "yakala"]
    her a anahtarlar içinde
        eğer metinEsit(k, a) ise
            döndür doğru
        son
    son
    döndür yanlış
son

# ---- simgeler: sembol listeleyici ----
işlev simgelerAna(yol, json)
    kaynak = kaynakOku(yol)
    satirlar = satiraBol(kaynak)

    simgeler = []
    si = 0
    iken si < uzunluk(satirlar)
        satir = satirlar[si]
        b = boslukAtla(satir, 0)
        kelime = kelimeAl(satir, b)

        eğer metinEsit(kelime, "işlev") ise
            adBasla = boslukAtla(satir, b + uzunluk(kelime))
            ad = kelimeAl(satir, adBasla)
            acKonum = karakterBul(satir, "(", adBasla)
            parametreler = ""
            eğer acKonum >= 0 ise
                parametreler = parametreAl(satir, acKonum)
            son
            simgeler = ekle(simgeler, ["işlev", ad, metin(si + 1), parametreler])
        değilse
            eğer b == 0 ise
                esit = karakterBul(satir, "=", 0)
                ad = kelimeAl(satir, 0)
                eğer esit > 0 ve uzunluk(ad) > 0 ve metinAl(ad, 0) != "#" ve anahtarMiKelime(ad) == yanlış ise
                    simgeler = ekle(simgeler, ["değişken", ad, metin(si + 1), ""])
                son
            son
        son
        si = si + 1
    son

    eğer json ise
        cikti = "{\"simgeler\":["
        si = 0
        iken si < uzunluk(simgeler)
            s = simgeler[si]
            eğer si > 0 ise
                cikti = metinBirlestir(cikti, ",")
            son
            cikti = metinBirlestir(cikti, "{\"tur\":\"")
            cikti = metinBirlestir(cikti, s[0])
            cikti = metinBirlestir(cikti, "\",\"ad\":\"")
            cikti = metinBirlestir(cikti, s[1])
            cikti = metinBirlestir(cikti, "\",\"satir\":")
            cikti = metinBirlestir(cikti, s[2])
            eğer metinEsit(s[0], "işlev") ise
                cikti = metinBirlestir(cikti, ",\"parametreler\":\"")
                cikti = metinBirlestir(cikti, s[3])
                cikti = metinBirlestir(cikti, "\"")
            son
            cikti = metinBirlestir(cikti, "}")
            si = si + 1
        son
        cikti = metinBirlestir(cikti, "]}")
        yaz(cikti)
    değilse
        si = 0
        iken si < uzunluk(simgeler)
            s = simgeler[si]
            eğer metinEsit(s[0], "işlev") ise
                cikti = metinBirlestir("işlev ", s[1])
                cikti = metinBirlestir(cikti, "(")
                cikti = metinBirlestir(cikti, s[3])
                cikti = metinBirlestir(cikti, ")")
            değilse
                cikti = metinBirlestir("değişken ", s[1])
            son
            cikti = metinBirlestir(cikti, "  satır ")
            cikti = metinBirlestir(cikti, s[2])
            yaz(cikti)
            si = si + 1
        son
    son
    döndür 0
son

# kimlik karakteri mi? (harf/rakam/_ veya çok-baytlı Türkçe >=128)
işlev kimlikKarMi(c)
    k = kod(c)
    eğer k >= 48 ve k <= 57 ise
        döndür doğru
    son
    eğer k >= 65 ve k <= 90 ise
        döndür doğru
    son
    eğer k >= 97 ve k <= 122 ise
        döndür doğru
    son
    eğer k >= 128 ise
        döndür doğru
    son
    döndür c == "_"
son

# kaynakta 'ad(' whole-word kalıbının kaç kez geçtiğini sayar (tanım satırı dahil).
# Not (bilinen sınır): içParcaLat gibi işlev adını STRING olarak alan dolaylı
# çağrılar bu sayıma girmez — TAN007 o durumda yanlış-pozitif üretebilir, bu
# yüzden "hata" değil "uyarı" seviyesinde.
işlev cagriSayisi(kaynak, ad)
    n = uzunluk(kaynak)
    kn = uzunluk(ad)
    sayi = 0
    i = 0
    iken i < n
        oncekiKimlik = yanlış
        eğer i > 0 ve kimlikKarMi(metinAl(kaynak, i - 1)) ise
            oncekiKimlik = doğru
        son
        eğer kimlikKarMi(metinAl(kaynak, i)) ve oncekiKimlik == yanlış ise
            eslesme = doğru
            j = 0
            iken j < kn
                eğer i + j >= n veya metinAl(kaynak, i + j) != metinAl(ad, j) ise
                    eslesme = yanlış
                son
                j = j + 1
            son
            eğer eslesme ve i + kn < n ve metinAl(kaynak, i + kn) == "(" ise
                sayi = sayi + 1
            son
            iken i < n ve kimlikKarMi(metinAl(kaynak, i))
                i = i + 1
            son
        değilse
            i = i + 1
        son
    son
    döndür sayi
son

# ---- denetle: blok dengesi linter'ı + STRUCTURED DIAGNOSTICS (Kaldıraç 2) ----
# Tanı kaydı: [kod, önem, satır(metin), mesaj, sebep, çözüm] — AI-native.
# JSON şeması: {"tani":[{"kod","onem","satir","mesaj","sebep","cozum"}]}
işlev denetleAna(yol, json)
    kaynak = kaynakOku(yol)
    satirlar = satiraBol(kaynak)

    tanilar = []
    derinlik = 0
    si = 0
    iken si < uzunluk(satirlar)
        satir = satirlar[si]
        b = boslukAtla(satir, 0)
        kelime = kelimeAl(satir, b)

        eğer blokAcici(kelime) ise
            derinlik = derinlik + 1
        değilse
            eğer metinEsit(kelime, "son") ise
                eğer derinlik == 0 ise
                    tanilar = ekle(tanilar, ["TAN001", "hata", metin(si + 1), "eşleşen blok yok, fazladan 'son'", "bu satırdaki 'son' hiçbir açık bloğu (işlev/eğer/iken/her/dene) kapatmıyor", "fazladan 'son' satırını sil ya da eksik blok açıcıyı ekle"])
                değilse
                    derinlik = derinlik - 1
                son
            son
        son

        # TAN003: satır sonu boşluğu (uyarı)
        nsatir = uzunluk(satir)
        eğer nsatir > 0 ve bosMuk(metinAl(satir, nsatir - 1)) ise
            tanilar = ekle(tanilar, ["TAN003", "uyarı", metin(si + 1), "satır sonunda gereksiz boşluk", "satır sonu boşluk/tab diff gürültüsü ve tutarsızlık yaratır", "satır sonu boşluklarını sil (bicimlendir otomatik yapar)"])
        son

        # TAN004: girintide tab (uyarı — TAN 4-boşluk kullanır)
        ti = 0
        tabVar = yanlış
        iken ti < b
            eğer metinAl(satir, ti) == karakter(9) ise
                tabVar = doğru
            son
            ti = ti + 1
        son
        eğer tabVar ise
            tanilar = ekle(tanilar, ["TAN004", "uyarı", metin(si + 1), "girintide tab karakteri", "TAN kanonik girintisi 4 boşluktur; tab tutarsız hizalama yaratır", "tab'ları 4 boşlukla değiştir (bicimlendir otomatik yapar)"])
        son
        si = si + 1
    son

    eğer derinlik > 0 ise
        tanilar = ekle(tanilar, ["TAN002", "hata", "0", metinBirlestir(metin(derinlik), " blok kapatılmamış ('son' eksik)"), "blok açıcı (işlev/eğer/iken/her/dene) sayısı 'son' sayısından fazla", metinBirlestir(metin(derinlik), " adet 'son' anahtar kelimesi ekle")])
    son

    # TAN007: kullanılmayan işlev (tanımlı ama dosya içinde hiç çağrılmıyor)
    si = 0
    iken si < uzunluk(satirlar)
        satir = satirlar[si]
        b = boslukAtla(satir, 0)
        kelime = kelimeAl(satir, b)
        eğer metinEsit(kelime, "işlev") ise
            adBasla = boslukAtla(satir, b + uzunluk(kelime))
            ad = kelimeAl(satir, adBasla)
            eğer uzunluk(ad) > 0 ise
                sayi = cagriSayisi(kaynak, ad)
                eğer sayi <= 1 ise
                    tanilar = ekle(tanilar, ["TAN007", "uyarı", metin(si + 1), metinBirlestir("kullanılmayan işlev: ", ad), "bu işlev dosya içinde başka hiçbir yerden çağrılmıyor (yalnızca tanımı var)", "işlevi kullan, dışa aç (bkz. tan api) ya da ölü kodu sil"])
                son
            son
        son
        si = si + 1
    son

    # TAN008: yinelenen işlev tanımı (aynı ad birden fazla kez tanımlanmış)
    gorulenler = []
    si = 0
    iken si < uzunluk(satirlar)
        satir = satirlar[si]
        b = boslukAtla(satir, 0)
        kelime = kelimeAl(satir, b)
        eğer metinEsit(kelime, "işlev") ise
            adBasla = boslukAtla(satir, b + uzunluk(kelime))
            ad = kelimeAl(satir, adBasla)
            eğer uzunluk(ad) > 0 ise
                eğer metinListedeVarMi(gorulenler, ad) ise
                    tanilar = ekle(tanilar, ["TAN008", "hata", metin(si + 1), metinBirlestir("yinelenen işlev tanımı: ", ad), "aynı isimde birden fazla işlev tanımlanmış; sonraki tanım öncekini gölgeler, derleyici hangi tanımı kullanacağını belirsizleştirir", "işlevlerden birini yeniden adlandır ya da sil"])
                değilse
                    gorulenler = ekle(gorulenler, ad)
                son
            son
        son
        si = si + 1
    son

    # TAN009: kullanılmayan yerel değişken (bir işlev gövdesinde tanımlanmış
    # ama gövde metninde tam olarak bir kez geçiyor — yalnızca kendi ataması)
    si = 0
    iken si < uzunluk(satirlar)
        satir = satirlar[si]
        b = boslukAtla(satir, 0)
        kelime = kelimeAl(satir, b)
        eğer b == 0 ve metinEsit(kelime, "işlev") ise
            bitisIslev = islevSonu(satirlar, si)
            govdeMetni = ""
            gi = si + 1
            iken gi < bitisIslev
                govdeMetni = metinBirlestir(govdeMetni, metinBirlestir(satirlar[gi], "\n"))
                gi = gi + 1
            son
            gorulenYerel = []
            gi = si + 1
            iken gi < bitisIslev
                gsatir = satirlar[gi]
                gb = boslukAtla(gsatir, 0)
                esit = karakterBul(gsatir, "=", gb)
                eğer esit > gb ise
                    aday = kirp(kelimeAl(gsatir, gb))
                    eğer uzunluk(aday) > 0 ve metinListedeVarMi(gorulenYerel, aday) == yanlış ve anahtarMiKelime(aday) == yanlış ise
                        gorulenYerel = ekle(gorulenYerel, aday)
                        eğer kelimeSayisiMetinde(govdeMetni, aday) == 1 ise
                            tanilar = ekle(tanilar, ["TAN009", "uyarı", metin(gi + 1), metinBirlestir("kullanılmayan yerel değişken: ", aday), "bu değişken atandıktan sonra işlev gövdesinde bir daha hiç okunmuyor", "değişkeni kullan ya da gereksiz atamayı sil"])
                        son
                    son
                son
                gi = gi + 1
            son
        son
        si = si + 1
    son

    eğer json ise
        cikti = "{\"tani\":["
        si = 0
        iken si < uzunluk(tanilar)
            t = tanilar[si]
            eğer si > 0 ise
                cikti = metinBirlestir(cikti, ",")
            son
            cikti = metinBirlestir(cikti, "{\"kod\":\"")
            cikti = metinBirlestir(cikti, t[0])
            cikti = metinBirlestir(cikti, "\",\"onem\":\"")
            cikti = metinBirlestir(cikti, t[1])
            cikti = metinBirlestir(cikti, "\",\"satir\":")
            cikti = metinBirlestir(cikti, t[2])
            cikti = metinBirlestir(cikti, ",\"mesaj\":\"")
            cikti = metinBirlestir(cikti, t[3])
            cikti = metinBirlestir(cikti, "\",\"sebep\":\"")
            cikti = metinBirlestir(cikti, t[4])
            cikti = metinBirlestir(cikti, "\",\"cozum\":\"")
            cikti = metinBirlestir(cikti, t[5])
            cikti = metinBirlestir(cikti, "\"}")
            si = si + 1
        son
        cikti = metinBirlestir(cikti, "]}")
        yaz(cikti)
    değilse
        eğer uzunluk(tanilar) == 0 ise
            yaz("denetim temiz — 0 tanı")
        değilse
            si = 0
            iken si < uzunluk(tanilar)
                t = tanilar[si]
                # satır 1: [KOD] önem  satır N: mesaj
                cikti = metinBirlestir("[", metinBirlestir(t[0], "] "))
                cikti = metinBirlestir(cikti, t[1])
                cikti = metinBirlestir(cikti, "  satır ")
                cikti = metinBirlestir(cikti, t[2])
                cikti = metinBirlestir(cikti, ": ")
                cikti = metinBirlestir(cikti, t[3])
                yaz(cikti)
                yaz(metinBirlestir("  sebep: ", t[4]))
                yaz(metinBirlestir("  çözüm: ", t[5]))
                si = si + 1
            son
        son
    son
    döndür 0
son

# ---- api: dışa-açık işlev imzaları (Kaldıraç 1) ----
işlev apiAna(yol, json)
    kaynak = kaynakOku(yol)
    satirlar = satiraBol(kaynak)
    imzalar = []
    si = 0
    iken si < uzunluk(satirlar)
        satir = satirlar[si]
        b = boslukAtla(satir, 0)
        eğer b == 0 ise
            kelime = kelimeAl(satir, 0)
            eğer metinEsit(kelime, "işlev") ise
                adBasla = boslukAtla(satir, uzunluk(kelime))
                ad = kelimeAl(satir, adBasla)
                acKonum = karakterBul(satir, "(", adBasla)
                parametreler = ""
                eğer acKonum >= 0 ise
                    parametreler = parametreAl(satir, acKonum)
                son
                imzalar = ekle(imzalar, [ad, parametreler])
            son
        son
        si = si + 1
    son

    eğer json ise
        cikti = "{\"api\":["
        si = 0
        iken si < uzunluk(imzalar)
            im = imzalar[si]
            eğer si > 0 ise
                cikti = metinBirlestir(cikti, ",")
            son
            cikti = metinBirlestir(cikti, "{\"ad\":\"")
            cikti = metinBirlestir(cikti, im[0])
            cikti = metinBirlestir(cikti, "\",\"parametreler\":\"")
            cikti = metinBirlestir(cikti, im[1])
            cikti = metinBirlestir(cikti, "\"}")
            si = si + 1
        son
        cikti = metinBirlestir(cikti, "]}")
        yaz(cikti)
    değilse
        si = 0
        iken si < uzunluk(imzalar)
            im = imzalar[si]
            cikti = metinBirlestir("işlev ", metinBirlestir(im[0], metinBirlestir("(", metinBirlestir(im[1], ")"))))
            yaz(cikti)
            si = si + 1
        son
    son
    döndür 0
son

# ---- bagimlilik: içe al grafiği (Kaldıraç 1) ----
işlev bagimlilikAna(yol, json)
    baglar = iceAlleriBul(oku(yol))

    eğer json ise
        cikti = "{\"bagimliliklar\":["
        si = 0
        iken si < uzunluk(baglar)
            eğer si > 0 ise
                cikti = metinBirlestir(cikti, ",")
            son
            cikti = metinBirlestir(cikti, "\"")
            cikti = metinBirlestir(cikti, baglar[si])
            cikti = metinBirlestir(cikti, "\"")
            si = si + 1
        son
        cikti = metinBirlestir(cikti, "]}")
        yaz(cikti)
    değilse
        eğer uzunluk(baglar) == 0 ise
            yaz("(bağımlılık yok)")
        değilse
            si = 0
            iken si < uzunluk(baglar)
                yaz(metinBirlestir("içe al ", baglar[si]))
                si = si + 1
            son
        son
    son
    döndür 0
son

# ---- kilit: içerik-adresli lockfile (Kaldıraç 3) ----
# Hedef dosya + TÜM transitive içe al bağımlılıklarının özetini (hash) üretir.
# Deterministik build/bütünlük için. Şema: {"kilit":[{"yol","ozet"}]}
işlev kilitAna(yol, json)
    kuyruk = [yol]
    gorulen = []
    kayitlar = []
    ki = 0
    iken ki < uzunluk(kuyruk)
        aktif = kuyruk[ki]
        ki = ki + 1
        eğer metinListedeVarMi(gorulen, aktif) == yanlış ise
            gorulen = ekle(gorulen, aktif)
            kaynak = oku(aktif)
            kayitlar = ekle(kayitlar, [aktif, metinBirlestir("", sha256(kaynak))])
            depler = iceAlleriBul(kaynak)
            di = 0
            iken di < uzunluk(depler)
                kuyruk = ekle(kuyruk, depler[di])
                di = di + 1
            son
        son
    son

    eğer json ise
        cikti = "{\"kilit\":["
        ki = 0
        iken ki < uzunluk(kayitlar)
            k = kayitlar[ki]
            eğer ki > 0 ise
                cikti = metinBirlestir(cikti, ",")
            son
            cikti = metinBirlestir(cikti, "{\"yol\":\"")
            cikti = metinBirlestir(cikti, k[0])
            cikti = metinBirlestir(cikti, "\",\"ozet\":")
            cikti = metinBirlestir(cikti, k[1])
            cikti = metinBirlestir(cikti, "}")
            ki = ki + 1
        son
        cikti = metinBirlestir(cikti, "]}")
        yaz(cikti)
    değilse
        ki = 0
        iken ki < uzunluk(kayitlar)
            k = kayitlar[ki]
            yaz(metinBirlestir(k[1], metinBirlestir("  ", k[0])))
            ki = ki + 1
        son
    son
    döndür 0
son

# lockfile içeriğini (düz "sha  yol\n"...) metin olarak üretir
işlev kilitIcerik(yol)
    kuyruk = [yol]
    gorulen = []
    icerik = ""
    ki = 0
    iken ki < uzunluk(kuyruk)
        aktif = kuyruk[ki]
        ki = ki + 1
        eğer metinListedeVarMi(gorulen, aktif) == yanlış ise
            gorulen = ekle(gorulen, aktif)
            kaynak = oku(aktif)
            satirBir = metinBirlestir(metinBirlestir("", sha256(kaynak)), metinBirlestir("  ", metinBirlestir(aktif, karakter(10))))
            icerik = metinBirlestir(icerik, satirBir)
            depler = iceAlleriBul(kaynak)
            di = 0
            iken di < uzunluk(depler)
                kuyruk = ekle(kuyruk, depler[di])
                di = di + 1
            son
        son
    son
    döndür icerik
son

# ---- kilityaz: lockfile'ı <yol>.kilit dosyasına yaz (Kaldıraç 3) ----
işlev kilitYazAna(yol)
    icerik = kilitIcerik(yol)
    hedef = metinBirlestir(yol, ".kilit")
    d = yazDosya(hedef, icerik)
    yaz(metinBirlestir("lockfile yazıldı: ", hedef))
    döndür 0
son

# ---- dogrula: lockfile'a karşı bütünlük kontrolü (Kaldıraç 4) ----
# `tan kilit X > X.kilit` ile üretilen düz lockfile'ı okur, her dosyayı yeniden
# hash'ler, beklenen==gerçek karşılaştırır. Tampering/drift tespiti (madde 29).
işlev dogrulaAna(kilitYol)
    kaynak = oku(kilitYol)
    satirlar = satiraBol(kaynak)
    toplam = 0
    tamam = 0
    si = 0
    iken si < uzunluk(satirlar)
        satir = satirlar[si]
        eğer uzunluk(kirp(satir)) > 0 ise
            beklenenOzet = kelimeAl(satir, 0)
            yolBasla = uzunluk(beklenenOzet) + 2
            dyol = ""
            j = yolBasla
            iken j < uzunluk(satir)
                dyol = metinBirlestir(dyol, metinAl(satir, j))
                j = j + 1
            son
            gercekOzet = metinBirlestir("", sha256(oku(dyol)))
            toplam = toplam + 1
            eğer metinEsit(beklenenOzet, gercekOzet) ise
                tamam = tamam + 1
                yaz(metinBirlestir("  [TAMAM] ", dyol))
            değilse
                yaz(metinBirlestir("  [DEGISTI] ", dyol))
                yaz(metinBirlestir("    beklenen: ", beklenenOzet))
                yaz(metinBirlestir("    gercek  : ", gercekOzet))
            son
        son
        si = si + 1
    son
    yaz("")
    eğer tamam == toplam ise
        yaz(metinBirlestir("BÜTÜNLÜK TAMAM: ", metinBirlestir(metin(toplam), " dosya değişmemiş")))
    değilse
        yaz(metinBirlestir("BÜTÜNLÜK BOZUK: ", metinBirlestir(metin(toplam - tamam), " dosya değişmiş")))
    son
    döndür 0
son

# ---- onbellek: içerik-adresli önbellek deposu (Kaldıraç 3 — uzak cache) ----
# Yerel yarım: dosyayı sha256'siyle adresli tek bir dizine yazar/okur (CAS).
# Uzak yarım: aynı dizin `registrys <port>` ile servis edilir, başka bir
# makineden `tan cek <ip> <port> <hash> <hash>` ile GERÇEK TCP üzerinden
# çekilip kendi hash'ine karşı doğrulanır — yani "uzak cache" = bu CAS dizini
# + zaten var olan registry client/server ikilisinin bileşimi (yeni ağ kodu
# icat edilmedi, kanıtlı TCP altyapısı yeniden kullanıldı).

# dosyayı onbellekDizin/<sha256> olarak yazar (zaten varsa dokunmaz — CAS
# doğası gereği içerik==adres, tekrar yazmaya gerek yok). Hash'i döndürür.
işlev onbellekYazAna(dosyaYolu, onbellekDizin)
    icerik = oku(dosyaYolu)
    hash = metinBirlestir("", sha256(icerik))
    hedef = metinBirlestir(onbellekDizin, metinBirlestir("/", hash))
    eğer dosyaVarMi(hedef) ise
        yaz(metinBirlestir("[ONBELLEKTE VAR] ", hash))
    değilse
        d = yazDosya(hedef, icerik)
        yaz(metinBirlestir("[ONBELLEGE YAZILDI] ", hash))
    son
    yaz(metinBirlestir("  onbellek yolu: ", hedef))
    döndür 0
son

# onbellekDizin/<hash>'i okuyup hedefYol'a yazar (hedefYol "-" ise stdout'a
# ham basar). İçeriği tekrar hashleyip istenen hash'le eşleştiğini doğrular
# (yerel CAS için de bütünlük garantisi — bozuk/yanlış dosya sessizce kabul
# edilmez).
işlev onbellekAlAna(hash, onbellekDizin, hedefYol)
    kaynakYol = metinBirlestir(onbellekDizin, metinBirlestir("/", hash))
    eğer dosyaVarMi(kaynakYol) == yanlış ise
        yaz(metinBirlestir("[ONBELLEKTE YOK] ", hash))
        döndür 1
    son
    icerik = oku(kaynakYol)
    gercekHash = metinBirlestir("", sha256(icerik))
    eğer metinEsit(gercekHash, hash) == yanlış ise
        yaz("[ONBELLEK BOZUK] içerik istenen hash'le eşleşmiyor")
        yaz(metinBirlestir("  istenen: ", hash))
        yaz(metinBirlestir("  gerçek : ", gercekHash))
        döndür 1
    son
    eğer metinEsit(hedefYol, "-") ise
        yazHam(metinBirlestir("", icerik))
    değilse
        d = yazDosya(hedefYol, icerik)
        yaz(metinBirlestir("[ONBELLEKTEN ALINDI] ", hedefYol))
    son
    döndür 0
son

# ---- ast: yapısal ayrıştırma ağacı (Kaldıraç 1) ----
işlev astTur(kelime, satir, b)
    eğer blokAcici(kelime) ise
        döndür kelime
    son
    eğer metinEsit(kelime, "son") veya metinEsit(kelime, "değilse") veya metinEsit(kelime, "döndür") veya metinEsit(kelime, "yaz") veya metinEsit(kelime, "dur") veya metinEsit(kelime, "devam") veya metinEsit(kelime, "yakala") veya metinEsit(kelime, "içe") ise
        döndür kelime
    son
    eğer b == 0 ve karakterBul(satir, "=", 0) > 0 ise
        döndür "atama"
    son
    döndür "ifade"
son

işlev astAna(yol, json)
    kaynak = kaynakOku(yol)
    satirlar = satiraBol(kaynak)
    dugumler = []
    derinlik = 0
    si = 0
    iken si < uzunluk(satirlar)
        satir = satirlar[si]
        b = boslukAtla(satir, 0)
        icerik = kirp(satir)
        eğer uzunluk(icerik) > 0 ve metinAl(icerik, 0) != "#" ise
            kelime = kelimeAl(satir, b)
            d = derinlik
            eğer metinEsit(kelime, "son") veya metinEsit(kelime, "değilse") veya metinEsit(kelime, "yakala") ise
                eğer d > 0 ise
                    d = d - 1
                son
            son
            tur = astTur(kelime, satir, b)
            dugumler = ekle(dugumler, [d, tur, si + 1])
            eğer blokAcici(kelime) ise
                derinlik = derinlik + 1
            son
            eğer metinEsit(kelime, "son") ise
                eğer derinlik > 0 ise
                    derinlik = derinlik - 1
                son
            son
        son
        si = si + 1
    son

    eğer json ise
        cikti = "{\"ast\":["
        i = 0
        iken i < uzunluk(dugumler)
            dg = dugumler[i]
            eğer i > 0 ise
                cikti = metinBirlestir(cikti, ",")
            son
            cikti = metinBirlestir(cikti, "{\"derinlik\":")
            cikti = metinBirlestir(cikti, metin(dg[0]))
            cikti = metinBirlestir(cikti, ",\"tur\":\"")
            cikti = metinBirlestir(cikti, dg[1])
            cikti = metinBirlestir(cikti, "\",\"satir\":")
            cikti = metinBirlestir(cikti, metin(dg[2]))
            cikti = metinBirlestir(cikti, "}")
            i = i + 1
        son
        cikti = metinBirlestir(cikti, "]}")
        yaz(cikti)
    değilse
        i = 0
        iken i < uzunluk(dugumler)
            dg = dugumler[i]
            yaz(metinBirlestir(girinti(dg[0]), dg[1]))
            i = i + 1
        son
    son
    döndür 0
son

# ---- olcum: kod metrikleri (satır/işlev/derinlik) — K5/gözlemlenebilirlik ----
işlev olcumAna(yol, json)
    kaynak = kaynakOku(yol)
    satirlar = satiraBol(kaynak)
    toplamSatir = uzunluk(satirlar)
    doluSatir = 0
    yorumSatir = 0
    islevSayisi = 0
    maksDerinlik = 0
    derinlik = 0
    enUzunIslev = 0
    aktifIslevSatir = 0
    islevIcinde = yanlış

    si = 0
    iken si < uzunluk(satirlar)
        satir = satirlar[si]
        b = boslukAtla(satir, 0)
        icerik = kirp(satir)
        eğer uzunluk(icerik) > 0 ise
            doluSatir = doluSatir + 1
            eğer metinAl(icerik, 0) == "#" ise
                yorumSatir = yorumSatir + 1
            son
            kelime = kelimeAl(satir, b)
            eğer metinEsit(kelime, "işlev") ise
                islevSayisi = islevSayisi + 1
                islevIcinde = doğru
                aktifIslevSatir = 0
            son
            eğer islevIcinde ise
                aktifIslevSatir = aktifIslevSatir + 1
            son
            eğer blokAcici(kelime) ise
                derinlik = derinlik + 1
                eğer derinlik > maksDerinlik ise
                    maksDerinlik = derinlik
                son
            son
            eğer metinEsit(kelime, "son") ise
                eğer derinlik > 0 ise
                    derinlik = derinlik - 1
                son
                eğer derinlik == 0 ve islevIcinde ise
                    eğer aktifIslevSatir > enUzunIslev ise
                        enUzunIslev = aktifIslevSatir
                    son
                    islevIcinde = yanlış
                son
            son
        son
        si = si + 1
    son

    eğer json ise
        cikti = "{\"toplamSatir\":"
        cikti = metinBirlestir(cikti, metin(toplamSatir))
        cikti = metinBirlestir(cikti, ",\"doluSatir\":")
        cikti = metinBirlestir(cikti, metin(doluSatir))
        cikti = metinBirlestir(cikti, ",\"yorumSatir\":")
        cikti = metinBirlestir(cikti, metin(yorumSatir))
        cikti = metinBirlestir(cikti, ",\"islevSayisi\":")
        cikti = metinBirlestir(cikti, metin(islevSayisi))
        cikti = metinBirlestir(cikti, ",\"maksDerinlik\":")
        cikti = metinBirlestir(cikti, metin(maksDerinlik))
        cikti = metinBirlestir(cikti, ",\"enUzunIslev\":")
        cikti = metinBirlestir(cikti, metin(enUzunIslev))
        cikti = metinBirlestir(cikti, "}")
        yaz(cikti)
    değilse
        yaz(metinBirlestir("toplam satır : ", metin(toplamSatir)))
        yaz(metinBirlestir("dolu satır   : ", metin(doluSatir)))
        yaz(metinBirlestir("yorum satır  : ", metin(yorumSatir)))
        yaz(metinBirlestir("işlev sayısı : ", metin(islevSayisi)))
        yaz(metinBirlestir("maks derinlik: ", metin(maksDerinlik)))
        yaz(metinBirlestir("en uzun işlev: ", metinBirlestir(metin(enUzunIslev), " satır")))
    son
    döndür 0
son

# ---- imzala: dosyayı HMAC-SHA256 ile imzala (Kaldıraç 4: imzalı registry) ----
işlev imzalaAna(yol, anahtar)
    yaz(metinBirlestir("", hmacSha256(anahtar, oku(yol))))
    döndür 0
son

# ---- imzadogrula: imzayı doğrula ----
işlev imzaDogrulaAna(yol, anahtar, beklenen)
    gercek = metinBirlestir("", hmacSha256(anahtar, oku(yol)))
    eğer metinEsit(gercek, beklenen) ise
        yaz(metinBirlestir("[GEÇERLİ] imza doğru — ", yol))
    değilse
        yaz(metinBirlestir("[GEÇERSİZ] imza uyuşmuyor — ", yol))
        yaz(metinBirlestir("  beklenen: ", beklenen))
        yaz(metinBirlestir("  gerçek  : ", gercek))
    son
    döndür 0
son

# ---- sürüm ----
işlev surumAna()
    yaz("TAN toolchain — self-hosted (sıfır Go)")
    yaz("araçlar: simgeler api bagimlilik ast denetle bicimlendir kilit dogrula")
    yaz("özet: SHA-256 (kriptografik)")
    döndür 0
son

# ---- bicimlendir: kanonik formatter ----
# kaynağı biçimlendirir, sonucu satır satır "\n" ile birleştirilmiş metin olarak
# döndürür (yazdırmaz) — LSP formatting gibi yazıcıya değil string'e ihtiyaç
# duyan çağıranlar için.
işlev bicimlendirMetin(kaynak)
    satirlar = satiraBol(kaynak)

    sonuc = ""
    ilkSatirMi = doğru
    derinlik = 0
    si = 0
    iken si < uzunluk(satirlar)
        icerik = kirp(satirlar[si])

        eğer ilkSatirMi == yanlış ise
            sonuc = metinBirlestir(sonuc, "\n")
        son
        ilkSatirMi = yanlış

        eğer uzunluk(icerik) == 0 ise
            sonuc = metinBirlestir(sonuc, "")
        değilse
            ilk = kelimeAl(icerik, 0)

            eğer metinEsit(ilk, "son") ise
                eğer derinlik > 0 ise
                    derinlik = derinlik - 1
                son
                sonuc = metinBirlestir(sonuc, metinBirlestir(girinti(derinlik), icerik))
            değilse eğer metinEsit(ilk, "değilse") veya metinEsit(ilk, "yakala") ise
                d2 = derinlik - 1
                eğer d2 < 0 ise
                    d2 = 0
                son
                sonuc = metinBirlestir(sonuc, metinBirlestir(girinti(d2), icerik))
            değilse eğer blokAcici(ilk) ise
                sonuc = metinBirlestir(sonuc, metinBirlestir(girinti(derinlik), icerik))
                derinlik = derinlik + 1
            değilse
                sonuc = metinBirlestir(sonuc, metinBirlestir(girinti(derinlik), icerik))
            son
        son
        si = si + 1
    son
    döndür sonuc
son

işlev bicimlendirAna(yol)
    kaynak = kaynakOku(yol)
    # TancElf tip-izleme sınırı: kullanıcı işlevinin string dönüşü doğrudan
    # yaz()'a verilirse pointer sayı sanılır — metinBirlestir ile string
    # bağlamına al (bkz. sha256() için aynı desen, kutuphane/sha256.tan).
    yaz(metinBirlestir("", bicimlendirMetin(kaynak)))
    döndür 0
son
