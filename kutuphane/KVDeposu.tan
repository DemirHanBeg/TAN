# ============================================================
# KVDeposu.tan — anahtar/değer (Object Store) deposu (saf Tan)
# ------------------------------------------------------------
# BAgaci.tan (sıralı erişim + aralık tarama gerektiğinde) ile aynı işi
# görmez — bu modül SIRASIZ, O(1) beklenen erişimli düz bir sözlük
# üzerine kurulu, anahtar VE değer METİN. Sıralama/aralık tarama
# GEREKMEYEN durumlar için (konfigürasyon, oturum, meta veri, cache) daha
# basit ve daha az kod.
#
# Aynı kısıtlar (bkz. BAgaci.tan): global mutasyon yok -> sözlük/kutu
# yerinde mutasyon; rastgele dosya erişimi yok -> ekleme-öncelikli WAL.
#
# Kullanım:
#   içe al "kutuphane/KVDeposu.tan"
#   kvAyarla("ayarlar.kv")
#   kvKoy("tema", "koyu")
#   yaz(kvAl("tema"))          # koyu
#   yaz(kvVarMi("yok-boyle"))  # 0
# ============================================================

kKvVeri = sözlük()
kKvWalYolu = [""]

işlev kvAyarla(walYolu)
    kKvWalYolu[0] = walYolu
son

# --- WAL'a yazmadan koy (replay sırasında kullanılır) ---
işlev kvKoySessiz(anahtar, deger)
    kKvVeri[anahtar] = deger
son

işlev kvKoy(anahtar, deger)
    kKvVeri[anahtar] = deger
    eğer değil metinEsit(kKvWalYolu[0], "") ise
        ekle_dosya(kKvWalYolu[0], "K " + anahtar + " " + deger + "\n")
    son
son

işlev kvAl(anahtar)
    eğer değil varMı(kKvVeri, anahtar) ise
        döndür ""
    son
    döndür kKvVeri[anahtar]
son

işlev kvVarMi(anahtar)
    döndür varMı(kKvVeri, anahtar)
son

işlev kvSil(anahtar)
    bulunduMu = sil(kKvVeri, anahtar)
    eğer bulunduMu ve değil metinEsit(kKvWalYolu[0], "") ise
        ekle_dosya(kKvWalYolu[0], "S " + anahtar + "\n")
    son
    döndür bulunduMu
son

işlev kvAnahtarlar()
    döndür anahtarlar(kKvVeri)
son

# --- WAL dosyasından deposu yeniden kurar ---
işlev kvYukle()
    eğer değil dosyaVarMi(kKvWalYolu[0]) ise
        döndür 0
    son
    icerik = oku(kKvWalYolu[0])
    satirlar = parçala(icerik, "\n")
    i = 0
    iken i < uzunluk(satirlar)
        gunlukSatiri = satirlar[i]
        eğer uzunluk(gunlukSatiri) > 0 ise
            ilkBosluk = 0 - 1
            j = 0
            iken j < uzunluk(gunlukSatiri) ve ilkBosluk == 0 - 1
                eğer gunlukSatiri[j] == " " ise
                    ilkBosluk = j
                son
                j = j + 1
            son
            tur = metinAl(gunlukSatiri, 0)
            eğer tur == "K" ise
                kalan = kvAraligiAl(gunlukSatiri, ilkBosluk + 1)
                ikinciBosluk = 0 - 1
                j = 0
                iken j < uzunluk(kalan) ve ikinciBosluk == 0 - 1
                    eğer kalan[j] == " " ise
                        ikinciBosluk = j
                    son
                    j = j + 1
                son
                anahtar = kvAraligiAl2(kalan, 0, ikinciBosluk)
                deger = kvAraligiAl(kalan, ikinciBosluk + 1)
                kvKoySessiz(anahtar, deger)
            değilse eğer tur == "S" ise
                anahtar = kvAraligiAl(gunlukSatiri, ilkBosluk + 1)
                sil(kKvVeri, anahtar)
            son
        son
        i = i + 1
    son
    döndür 1
son

işlev kvAraligiAl(metin, bas)
    döndür kvAraligiAl2(metin, bas, uzunluk(metin))
son

işlev kvAraligiAl2(metin, bas, sonIndeks)
    sonuc = ""
    i = bas
    iken i < sonIndeks
        sonuc = sonuc + metin[i]
        i = i + 1
    son
    döndür sonuc
son
