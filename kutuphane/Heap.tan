# ============================================================
# Heap.tan — ekleme-öncelikli satır deposu (saf Tan)
# ------------------------------------------------------------
# BAgaci.tan (B+Ağacı indeks) ile eşleşir: B+Ağacı anahtar->rowId eşler,
# Heap rowId->satır (serbest metin) tutar. İkisi birlikte "Row Store"
# (Katman 1) oluşturur.
#
# AYNI KISITLAR (bkz. BAgaci.tan başlığı, tekrar etmiyorum — özet):
#   struct yok -> yapı-dizisi; global mutasyon yok -> sözlük/kutu yerinde
#   mutasyon; rastgele dosya erişimi yok -> ekleme-öncelikli WAL + replay.
#
# Satır TEK BİR METİN olarak saklanır (alanları nasıl paketlediğin sana
# kalmış — satirPack()/satirUnpack() '|' ayraçlı basit bir yardımcı verir,
# alan içinde '|' veya '\n' OLMAMALI, bu bir kayıt/sıkıştırma katmanı
# DEĞİL, öyle bir varsayım yok).
#
# Kullanım:
#   içe al "kutuphane/Heap.tan"
#   heapAyarla("veri.heap")
#   id = heapEkle(satirPack(["ali", "30", "istanbul"]))
#   yaz(satirUnpack(heapOku(id)))
# ============================================================

kSatirlar = sözlük()
kSatirSayaci = [0]
kHeapWalYolu = [""]

işlev heapAyarla(walYolu)
    kHeapWalYolu[0] = walYolu
son

# --- satır paketleme: liste-of-metin -> tek metin ('|' ayraçlı) ---
işlev satirPack(alanlar)
    sonuc = ""
    i = 0
    iken i < uzunluk(alanlar)
        eğer i > 0 ise
            sonuc = sonuc + "|"
        son
        sonuc = sonuc + alanlar[i]
        i = i + 1
    son
    döndür sonuc
son

işlev satirUnpack(satir)
    döndür parçala(satir, "|")
son

# --- WAL'a yazmadan ekle (replay sırasında kullanılır) ---
işlev heapEkleSessiz(rowId, satir)
    kSatirlar[rowId] = satir
    eğer rowId >= kSatirSayaci[0] ise
        kSatirSayaci[0] = rowId + 1
    son
son

# --- yeni satır ekler, rowId döndürür ---
işlev heapEkle(satir)
    id = kSatirSayaci[0]
    kSatirlar[id] = satir
    kSatirSayaci[0] = id + 1
    eğer metinEsit(kHeapWalYolu[0], "") == 0 ise
        ekle_dosya(kHeapWalYolu[0], "R " + metin(id) + " " + satir + "\n")
    son
    döndür id
son

# --- rowId'nin satırını okur, yoksa "" döndürür ---
işlev heapOku(rowId)
    eğer varMı(kSatirlar, rowId) == 0 ise
        döndür ""
    son
    döndür kSatirlar[rowId]
son

# --- rowId'yi siler (WAL'a "S rowId" yazar) ---
işlev heapSil(rowId)
    bulunduMu = sil(kSatirlar, rowId)
    eğer bulunduMu == 1 ve metinEsit(kHeapWalYolu[0], "") == 0 ise
        ekle_dosya(kHeapWalYolu[0], "S " + metin(rowId) + "\n")
    son
    döndür bulunduMu
son

# --- WAL dosyasından heap'i yeniden kurar ---
işlev heapYukle()
    eğer dosyaVarMi(kHeapWalYolu[0]) == 0 ise
        döndür 0
    son
    icerik = oku(kHeapWalYolu[0])
    satirlar = parçala(icerik, "\n")
    i = 0
    iken i < uzunluk(satirlar)
        gunlukSatiri = satirlar[i]
        eğer uzunluk(gunlukSatiri) > 0 ise
            ilkBosluk = 0 - 1
            j = 0
            iken j < uzunluk(gunlukSatiri) ve ilkBosluk == 0 - 1
                eğer gunlukSatiri[j] == " " ise
                    ilkBosluk = j
                son
                j = j + 1
            son
            tur = metinAl(gunlukSatiri, 0)
            eğer tur == "R" ise
                kalan = araligiAl(gunlukSatiri, ilkBosluk + 1)
                ikinciBosluk = 0 - 1
                j = 0
                iken j < uzunluk(kalan) ve ikinciBosluk == 0 - 1
                    eğer kalan[j] == " " ise
                        ikinciBosluk = j
                    son
                    j = j + 1
                son
                rowId = sayı(araligiAl2(kalan, 0, ikinciBosluk))
                satirIcerik = araligiAl(kalan, ikinciBosluk + 1)
                heapEkleSessiz(rowId, satirIcerik)
            değilse eğer tur == "S" ise
                kalan = araligiAl(gunlukSatiri, ilkBosluk + 1)
                rowId = sayı(kalan)
                sil(kSatirlar, rowId)
            son
        son
        i = i + 1
    son
    döndür 1
son

# --- yardımcı: metin[bas..] (sona kadar) ---
işlev araligiAl(metin, bas)
    döndür araligiAl2(metin, bas, uzunluk(metin))
son

# --- yardımcı: metin[bas, sonIndeks) ---
işlev araligiAl2(metin, bas, sonIndeks)
    sonuc = ""
    i = bas
    iken i < sonIndeks
        sonuc = sonuc + metin[i]
        i = i + 1
    son
    döndür sonuc
son
