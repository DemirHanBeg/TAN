# tanoku.tan — TAN kaynak-tarama ortak yardımcıları (tooling paylaşımlı modülü).
# simgeler / denetle / bicimlendir ve gelecekteki LSP bunu `içe al` ile kullanır.
# DRY: tek tokenizer/tarama çekirdeği (Go'da her araç kendi parser'ını yazıyordu).
# Doğrulanmış yerleşikler: uzunluk, metinAl, metinBirlestir, karakter, metinEsit, ekle.

# boşluk/tab mı?
işlev bosMuk(c)
    döndür c == " " veya c == karakter(9)
son

# kaynağı "\n" ile satırlara böler
işlev satiraBol(kaynak)
    satirlar = []
    gecerli = ""
    n = uzunluk(kaynak)
    i = 0
    iken i < n
        c = metinAl(kaynak, i)
        eğer c == "\n" ise
            satirlar = ekle(satirlar, gecerli)
            gecerli = ""
        değilse
            gecerli = metinBirlestir(gecerli, c)
        son
        i = i + 1
    son
    eğer uzunluk(gecerli) > 0 ise
        satirlar = ekle(satirlar, gecerli)
    son
    döndür satirlar
son

# basla'dan ilk boş olmayan indeksi döndürür
işlev boslukAtla(satir, basla)
    n = uzunluk(satir)
    i = basla
    iken i < n ve bosMuk(metinAl(satir, i))
        i = i + 1
    son
    döndür i
son

# basla'dan durucuya (boşluk, "(", "=") kadar kelime okur
işlev kelimeAl(satir, basla)
    n = uzunluk(satir)
    kelime = ""
    i = basla
    iken i < n
        c = metinAl(satir, i)
        eğer bosMuk(c) veya c == "(" veya c == "=" ise
            dur
        son
        kelime = metinBirlestir(kelime, c)
        i = i + 1
    son
    döndür kelime
son

# "(" indeksinden ")" e kadar parametre metni
işlev parametreAl(satir, acKonum)
    n = uzunluk(satir)
    icerik = ""
    i = acKonum + 1
    iken i < n
        c = metinAl(satir, i)
        eğer c == ")" ise
            dur
        son
        icerik = metinBirlestir(icerik, c)
        i = i + 1
    son
    döndür icerik
son

# satirda hedef karakteri basla'dan arar, indeks veya -1
işlev karakterBul(satir, hedef, basla)
    n = uzunluk(satir)
    i = basla
    iken i < n
        eğer metinAl(satir, i) == hedef ise
            döndür i
        son
        i = i + 1
    son
    döndür 0 - 1
son

# ilk kelime blok açıcı mı? (son gerektiren)
işlev blokAcici(k)
    döndür metinEsit(k, "işlev") veya metinEsit(k, "eğer") veya metinEsit(k, "iken") veya metinEsit(k, "her") veya metinEsit(k, "dene")
son

# baştaki/sondaki boşlukları kırpar
işlev kirp(satir)
    n = uzunluk(satir)
    bas = boslukAtla(satir, 0)
    ucu = n
    iken ucu > bas ve bosMuk(metinAl(satir, ucu - 1))
        ucu = ucu - 1
    son
    sonuc = ""
    i = bas
    iken i < ucu
        sonuc = metinBirlestir(sonuc, metinAl(satir, i))
        i = i + 1
    son
    döndür sonuc
son

# n seviye girinti (4 boşluk/seviye)
işlev girinti(n)
    s = ""
    i = 0
    iken i < n
        s = metinBirlestir(s, "    ")
        i = i + 1
    son
    döndür s
son

# s'yi bir JSON string alanına gömülebilir hale kaçışlar (", \, \n, \r, \t).
# LSP mesajlarına kaynak metin gibi ham içerik gömerken zorunlu.
işlev jsonKac(s)
    sonuc = ""
    n = uzunluk(s)
    i = 0
    iken i < n
        c = metinAl(s, i)
        eğer c == "\"" ise
            sonuc = metinBirlestir(sonuc, "\\\"")
        değilse eğer c == "\\" ise
            sonuc = metinBirlestir(sonuc, "\\\\")
        değilse eğer c == "\n" ise
            sonuc = metinBirlestir(sonuc, "\\n")
        değilse eğer c == "\r" ise
            sonuc = metinBirlestir(sonuc, "\\r")
        değilse eğer c == karakter(9) ise
            sonuc = metinBirlestir(sonuc, "\\t")
        değilse
            sonuc = metinBirlestir(sonuc, c)
        son
        i = i + 1
    son
    döndür sonuc
son

# kimlik karakteri mi? (harf/rakam/_ veya çok-baytlı Türkçe >=128)
işlev kimlikKarMi(c)
    k = kod(c)
    eğer k >= 48 ve k <= 57 ise
        döndür doğru
    son
    eğer k >= 65 ve k <= 90 ise
        döndür doğru
    son
    eğer k >= 97 ve k <= 122 ise
        döndür doğru
    son
    eğer k >= 128 ise
        döndür doğru
    son
    döndür c == "_"
son

# satirdaki 'kelime' whole-word geçtiği tüm başlangıç kolonlarını döndür
işlev satirdaTumKonumlar(satir, kelime)
    liste = []
    n = uzunluk(satir)
    kn = uzunluk(kelime)
    i = 0
    iken i < n
        oncekiKimlik = yanlış
        eğer i > 0 ve kimlikKarMi(metinAl(satir, i - 1)) ise
            oncekiKimlik = doğru
        son
        eğer kimlikKarMi(metinAl(satir, i)) ve oncekiKimlik == yanlış ise
            eslesme = doğru
            j = 0
            iken j < kn
                eğer i + j >= n veya metinAl(satir, i + j) != metinAl(kelime, j) ise
                    eslesme = yanlış
                son
                j = j + 1
            son
            sonrakiKimlikDegil = doğru
            eğer i + kn < n ve kimlikKarMi(metinAl(satir, i + kn)) ise
                sonrakiKimlikDegil = yanlış
            son
            eğer eslesme ve sonrakiKimlikDegil ise
                liste = ekle(liste, i)
            son
            iken i < n ve kimlikKarMi(metinAl(satir, i))
                i = i + 1
            son
        değilse
            i = i + 1
        son
    son
    döndür liste
son

# 'ad' kelimesinin 'metin' içindeki whole-word (kimlik sınırı kontrollü)
# geçiş SAYISINI döndürür — satirdaTumKonumlar'ın tek-satır yerine
# çok-satırlı (satır içinde "\n" içeren) rastgele bir metin üzerinde
# sayan hali.
işlev kelimeSayisiMetinde(metin, ad)
    n = uzunluk(metin)
    kn = uzunluk(ad)
    sayi = 0
    i = 0
    iken i < n
        oncekiKimlik = yanlış
        eğer i > 0 ve kimlikKarMi(metinAl(metin, i - 1)) ise
            oncekiKimlik = doğru
        son
        eğer kimlikKarMi(metinAl(metin, i)) ve oncekiKimlik == yanlış ise
            eslesme = doğru
            j = 0
            iken j < kn
                eğer i + j >= n veya metinAl(metin, i + j) != metinAl(ad, j) ise
                    eslesme = yanlış
                son
                j = j + 1
            son
            sonrakiKimlikDegil = doğru
            eğer i + kn < n ve kimlikKarMi(metinAl(metin, i + kn)) ise
                sonrakiKimlikDegil = yanlış
            son
            eğer eslesme ve sonrakiKimlikDegil ise
                sayi = sayi + 1
            son
            iken i < n ve kimlikKarMi(metinAl(metin, i))
                i = i + 1
            son
        değilse
            i = i + 1
        son
    son
    döndür sayi
son

# satirNo'yu (0-tabanlı) kapsayan üst-seviye işlevin tanım satırını (0)
# döndürür; yoksa -1. Basit sezgi: en yakın önceki b==0 "işlev" satırı.
işlev islevKapsayan(satirlar, satirNo)
    en = satirNo
    iken en >= 0
        satir = satirlar[en]
        b = boslukAtla(satir, 0)
        eğer b == 0 ve metinEsit(kelimeAl(satir, 0), "işlev") ise
            döndür en
        son
        en = en - 1
    son
    döndür 0 - 1
son

# baslangic'taki işlev'in blok derinliği 0'a düştüğü kapanış "son" satırını
# döndürür (bulunamazsa dosya sonu).
işlev islevSonu(satirlar, baslangic)
    derinlik = 0
    si = baslangic
    iken si < uzunluk(satirlar)
        satir = satirlar[si]
        b = boslukAtla(satir, 0)
        kelime = kelimeAl(satir, b)
        eğer blokAcici(kelime) ise
            derinlik = derinlik + 1
        değilse eğer metinEsit(kelime, "son") ise
            derinlik = derinlik - 1
            eğer derinlik == 0 ise
                döndür si
            son
        son
        si = si + 1
    son
    döndür uzunluk(satirlar) - 1
son

# "a, b" → ["a","b"] (parametre imzasını virgülle böler, kırpar)
işlev parametreListesi(parametreMetni)
    liste = []
    gecerli = ""
    n = uzunluk(parametreMetni)
    i = 0
    iken i < n
        c = metinAl(parametreMetni, i)
        eğer c == "," ise
            liste = ekle(liste, kirp(gecerli))
            gecerli = ""
        değilse
            gecerli = metinBirlestir(gecerli, c)
        son
        i = i + 1
    son
    eğer uzunluk(kirp(gecerli)) > 0 ise
        liste = ekle(liste, kirp(gecerli))
    son
    döndür liste
son
