# sha256.tan — TAN'da SHA-256 (kriptografik özet). Bitwise operatörleri (& | ^
# << >>) gerektirir — TancElf'e madde 2C ile eklendi. Kaldıraç 4 (imzalı/
# içerik-adresli registry) için gerçek kriptografik bütünlük.
# sha256(metin) → 64 karakter hex özet. Doğrulandı: NIST test vektörleri.
# NOT: bayt listesi ekle() O(n²) — küçük kaynak dosyaları için uygun.

işlev sha256Rotr(x, n)
    döndür ((x >> n) | (x << (32 - n))) & 4294967295
son

işlev sha256HexRakam(d)
    eğer d < 10 ise
        döndür karakter(48 + d)
    son
    döndür karakter(97 + d - 10)
son

işlev sha256Hex8(x)
    s = ""
    i = 7
    iken i >= 0
        d = (x >> (i * 4)) & 15
        s = metinBirlestir(s, sha256HexRakam(d))
        i = i - 1
    son
    döndür s
son

işlev sha256Ozu(mesaj)
    K = [1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221, 3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580, 3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986, 2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895, 666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037, 2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344, 430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779, 1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298]

    h0 = 1779033703
    h1 = 3144134277
    h2 = 1013904242
    h3 = 2773480762
    h4 = 1359893119
    h5 = 2600822924
    h6 = 528734635
    h7 = 1541459225

    # mesajı bayt listesine çevir
    baytlar = []
    n = uzunluk(mesaj)
    i = 0
    iken i < n
        baytlar = ekle(baytlar, kod(metinAl(mesaj, i)))
        i = i + 1
    son

    # padding: 0x80, sonra 56 mod 64'e kadar 0, sonra 64-bit uzunluk (big-endian)
    L = n * 8
    baytlar = ekle(baytlar, 128)
    iken (uzunluk(baytlar) % 64) != 56
        baytlar = ekle(baytlar, 0)
    son
    k = 0
    iken k < 8
        baytlar = ekle(baytlar, (L >> (8 * (7 - k))) & 255)
        k = k + 1
    son

    toplamBlok = tamBol(uzunluk(baytlar), 64)
    bi = 0
    iken bi < toplamBlok
        # mesaj programı w[0..63]
        w = []
        t = 0
        iken t < 16
            taban = bi * 64 + t * 4
            kelime = (baytlar[taban] << 24) | (baytlar[taban + 1] << 16) | (baytlar[taban + 2] << 8) | baytlar[taban + 3]
            w = ekle(w, kelime & 4294967295)
            t = t + 1
        son
        t = 16
        iken t < 64
            s0 = sha256Rotr(w[t - 15], 7) ^ sha256Rotr(w[t - 15], 18) ^ (w[t - 15] >> 3)
            s1 = sha256Rotr(w[t - 2], 17) ^ sha256Rotr(w[t - 2], 19) ^ (w[t - 2] >> 10)
            yeni = (w[t - 16] + s0 + w[t - 7] + s1) & 4294967295
            w = ekle(w, yeni)
            t = t + 1
        son

        a = h0
        b = h1
        c = h2
        d = h3
        e = h4
        f = h5
        g = h6
        hh = h7

        t = 0
        iken t < 64
            S1 = sha256Rotr(e, 6) ^ sha256Rotr(e, 11) ^ sha256Rotr(e, 25)
            ch = (e & f) ^ ((e ^ 4294967295) & g)
            temp1 = (hh + S1 + ch + K[t] + w[t]) & 4294967295
            S0 = sha256Rotr(a, 2) ^ sha256Rotr(a, 13) ^ sha256Rotr(a, 22)
            maj = (a & b) ^ (a & c) ^ (b & c)
            temp2 = (S0 + maj) & 4294967295
            hh = g
            g = f
            f = e
            e = (d + temp1) & 4294967295
            d = c
            c = b
            b = a
            a = (temp1 + temp2) & 4294967295
            t = t + 1
        son

        h0 = (h0 + a) & 4294967295
        h1 = (h1 + b) & 4294967295
        h2 = (h2 + c) & 4294967295
        h3 = (h3 + d) & 4294967295
        h4 = (h4 + e) & 4294967295
        h5 = (h5 + f) & 4294967295
        h6 = (h6 + g) & 4294967295
        h7 = (h7 + hh) & 4294967295
        bi = bi + 1
    son

    döndür [h0, h1, h2, h3, h4, h5, h6, h7]
son

# hex özet (64 karakter)
işlev sha256(mesaj)
    hh = sha256Ozu(mesaj)
    r = metinBirlestir(sha256Hex8(hh[0]), sha256Hex8(hh[1]))
    r = metinBirlestir(r, sha256Hex8(hh[2]))
    r = metinBirlestir(r, sha256Hex8(hh[3]))
    r = metinBirlestir(r, sha256Hex8(hh[4]))
    r = metinBirlestir(r, sha256Hex8(hh[5]))
    r = metinBirlestir(r, sha256Hex8(hh[6]))
    r = metinBirlestir(r, sha256Hex8(hh[7]))
    döndür r
son

# 32 ham bayt (HMAC/binary için)
işlev sha256Ham(mesaj)
    hh = sha256Ozu(mesaj)
    r = ""
    i = 0
    iken i < 8
        w = hh[i]
        r = metinBirlestir(r, karakter((w >> 24) & 255))
        r = metinBirlestir(r, karakter((w >> 16) & 255))
        r = metinBirlestir(r, karakter((w >> 8) & 255))
        r = metinBirlestir(r, karakter(w & 255))
        i = i + 1
    son
    döndür r
son

# HMAC-SHA256(anahtar, mesaj) → 64 karakter hex imza (Kaldıraç 4: imzalama)
işlev hmacSha256(anahtar, mesaj)
    blok = 64
    eğer uzunluk(anahtar) > blok ise
        anahtar = sha256Ham(anahtar)
    son
    iken uzunluk(anahtar) < blok
        anahtar = metinBirlestir(anahtar, karakter(0))
    son
    ipad = ""
    opad = ""
    i = 0
    iken i < blok
        kb = kod(metinAl(anahtar, i))
        ipad = metinBirlestir(ipad, karakter(kb ^ 54))
        opad = metinBirlestir(opad, karakter(kb ^ 92))
        i = i + 1
    son
    ic = sha256Ham(metinBirlestir(ipad, mesaj))
    döndür sha256(metinBirlestir(opad, ic))
son
