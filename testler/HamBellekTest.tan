# Ham bellek erisimi: hamAyir/hamOku/hamYaz + pointer aritmetigi

p = hamAyir(4)
yaz(p)              # 0 (ilk ayirma, bos yigindan basliyor)

hamYaz(p, 65)
hamYaz(p + 1, 66)
hamYaz(p + 2, u8(67))   # sabit genislikli tamsayi degeri de kabul edilmeli

yaz(hamOku(p))       # 65
yaz(hamOku(p + 1))   # 66
yaz(hamOku(p + 2))   # 67
yaz(hamOku(p + 3))   # 0 (hamAyir sifirla baslatir)

p2 = hamAyir(4)
yaz(p2)              # 4 (ilk ayirmadan sonraki bump)

# uzerine yazma (overwrite)
hamYaz(p, 200)
yaz(hamOku(p))       # 200

dene
    hamOku(1000)     # sinir disi -> hata beklenir
    yaz("HATA: buraya ulasilmamali")
yakala h
    yaz("yakalandi: sinir disi")
son

dene
    hamYaz(-1, 1)    # negatif adres -> hata beklenir
    yaz("HATA: buraya ulasilmamali")
yakala h
    yaz("yakalandi: negatif adres")
son
