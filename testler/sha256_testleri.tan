# sha256_testleri.tan — kutuphane/sha256.tan NIST test vektörleri.
içe al "kutuphane/test.tan"
içe al "kutuphane/sha256.tan"

gecti = 0
toplam = 0

yaz("== sha256 (NIST vektörleri) ==")
toplam = toplam + 1
gecti = gecti + iddiaMetin("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", sha256(""), "sha256 bos metin")
toplam = toplam + 1
gecti = gecti + iddiaMetin("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", sha256("abc"), "sha256 abc")
toplam = toplam + 1
gecti = gecti + iddiaMetin("248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1", sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"), "sha256 448-bit blok sınırı")

d = testSonuc(gecti, toplam)
